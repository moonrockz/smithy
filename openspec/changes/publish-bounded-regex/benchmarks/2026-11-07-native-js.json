  "scope": "Matching time excludes compilation and input construction. RSS is whole-process peak over both calls, including runtime and prebuilt input. Every row uses a fresh process.",
  "source": "fn main {\n  let args = @env.args()\n  let kind = args[args.length() - 2]\n  let n = try! @string.parse_int(args[args.length() - 1])\n  let pattern = match kind {\n    \"nested\" => \"^(?:a+)+$\"\n    \"overlap\" => \"^(?:a|aa)+$\"\n    \"optional\" => \"^(?:a?){150}a{150}$\"\n    \"dfa\" => \"a(?:a|b){20}c\"\n    \"long\" => \"^a+$\"\n    _ => \"^([a-z0-9]+|[A-Z0-9]+)(-([a-z0-9]+|[A-Z0-9]+))*(/([a-z0-9]+|[A-Z0-9]+)(-([a-z0-9]+|[A-Z0-9]+))*)*:([a-z0-9]+|[A-Z0-9]+)(-([a-z0-9]+|[A-Z0-9]+))*(/([a-z0-9]+|[A-Z0-9]+)(-([a-z0-9]+|[A-Z0-9]+))*)*#([a-z0-9]+|[A-Z0-9]+)(-([a-z0-9]+|[A-Z0-9]+))*$\"\n  }\n  let input = if kind == \"dfa\" {\n    let b = StringBuilder()\n    let mut x = 12345U\n    for _ in 0..<n {\n      x = x ^ (x << 13)\n      x = x ^ (x >> 17)\n      x = x ^ (x << 5)\n      b.write_char(if (x & 1U) == 0U { 'a' } else { 'b' })\n    }\n    b.to_string()\n  } else if kind == \"fqname\" {\n    \"morphir/SDK:basics#int\"\n  } else if kind == \"fqname97\" {\n    \"my-org/finance-and-risk/regulatory-reporting:liquidity/coverage-ratio#calculate-net-cash-outflows\"\n  } else if kind == \"nested\" || kind == \"overlap\" {\n    \"a\".repeat(n) + \"!\"\n  } else { \"a\".repeat(n) }\n  let regex = try! @regex.Regex::compile(pattern)\n  let work = try! @regex.WorkLimit::new(100000)\n  let t0 = @env.now()\n  let result = regex.matches(input, work~)\n  let t1 = @env.now()\n  let again = regex.matches(input, work~)\n  let t2 = @env.now()\n  let rendered = match result {\n    Complete(b, u) => \"Complete(\\{b},\\{u})\"\n    Exhausted(u) => \"Exhausted(\\{u})\"\n  }\n  println(\"kind=\\{kind} n=\\{n} first_ms=\\{t1-t0} repeated_ms=\\{t2-t1} result=\\{rendered} same=\\{result == again}\")\n}\n",
  "source_sha256": "b76795909af775da613477a921c995c1884c46301d3f30cd6b283600f83726c5",
  "fixture": {
