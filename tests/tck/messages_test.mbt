///|
/// The reference corpus covers syntax errors; these inputs exercise editor
/// warnings, bounded parsing and unfinished constructs outside that corpus.
let message_inputs : Array[String] = [
  "metadata x = {a:\"x\"b:\"y\"}",
  "namespace a\n@t(a:\"x\"b:\"y\")\nstring S",
  "namespace a\n/// orphan",
  "namespace a\n/// docs\napply S @required",
  "namespace a\n@t\n",
  "namespace a\noperation O {",
  "$version: \"2\"\nnamespace a\nenum E {",
  "$version: \"2\"\nnamespace a\nstring S with [",
  "namespace a\noperation O {errors: [",
  "namespace a\napply S {",
  "metadata x = {",
  "namespace a\n@t(key: 1",
  "metadata x = " + "[".repeat(101),
  "metadata x = 1e4097",
  "metadata x = 0.12345678901234567890123456789",
  "$version: \"2\"\nnamespace a\nset S {member: String}",
  "namespace a\nstructure S {a: String@required b: String}",
  "namespace a\noperation O {inputs: S}",
]

///|
test "every diagnostic title and message has a snapshot" {
  let messages : Set[String] = Set([])
  let titles : Set[String] = Set([])
  fn record(text : String) {
    for d in @syntax.parse_idl(text).diagnostics {
      titles.add(d.title)
      messages.add("\{d.code} | \{d.title} | \{d.message}")
    }
  }
  for c in @tck.cases() {
    record(c.text)
  }
  for text in message_inputs {
    record(text)
  }
  let ordered_titles = titles.to_array()
  ordered_titles.sort()
  let ordered_messages = messages.to_array()
  ordered_messages.sort()
  debug_inspect(
    ordered_titles,
    content=(
      #|[
      #|  "EMPTY MIXINS",
      #|  "INVALID NUMBER",
      #|  "UNKNOWN ESCAPE",
      #|  "UNFINISHED ENUM",
      #|  "DUPLICATE MEMBER",
      #|  "EXPECTED A SHAPE",
      #|  "INVALID SHAPE ID",
      #|  "NUMBER TOO LARGE",
      #|  "TOO MUCH NESTING",
      #|  "UNEXPECTED TOKEN",
      #|  "UNFINISHED APPLY",
      #|  "UNFINISHED ARRAY",
      #|  "UNFINISHED SHAPE",
      #|  "DOCS BEFORE APPLY",
      #|  "INVALID NAMESPACE",
      #|  "MISSING NAMESPACE",
      #|  "MISSING SEPARATOR",
      #|  "UNFINISHED MIXINS",
      #|  "INVALID SHAPE NAME",
      #|  "INVALID USE TARGET",
      #|  "MISSING LINE BREAK",
      #|  "MISSING SHAPE NAME",
      #|  "MISSING WHITESPACE",
      #|  "NEEDS SMITHY IDL 1",
      #|  "NEEDS SMITHY IDL 2",
      #|  "NUMBER TOO PRECISE",
      #|  "UNTERMINATED STRING",
      #|  "DETACHED DOC COMMENT",
      #|  "EXPECTED A STATEMENT",
      #|  "UNEXPECTED CHARACTER",
      #|  "UNFINISHED AN OBJECT",
      #|  "UNFINISHED OPERATION",
      #|  "UNEXPECTED LINE BREAK",
      #|  "UNFINISHED ERROR LIST",
      #|  "INVALID UNICODE ESCAPE",
      #|  "UNEXPECTED END OF FILE",
      #|  "UNFINISHED A TRAIT BODY",
      #|  "UNTERMINATED TEXT BLOCK",
      #|  "UNKNOWN OPERATION PROPERTY",
      #|  "UNSUPPORTED SMITHY VERSION",
      #|  "DUPLICATE CONTROL STATEMENT",
      #|  "DUPLICATE OPERATION PROPERTY",
      #|  "TEXT BLOCK MUST START WITH A LINE BREAK",
      #|]
    ),
  )
  debug_inspect(
    ordered_messages,
    content=(
      #|[
      #|  "SM-SCAN-002 | UNTERMINATED STRING | this string never ends",
      #|  "SM-SCAN-005 | UNKNOWN ESCAPE | I don't know the escape `\\ `",
      #|  "SM-SCAN-005 | UNKNOWN ESCAPE | I don't know the escape `\\'`",
      #|  "SM-SCAN-007 | INVALID NUMBER | I cannot read `-` as a number",
      #|  "SM-SCAN-007 | INVALID NUMBER | I cannot read `1.` as a number",
      #|  "SM-SCAN-007 | INVALID NUMBER | I cannot read `1.0e` as a number",
      #|  "SM-SCAN-007 | INVALID NUMBER | I cannot read `1.0e+` as a number",
      #|  "SM-SCAN-003 | UNTERMINATED TEXT BLOCK | this text block never ends",
      #|  "SM-SCAN-001 | UNEXPECTED CHARACTER | I don't know what to do with `!`",
      #|  "SM-SCAN-001 | UNEXPECTED CHARACTER | I don't know what to do with `%`",
      #|  "SM-SCAN-001 | UNEXPECTED CHARACTER | I don't know what to do with `'`",
      #|  "SM-SCAN-001 | UNEXPECTED CHARACTER | I don't know what to do with `_`",
      #|  "SM-PARSE-014 | DUPLICATE MEMBER | Found conflicting member name, `BAR`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a value but found `)`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a value but found `.`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a value but found `=`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a value but found `]`",
      #|  "SM-PARSE-005 | INVALID SHAPE ID | I was expecting a shape name after `#`",
      #|  "SM-PARSE-005 | INVALID SHAPE ID | I was expecting a member name after `$`",
      #|  "SM-PARSE-001 | EMPTY MIXINS | `with [ ]` needs at least one mixin shape ID",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a shape ID but found `#`",
      #|  "SM-PARSE-010 | TOO MUCH NESTING | this is nested more than 100 levels deep",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a member name but found `}`",
      #|  "SM-PARSE-003 | MISSING SEPARATOR | I was expecting whitespace here but found `:`",
      #|  "SM-PARSE-003 | MISSING SEPARATOR | I was expecting whitespace here but found `@`",
      #|  "SM-PARSE-005 | INVALID NAMESPACE | I was expecting a namespace segment after `.`",
      #|  "SM-PARSE-006 | UNSUPPORTED SMITHY VERSION | the `$version` value must be a string",
      #|  "SM-PARSE-011 | UNKNOWN OPERATION PROPERTY | an operation has no `inputs` property",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after `errors` but found `=`",
      #|  "SM-PARSE-006 | UNSUPPORTED SMITHY VERSION | Unsupported Smithy version number: 999",
      #|  "SM-PARSE-013 | DUPLICATE CONTROL STATEMENT | Duplicate control statement `version`",
      #|  "SM-SCAN-006 | INVALID UNICODE ESCAPE | a `\\u` escape needs exactly four hex digits",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after `errors` but found `:=`",
      #|  "SM-PARSE-003 | MISSING LINE BREAK | I was expecting a line break here but found `$`",
      #|  "SM-PARSE-015 | NEEDS SMITHY IDL 1 | set shapes cannot be used in Smithy version 2.0",
      #|  "SM-PARSE-007 | NEEDS SMITHY IDL 2 | enum shapes cannot be used in Smithy version 1.0",
      #|  "SM-PARSE-003 | MISSING LINE BREAK | I was expecting a line break here but found `BAZ`",
      #|  "SM-PARSE-003 | MISSING LINE BREAK | I was expecting a line break here but found `baz`",
      #|  "SM-PARSE-003 | MISSING LINE BREAK | I was expecting a line break here but found `use`",
      #|  "SM-PARSE-004 | MISSING NAMESPACE | I found `@` but no `namespace` statement before it",
      #|  "SM-PARSE-002 | UNFINISHED ARRAY | I reached the end of the file while reading an array",
      #|  "SM-PARSE-002 | UNFINISHED MIXINS | I reached the end of the file inside the mixin list",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the key `bad` but found `}`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the key `foo` but found `.`",
      #|  "SM-PARSE-003 | MISSING LINE BREAK | I was expecting a line break here but found `apply`",
      #|  "SM-PARSE-004 | MISSING NAMESPACE | I found `use` but no `namespace` statement before it",
      #|  "SM-PARSE-003 | MISSING LINE BREAK | I was expecting a line break here but found `string`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the control key but found `.`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `=` after the metadata key but found `.`",
      #|  "SM-PARSE-002 | UNFINISHED ERROR LIST | I reached the end of the file inside the error list",
      #|  "SM-PARSE-003 | MISSING LINE BREAK | I was expecting a line break here but found `metadata`",
      #|  "SM-PARSE-004 | MISSING NAMESPACE | I found `string` but no `namespace` statement before it",
      #|  "SM-PARSE-007 | NEEDS SMITHY IDL 2 | Mixins can only be used with Smithy version 2 or later",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `)` to close the trait body but found `:`",
      #|  "SM-PARSE-002 | UNFINISHED AN OBJECT | I reached the end of the file while reading an object",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the key `bam` but found `string`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the key `inlined` but found `:=`",
      #|  "SM-PARSE-004 | EXPECTED A SHAPE | I was expecting a shape after the traits but found `apply`",
      #|  "SM-PARSE-007 | NEEDS SMITHY IDL 2 | Members can only elide targets in IDL version 2 or later",
      #|  "SM-PARSE-001 | MISSING SHAPE NAME | I was expecting a shape name after `string` but found `(`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the control key but found a string",
      #|  "SM-PARSE-011 | UNKNOWN OPERATION PROPERTY | an operation has no `invalidOperationKey` property",
      #|  "SM-PARSE-002 | UNEXPECTED END OF FILE | I was expecting a value but reached the end of the file",
      #|  "SM-PARSE-004 | EXPECTED A SHAPE | I was expecting a shape after the traits but found `metadata`",
      #|  "SM-PARSE-001 | MISSING SHAPE NAME | I was expecting a shape name after `structure` but found `{`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `)` to close the trait body but found `string`",
      #|  "SM-PARSE-002 | UNEXPECTED TOKEN | I was expecting `[` after `with` but found the end of the file",
      #|  "SM-PARSE-004 | EXPECTED A SHAPE | I was expecting a shape after the traits but found `namespace`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the key `string` but found `MyString`",
      #|  "SM-PARSE-002 | UNFINISHED A TRAIT BODY | I reached the end of the file while reading a trait body",
      #|  "SM-PARSE-001 | NUMBER TOO LARGE | I cannot represent `1e4097` exactly: its exponent is beyond 4096",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `)` to close the trait body but found `MyString`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `use`",
      #|  "SM-PARSE-002 | UNFINISHED OPERATION | I reached the end of the file while reading the operation `O`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `with`",
      #|  "SM-PARSE-005 | INVALID SHAPE NAME | a shape name is a plain identifier, but `Not...Valid` has a dot",
      #|  "SM-PARSE-007 | NEEDS SMITHY IDL 2 | @default assignment is only supported in IDL version 2 or later",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `:` after the member name `inlined` but found `:=`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `usecom`",
      #|  "SM-PARSE-009 | DETACHED DOC COMMENT | this documentation comment is not followed by a shape or member",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `invalid`",
      #|  "SM-PARSE-002 | UNFINISHED APPLY | I reached the end of the file while reading the traits applied to `S`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `metadata`",
      #|  "SM-PARSE-007 | NEEDS SMITHY IDL 2 | Resource properties can only be used with Smithy version 2 or later",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a key (an identifier or a quoted string) but found `{`",
      #|  "SM-PARSE-002 | UNFINISHED ENUM | I reached the end of the file while reading the members of the enum `E`",
      #|  "SM-PARSE-003 | MISSING SEPARATOR | I was expecting whitespace between entries in an object but found `b`",
      #|  "SM-PARSE-004 | EXPECTED A SHAPE | I was expecting a shape after the traits but found the end of the file",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting `use`, a shape statement, or `apply` but found `$`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `namespace`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `stringFoo`",
      #|  "SM-PARSE-005 | INVALID SHAPE NAME | a shape name is a plain identifier, but `com.foo#Bam` has a namespace",
      #|  "SM-PARSE-005 | INVALID USE TARGET | a `use` statement needs an absolute shape ID like `smithy.api#String`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a trait or `{` after the apply target but found `string`",
      #|  "SM-SCAN-004 | TEXT BLOCK MUST START WITH A LINE BREAK | the opening `\"\"\"` must be followed by a line break",
      #|  "SM-PARSE-003 | MISSING SEPARATOR | I was expecting whitespace between entries in a trait body but found `b`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a shape statement or `apply` but found `structureFoo`",
      #|  "SM-PARSE-012 | DUPLICATE OPERATION PROPERTY | Duplicate operation input property for the operation `GetFoo`",
      #|  "SM-PARSE-002 | UNEXPECTED TOKEN | I was expecting `:` after the key `MyString` but found the end of the file",
      #|  "SM-PARSE-002 | UNFINISHED SHAPE | I reached the end of the file while reading the members of the map `MyMap`",
      #|  "SM-PARSE-007 | NEEDS SMITHY IDL 2 | Structures can only be bound to resources with Smithy version 2 or later",
      #|  "SM-PARSE-001 | MISSING SHAPE NAME | I was expecting a shape name after `string` but found the end of the file",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting a key (an identifier or a quoted string) but found a string",
      #|  "SM-PARSE-002 | UNFINISHED APPLY | I reached the end of the file while reading the traits applied to `SomeShape`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting `use`, a shape statement, or `apply` but found `metadata`",
      #|  "SM-PARSE-002 | UNFINISHED SHAPE | I reached the end of the file while reading the members of the structure `Foo`",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting `use`, a shape statement, or `apply` but found `namespace`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the map `MixedMap` but found `with`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the structure `Foo` but found `Baz`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the structure `Foo` but found `wit`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the list `MixedList` but found `with`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the inline shape but found `CustomName`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the structure `Invalid` but found `for`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the union `MixedUnion` but found `with`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the body of the service `MixedService` but found `with`",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the body of the resource `MixedResource` but found `with`",
      #|  "SM-PARSE-007 | NEEDS SMITHY IDL 2 | Inlined operation inputs and outputs can only be used with Smithy version 2 or later",
      #|  "SM-PARSE-005 | INVALID SHAPE ID | `smithy.api` looks like a namespace, but a shape ID needs `#` and a shape name after it",
      #|  "SM-PARSE-001 | MISSING SHAPE NAME | I was expecting a shape name after `structure` on the same line but found a line break",
      #|  "SM-PARSE-001 | UNEXPECTED TOKEN | I was expecting `{` to start the members of the structure `MixedStructure` but found `with`",
      #|  "SM-PARSE-001 | MISSING WHITESPACE | I was expecting whitespace before the metadata key but found a string right after `metadata`",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting `:` right after `foo`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-001 | NUMBER TOO PRECISE | I cannot represent `0.12345678901234567890123456789` exactly: it needs more than 28 decimal places",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting `:` right after `version`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a control statement (`$version: \"2\"`), `metadata`, or `namespace` but found `Nope`",
      #|  "SM-PARSE-008 | DOCS BEFORE APPLY | a documentation comment cannot be applied with an apply statement, so I read it as an ordinary comment",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting the enum value right after `=`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-001 | MISSING WHITESPACE | I was expecting whitespace before the trait or `{` after the apply target but found `{` right after `Foo`",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting the control value right after `:`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting the default value right after `=`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-004 | EXPECTED A STATEMENT | I was expecting a control statement (`$version: \"2\"`), `metadata`, or `namespace` but found `metadatafoo`",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting the metadata value right after `=`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting the namespace right after `namespace`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting the shape ID to use right after `use`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-001 | UNEXPECTED LINE BREAK | I was expecting the metadata key right after `metadata`, on the same line, but found a line break or a comment",
      #|  "SM-PARSE-001 | UNFINISHED SHAPE | I was reading the members of the structure `MyFooIsBroken` and found `integer` at the start of a line; did you forget `}`?",
      #|]
    ),
  )
}
