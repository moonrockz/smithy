            "PutPayloadOutputPayload": {
                "type": "string",
                "contentEncoding": "byte"
            },
            "QueryMap": {
                "type": "object",
                "additionalProperties": {
                    "type": "string"
                },
                "propertyNames": {
                    "type": "string"
                }
            },
            "QueryStringListMap": {
                "type": "object",
