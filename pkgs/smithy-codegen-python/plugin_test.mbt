///|
let echo_model : String =
  #|$version: "2"
  #|namespace example
  #|use smithy.rpc#jsonRpc
  #|use smithy.rpc#method
  #|use smithy.rpc#rpcError
  #|@jsonRpc(versions: ["2.0"])
  #|service Echo { version: "1", operations: [Say, Tell, Pair, Pick], rename: { "other#Item": "OtherItem" } }
  #|@method(name: "say", params: "named", resultMember: "text")
  #|operation Say { input: SayInput, output: SayOutput, errors: [Refused, Busy, Gone] }
  #|@method(name: "tell", params: "named", kind: "notification")
  #|operation Tell { input: SayInput }
  #|@method(name: "pair", params: "positional", positional: ["left", "right"], nullResult: true)
  #|operation Pair { input: PairInput }
  #|@method(name: "pick", params: "named")
  #|operation Pick { input: PickInput, output: PickInput }
  #|structure SayInput { @required text: String, type: Kind, items: Items, other: other#Item, @jsonName("x") camelCase: Integer }
  #|structure SayOutput { @required text: String }
  #|structure PairInput { @required left: Integer, right: Long }
  #|structure PickInput { choice: Choice, flag: Boolean, ratio: Double, data: Blob, doc: Document, labels: Labels }
  #|map Labels { key: String, value: String }
  #|union Choice { one: Item, none: Unit }
  #|list Items { member: Item }
  #|structure Item { @required amount: BigDecimal, at: Timestamp, @timestampFormat("date-time") seen: Timestamp }
  #|enum Kind {
  #|  LOUD_VOICE = "loud"
  #|  quiet
  #|}
  #|@error("client")
  #|@rpcError(code: 1001, dataMember: "reason")
  #|structure Refused { @required reason: String }
  #|@error("server")
  #|@rpcError(code: 1002)
  #|structure Busy { @required retryAfterSeconds: Integer }
  #|@error("client")
  #|@rpcError(code: 1003, absentData: true)
  #|structure Gone {}

///|
let other_model : String =
  #|$version: "2"
  #|namespace other
  #|structure Item { name: String }

///|
fn generate(settings : Json) -> Map[String, String] raise {
  let loaded = @rpc.loader()
    .add_idl("echo.smithy", echo_model)
    .add_idl("other.smithy", other_model)
    .assemble()
  guard loaded.model is Some(model) else {
    fail(loaded.diagnostics.map(d => d.message).join("\n"))
  }
  @python.run(@codegen.PluginContext::from_build(model, settings))
}

///|
fn sorted_names(files : Map[String, String]) -> Array[String] {
  let names = files.keys().collect()
  names.sort_by((a, b) => a.lexical_compare(b))
  names
}

///|
test "a server peer gets models, errors, a handler and session rules" {
  let files = generate({
    "service": "example#Echo",
    "peer": "server",
    "package": "echo_server",
  })
  let names = sorted_names(files)
  for
    name in [
      "pyproject.toml", "echo_server/__init__.py", "echo_server/py.typed", "echo_server/models.py",
      "echo_server/errors.py", "echo_server/handler.py", "echo_server/session.py",
      "echo_server/_runtime/__init__.py", "echo_server/_runtime/peer.py", "tests/test_generated.py",
    ] {
    assert_true(names.contains(name), msg="I expected file \{name}")
  }
  assert_false(names.contains("echo_server/client.py"))
  let models = files["echo_server/models.py"]
  assert_true(
    models.has_prefix(
      "# Code generated by python-jsonrpc-codegen. DO NOT EDIT.\n\"\"\"",
    ),
  )
  assert_true(models.contains("\nfrom __future__ import annotations\n"))
  // Field names are snake case, a keyword gets a suffix, renames apply.
  assert_true(models.contains("    type: Kind | None = None\n"))
  assert_true(models.contains("    other: OtherItem | None = None\n"))
  assert_true(models.contains("    items: list[Item] | None = None\n"))
  assert_true(models.contains("class OtherItem(BaseModel):"))
  // Exact values, timestamps and wire names.
  assert_true(models.contains("    amount: BigDecimal\n"))
  assert_true(models.contains("    at: EpochSecondsTimestamp | None = None\n"))
  assert_true(models.contains("    seen: DateTimeTimestamp | None = None\n"))
  assert_true(models.contains("    left: Integer\n"))
  assert_true(models.contains("    right: Long | None = None\n"))
  assert_true(models.contains("    flag: StrictBool | None = None\n"))
  assert_true(models.contains("    ratio: Double | None = None\n"))
  assert_true(models.contains("    data: Blob | None = None\n"))
  assert_true(models.contains("    doc: Document | None = None\n"))
  assert_true(models.contains("    labels: dict[str, str] | None = None\n"))
  // Enums are str enums with UPPER_SNAKE members.
  assert_true(models.contains("class Kind(StrEnum):"))
  assert_true(models.contains("    LOUD_VOICE = \"loud\"\n"))
  assert_true(models.contains("    QUIET = \"quiet\"\n"))
  // A union is one model for each member and a tagged alias.
  assert_true(models.contains("class ChoiceOne(BaseModel):"))
  assert_true(models.contains("    union_member: ClassVar[str] = \"one\"\n"))
  assert_true(models.contains("    none: Unit\n"))
  assert_true(models.contains("Choice: TypeAlias = Annotated[\n"))
  assert_true(models.contains("    | Annotated[ChoiceNone, Tag(\"none\")],\n"))
  assert_true(models.contains("    Discriminator(union_tag),\n"))
  // Imports in isort order.
  assert_true(
    models.contains(
      "from enum import StrEnum\nfrom typing import Annotated, ClassVar, TypeAlias\n\nfrom pydantic import BaseModel, ConfigDict, Discriminator, Field, StrictBool, Tag\n\nfrom ._runtime import (\n",
    ),
  )
  let errors = files["echo_server/errors.py"]
  assert_true(errors.contains("class RefusedData(BaseModel):"))
  assert_true(errors.contains("class Refused(ModeledError):"))
  assert_true(errors.contains("    code = 1001\n"))
  assert_true(
    errors.contains(
      "        return RpcError(self.code, str(self), to_wire(self.data.reason))\n",
    ),
  )
  assert_true(
    errors.contains(
      "        return Refused(RefusedData.model_validate({\"reason\": data}))\n",
    ),
  )
  assert_true(
    errors.contains("        return Busy(BusyData.model_validate(data))\n"),
  )
  assert_true(
    errors.contains(
      "    def __init__(self, data: GoneData | None = None) -> None:\n",
    ),
  )
  let handler = files["echo_server/handler.py"]
  assert_true(handler.contains("class EchoHandler(Protocol):"))
  assert_true(
    handler.contains(
      "    async def say(self, input: SayInput, context: CallContext) -> str:\n",
    ),
  )
  assert_true(
    handler.contains(
      "    async def pair(self, input: PairInput, context: CallContext) -> None:\n",
    ),
  )
  assert_true(
    handler.contains(
      "def register_echo(peer: Peer, handler: EchoHandler) -> None:\n",
    ),
  )
  assert_true(
    handler.contains(
      "        input = PairInput.model_validate(positional_params(params, [\"left\", \"right\"], either=False))\n",
    ),
  )
  assert_true(
    handler.contains("            raise error.to_rpc_error() from error\n"),
  )
  assert_true(
    handler.contains(
      "    peer.on_notification(\"tell\", MethodKind.NOTIFICATION_ONLY, _tell)\n",
    ),
  )
  let session = files["echo_server/session.py"]
  assert_true(session.contains("    return SessionRules.none()\n"))
  assert_true(
    session.contains(
      "    return Peer(self_name=\"server\", remote_name=\"client\", rules=session_rules(), log=log)\n",
    ),
  )
  let pyproject = files["pyproject.toml"]
  assert_true(pyproject.contains("name = \"echo-server\"\n"))
  assert_true(pyproject.contains("    \"pydantic==2.14.1\",\n"))
  assert_false(pyproject.contains("fastapi"))
  let test_file = files["tests/test_generated.py"]
  assert_true(
    test_file.contains(
      "from echo_server._runtime import to_wire\nfrom echo_server.models import OtherItem\nfrom echo_server.session import new_peer, session_rules\n",
    ),
  )
}

///|
test "a client peer gets a typed client with modeled errors" {
  let files = generate({
    "service": "example#Echo",
    "peer": "client",
    "package": "echo_client",
    "transports": ["stdio"],
  })
  let names = sorted_names(files)
  assert_true(names.contains("echo_client/client.py"))
  assert_false(names.contains("echo_client/handler.py"))
  let client = files["echo_client/client.py"]
  assert_true(client.contains("class EchoClient:"))
  assert_true(
    client.contains("_SAY_RESULT: TypeAdapter[str] = TypeAdapter(str)\n"),
  )
  assert_true(
    client.contains(
      "    async def say(self, input: SayInput, *, checked: bool = True) -> str:\n",
    ),
  )
  assert_true(
    client.contains(
      "            raise modeled_error(error, {1001: Refused.from_data, 1002: Busy.from_data, 1003: Gone.from_data}) from None\n",
    ),
  )
  assert_true(
    client.contains("        return _SAY_RESULT.validate_python(result)\n"),
  )
  assert_true(
    client.contains(
      "        await self.peer.notify(\"tell\", to_wire(input), checked=checked)\n",
    ),
  )
  assert_true(
    client.contains(
      "        await self.peer.request(\"pair\", to_positional(to_wire_object(input), [\"left\", \"right\"]), checked=checked)\n",
    ),
  )
  assert_true(
    client.contains("        return PickInput.model_validate(result)\n"),
  )
  let pyproject = files["pyproject.toml"]
  assert_false(pyproject.contains("fastapi"))
  assert_false(pyproject.contains("httpx"))
  // Only the stdio transport: no transport module that needs another package.
  assert_true(names.contains("echo_client/_runtime/stdio.py"))
  assert_false(names.contains("echo_client/_runtime/http_client.py"))
  assert_false(names.contains("echo_client/_runtime/ws_client.py"))
  assert_false(names.contains("echo_client/_runtime/server.py"))
}

///|
test "the fastapi integration wires the handler into the runtime server" {
  let files = generate({
    "service": "example#Echo",
    "peer": "server",
    "package": "echo_server",
    "integrations": ["fastapi"],
  })
  let names = sorted_names(files)
  assert_true(names.contains("echo_server/_runtime/server.py"))
  assert_true(names.contains("echo_server/_runtime/http_client.py"))
  let app = files["echo_server/fastapi_app.py"]
  assert_true(
    app.contains(
      "from ._runtime import Peer, TranscriptLog, server\nfrom .handler import EchoHandler, register_echo\nfrom .session import new_peer\n",
    ),
  )
  assert_true(
    app.contains(
      "def create_app(handler_factory: Callable[[], EchoHandler], *, log: TranscriptLog | None = None) -> FastAPI:\n",
    ),
  )
  assert_true(
    app.contains(
      "    await server.serve(port, peer_factory(handler_factory, log))\n",
    ),
  )
  let pyproject = files["pyproject.toml"]
  assert_true(pyproject.contains("    \"fastapi==0.162.0\",\n"))
  assert_true(pyproject.contains("    \"uvicorn==0.54.0\",\n"))
  let message = try {
    let _ = generate({
      "service": "example#Echo",
      "peer": "client",
      "package": "echo_client",
      "integrations": ["fastapi"],
    })
    "no error"
  } catch {
    @codegen.InvalidSettings(text) => text
    error => error.to_string()
  }
  assert_eq(
    message, "I cannot add integration `fastapi` to peer `client`: it accepts no service.",
  )
}

///|
test "the plugin output does not change between runs" {
  let settings : Json = {
    "service": "example#Echo",
    "peer": "server",
    "package": "echo_server",
  }
  let first = generate(settings)
  let second = generate(settings)
  assert_eq(sorted_names(first), sorted_names(second))
  for name, text in first {
    assert_eq(second[name], text)
  }
}

///|
test "bad settings give first-person errors" {
  let bad : Array[(Json, String)] = [
    (
      { "service": "example#Echo", "peer": "server" },
      "I expected setting `package`",
    ),
    (
      { "service": "example#Echo", "peer": "server", "package": "class" },
      "I expected setting `package` to be a Python package name such as `payment_terminal`, found `class`.",
    ),
    (
      { "service": "example#Echo", "peer": "server", "package": "a-b" },
      "found `a-b`.",
    ),
    (
      {
        "service": "example#Echo",
        "peer": "server",
        "package": "echo",
        "integrations": ["flask"],
      },
      "I expected each integration in setting `integrations` to be `fastapi`, found `flask`.",
    ),
    (
      {
        "service": "example#Echo",
        "peer": "server",
        "package": "echo",
        "integrations": "fastapi",
      },
      "I expected an array of integrations in setting `integrations`.",
    ),
  ]
  for case in bad {
    let (settings, expected) = case
    let message = try {
      let _ = generate(settings)
      "no error"
    } catch {
      @codegen.InvalidSettings(text) => text
      error => error.to_string()
    }
    assert_true(
      message.contains(expected),
      msg="I expected `\{expected}`, found `\{message}`",
    )
  }
}

///|
let review_model : String =
  #|$version: "2"
  #|namespace review
  #|use smithy.rpc#jsonRpc
  #|use smithy.rpc#method
  #|use smithy.rpc#rpcError
  #|@jsonRpc(versions: ["2.0"])
  #|service Echo { version: "1", operations: [NoOutput, Numbers] }
  #|@method(name: "noOutput", params: "named")
  #|operation NoOutput { input: NoOutputInput, errors: [Quiet, Partly] }
  #|structure NoOutputInput { name: String }
  #|@method(name: "numbers", params: "named")
  #|operation Numbers { input: NumbersInput, output: NumbersInput }
  #|structure NumbersInput { ratio: Double, small: Byte, medium: Short, big: BigInteger, decimal: Decimal }
  #|structure Decimal { value: String }
  #|@error("client")
  #|@rpcError(code: 1001, absentData: true)
  #|structure Quiet { detail: String }
  #|@error("client")
  #|@rpcError(code: 1002, dataMember: "reason")
  #|structure Partly { reason: String, extra: String }

///|
fn generate_from(
  model_text : String,
  settings : Json,
) -> Map[String, String] raise {
  let loaded = @rpc.loader().add_idl("review.smithy", model_text).assemble()
  guard loaded.model is Some(model) else {
    fail(loaded.diagnostics.map(d => d.message).join("\n"))
  }
  @python.run(@codegen.PluginContext::from_build(model, settings))
}

///|
test "no output, optional error data, integer widths and escaped names" {
  let server = generate_from(review_model, {
    "service": "review#Echo",
    "peer": "server",
    "package": "review_server",
  })
  let handler = server["review_server/handler.py"]
  // An operation with no output and no nullResult gives an empty object.
  assert_true(
    handler.contains(
      "    async def no_output(self, input: NoOutputInput, context: CallContext) -> None:\n",
    ),
  )
  assert_true(handler.contains("        return {}\n"))
  assert_false(handler.contains("Unit"))
  let models = server["review_server/models.py"]
  assert_true(models.contains("    small: Byte | None = None\n"))
  assert_true(models.contains("    medium: Short | None = None\n"))
  assert_true(models.contains("    big: BigInteger | None = None\n"))
  assert_true(models.contains("    ratio: Double | None = None\n"))
  // A shape with a name that the modules import gets a suffix.
  assert_true(models.contains("class Decimal_(BaseModel):"))
  assert_true(models.contains("    decimal: Decimal_ | None = None\n"))
  let errors = server["review_server/errors.py"]
  // absentData with optional members: the data model gets its defaults.
  assert_true(
    errors.contains(
      "    def __init__(self, data: QuietData | None = None) -> None:\n",
    ),
  )
  assert_true(errors.contains("        return Quiet()\n"))
  // dataMember with another optional member.
  assert_true(
    errors.contains(
      "        return Partly(PartlyData.model_validate({} if data is None else {\"reason\": data}))\n",
    ),
  )
  let client = generate_from(review_model, {
      "service": "review#Echo",
      "peer": "client",
      "package": "review_client",
    })["review_client/client.py"]
  assert_true(
    client.contains(
      "    async def no_output(self, input: NoOutputInput, *, checked: bool = True) -> None:\n",
    ),
  )
  assert_false(client.contains("Unit"))
}

///|
test "name collisions give first-person errors" {
  let cases : Array[(String, String)] = [
    (
      (
        #|$version: "2"
        #|namespace review
        #|use smithy.rpc#jsonRpc
        #|use smithy.rpc#method
        #|@jsonRpc(versions: ["2.0"])
        #|service Echo { version: "1", operations: [Both, BothNotification] }
        #|@method(name: "both", params: "named", kind: "either")
        #|operation Both {}
        #|@method(name: "bothNotification", params: "named", kind: "notification")
        #|operation BothNotification {}
      ),
      "I found operations `review#Both` and `review#BothNotification` with the same client method name `both_notification`.",
    ),
    (
      (
        #|$version: "2"
        #|namespace review
        #|use smithy.rpc#jsonRpc
        #|use smithy.rpc#method
        #|@jsonRpc(versions: ["2.0"])
        #|service Echo { version: "1", operations: [Say] }
        #|@method(name: "say", params: "named")
        #|operation Say { input: EchoClient }
        #|structure EchoClient { text: String }
      ),
      "I cannot name the client class `EchoClient`: shape `review#EchoClient` has that Python class name.",
    ),
  ]
  for case in cases {
    let (model_text, expected) = case
    let message = try {
      let _ = generate_from(model_text, {
        "service": "review#Echo",
        "peer": "client",
        "package": "review_client",
      })
      "no error"
    } catch {
      @codegen.InvalidSettings(text) => text
      error => error.to_string()
    }
    assert_eq(message, expected)
  }
  // New and Close are valid method names.
  let files = generate_from(
    (
      #|$version: "2"
      #|namespace review
      #|use smithy.rpc#jsonRpc
      #|use smithy.rpc#method
      #|@jsonRpc(versions: ["2.0"])
      #|service Echo { version: "1", operations: [New, Close] }
      #|@method(name: "new", params: "named", nullResult: true)
      #|operation New {}
      #|@method(name: "close", params: "named", nullResult: true)
      #|operation Close {}
    ),
    { "service": "review#Echo", "peer": "client", "package": "review_client" },
  )
  let client = files["review_client/client.py"]
  assert_true(
    client.contains(
      "    async def new(self, *, checked: bool = True) -> None:\n",
    ),
  )
  assert_true(
    client.contains(
      "    async def close(self, *, checked: bool = True) -> None:\n",
    ),
  )
}
