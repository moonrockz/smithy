///|
let echo_model : String =
  #|$version: "2"
  #|namespace example
  #|use smithy.rpc#jsonRpc
  #|use smithy.rpc#method
  #|use smithy.rpc#rpcError
  #|@jsonRpc(versions: ["2.0"])
  #|service Echo { version: "1", operations: [Say, Tell, Pair], rename: { "other#Item": "OtherItem" } }
  #|@method(name: "say", params: "named", resultMember: "text")
  #|operation Say { input: SayInput, output: SayOutput, errors: [Refused] }
  #|@method(name: "tell", params: "named", kind: "notification")
  #|operation Tell { input: SayInput }
  #|@method(name: "pair", params: "positional", positional: ["left", "right"], nullResult: true)
  #|operation Pair { input: PairInput }
  #|structure SayInput { @required text: String, type: Kind, items: Items, other: other#Item }
  #|structure SayOutput { @required text: String }
  #|structure PairInput { @required left: Integer, right: Long }
  #|list Items { member: Item }
  #|structure Item { @required amount: BigDecimal, at: Timestamp }
  #|enum Kind {
  #|  LOUD_VOICE = "loud"
  #|  quiet
  #|}
  #|@error("client")
  #|@rpcError(code: 1001, dataMember: "reason")
  #|structure Refused { @required reason: String }

///|
let other_model : String =
  #|$version: "2"
  #|namespace other
  #|structure Item { name: String }

///|
fn generate(settings : Json) -> Map[String, String] raise {
  let loaded = @rpc.loader()
    .add_idl("echo.smithy", echo_model)
    .add_idl("other.smithy", other_model)
    .assemble()
  guard loaded.model is Some(model) else {
    fail(loaded.diagnostics.map(d => d.message).join("\n"))
  }
  @moonbit.run(@codegen.PluginContext::from_build(model, settings))
}

///|
test "a server peer gets types, a handler trait and session rules" {
  let files = generate({
    "service": "example#Echo",
    "peer": "server",
    "module": "example/echo",
  })
  let names = files.keys().collect()
  names.sort_by((a, b) => a.lexical_compare(b))
  assert_true(names.contains("moon.mod"))
  assert_true(names.contains("handler.mbt"))
  assert_false(names.contains("client.mbt"))
  let types = files["types.mbt"]
  assert_true(types.has_prefix("// Code generated by moonbit-jsonrpc-codegen."))
  // Field names are snake case, a keyword gets a suffix, renames apply.
  assert_true(types.contains("  type_ : Kind?\n"))
  assert_true(types.contains("  other : OtherItem?\n"))
  assert_true(types.contains("  items : Array[Item]?\n"))
  assert_true(types.contains("pub(all) struct OtherItem {"))
  // Exact values and enum wire values.
  assert_true(types.contains("  amount : @rpc.Decimal\n"))
  assert_true(types.contains("\"loud\" => Kind::LoudVoice"))
  assert_true(
    types.contains(
      "@rpc.Timestamp::from_json(value, format=@rpc.EpochSeconds, path=path + \"/at\")",
    ),
  )
  let handler = files["handler.mbt"]
  assert_true(
    handler.contains(
      "  async say(Self, SayInput, @rpc.CallContext) -> String raise\n",
    ),
  )
  assert_true(
    handler.contains(
      "@rpc.positional_params(params, [\"left\", \"right\"], either=false, path=\"/params\")",
    ),
  )
  assert_true(
    handler.contains(
      "peer.on_notification(\"tell\", @rpc.NotificationOnly, async fn(params, context) {",
    ),
  )
  let errors = files["errors.mbt"]
  assert_true(
    errors.contains(
      "@rpc.RpcError(code=1001, message=\"Refused\", data=Some(Json::string(value.reason)))",
    ),
  )
  assert_true(files["session.mbt"].contains("@rpc.SessionRules::none()"))
  assert_true(files["moon.pkg"].contains("\"example/echo/rpc\" @rpc,"))
  assert_true(files["moon.mod"].contains("\"moonbitlang/async@0.22.5\""))
}

///|
test "a client peer gets a typed client with modeled errors" {
  let files = generate({
    "service": "example#Echo",
    "peer": "client",
    "module": "example/echo",
  })
  assert_false(files.contains("handler.mbt"))
  let client = files["client.mbt"]
  assert_true(
    client.contains(
      "pub async fn EchoClient::say(self : EchoClient, input : SayInput, checked~ : Bool = true) -> String raise {",
    ),
  )
  assert_true(
    client.contains("modeled_error(error, [(1001, refused_from_data)])"),
  )
  assert_true(
    client.contains(
      "Some(@rpc.to_positional(input.to_json(), [\"left\", \"right\"]))",
    ),
  )
  assert_true(
    files["errors.mbt"].contains("fn refused_from_data(data : Json?) -> Error"),
  )
}

///|
test "the output is the same on a second run" {
  let settings : Json = {
    "service": "example#Echo",
    "peer": "server",
    "module": "example/echo",
  }
  assert_eq(generate(settings), generate(settings))
}

///|
test "bad module settings give first-person messages" {
  let message = (settings : Json) => {
    try generate(settings) catch {
      @codegen.InvalidSettings(text) => text
      error => error.to_string()
    } noraise {
      _ => "no error"
    }
  }
  assert_true(
    message({ "service": "example#Echo", "peer": "server" }).contains(
      "I expected setting `module`, the MoonBit module name of the output.",
    ),
  )
  assert_true(
    message({ "service": "example#Echo", "peer": "server", "module": "Echo" }).contains(
      "I expected setting `module` to be a MoonBit module name such as `example/terminal`, found `Echo`.",
    ),
  )
}
