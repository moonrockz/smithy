name = "moonrockz/smithy-openapi"

version = "0.4.0"

description = "Convert assembled Smithy HTTP services to OpenAPI"

repository = "https://github.com/moonrockz/smithy"

license = "Apache-2.0"

keywords = [ "smithy", "openapi", "moonbit" ]

readme = "README.mbt.md"

warnings = "-implicit_impl_as_method"

import {
  "moonrockz/smithy@0.4.0",
  "moonrockz/smithy-jsonschema@0.4.0",
  "moonbitlang/x@0.5.5",
}
