    "contract.go": "// Package rpc runs generated Smithy JSON-RPC peers.\npackage rpc\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n)\n\n// Contract holds the prepared two-peer protocol.\ntype Contract struct {\n\tPeers   []PeerContract\n\tSession *SessionContract\n}\n\ntype PeerContract struct {\n\tName    string\n\tMethods []MethodContract\n}\n\ntype MethodContract struct {\n\tName           string\n\tKind           string   // request, notification, or either\n\tParams         string   // named, positional, or either\n\tPositional     []string // Member wire names in parameter order.\n\tNullResult     bool\n\tRefersToCall   *CallReference\n\tErrors         []ErrorContract\n\tValidateParams func(json.RawMessage) error\n\tValidateResult func(json.RawMessage) error\n}\n\ntype ErrorContract struct {\n\tCode         int64\n\tDataRequired bool\n\tDataAbsent   bool\n\tValidateData func(json.RawMessage) error\n}\n\ntype CallReference struct {\n\tWireName string\n\tPosition *int\n\tCode     *int64\n}\n\ntype SessionContract struct {\n\tStates            []string // The first state is the initial state.\n\tCapabilities      []CapabilityContract\n\tMethods           []MethodRule\n\tRefusals          []StateRefusal\n\tCapabilityRefusal *int64\n}\n\ntype CapabilityContract struct {\n\tName    string\n\tMethod  string\n\tPointer string\n}\n\ntype MethodRule struct {\n\tReceiver  string\n\tMethod    string\n\tAllowed   []string // nil permits every state.\n\tOnCall    string\n\tOnSuccess string\n\tOnError   string\n\tRequires  []string\n\tCancels   *CallReference\n}\n\ntype StateRefusal struct {\n\tState string\n\tCode  int64\n}\n\n// Handler returns the wire result or an error. It can call the other peer.\ntype Handler func(context.Context, json.RawMessage) (any, error)\n\n// Bind decodes typed parameters. Unknown members are ignored.\nfunc Bind[I, O any](handler func(context.Context, I) (O, error)) Handler {\n\treturn func(ctx context.Context, params json.RawMessage) (any, error) {\n\t\tvar input I\n\t\tif len(params) == 0 {\n\t\t\tparams = json.RawMessage(`{}`)\n\t\t}\n\t\tif err := Decode(params, &input); err != nil {\n\t\t\treturn nil, NewError(-32602, \"I expected valid RPC parameters\", nil)\n\t\t}\n\t\treturn handler(ctx, input)\n\t}\n}\n",
    "error.go": "package rpc\n\nimport (\n\t\"encoding/json\"\n\t\"errors\"\n\t\"math/big\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"go.lsp.dev/jsonrpc2\"\n)\n\n// Error is a JSON-RPC error with exact, optional data.\ntype Error struct {\n\tCode    int64           `json:\"code\"`\n\tMessage string          `json:\"message\"`\n\tData    json.RawMessage `json:\"data,omitempty\"`\n}\n\nfunc (e *Error) Error() string { return e.Message }\nfunc NewError(code int64, message string, data any) *Error {\n\te := &Error{Code: code, Message: message}\n\tif data != nil {\n\t\traw, err := json.Marshal(data)\n\t\tif err != nil {\n\t\t\treturn &Error{Code: -32603, Message: \"I could not encode the RPC error data\"}\n\t\t}\n\t\te.Data = raw\n\t}\n\treturn e\n}\nfunc wireError(err error) error {\n\tif err == nil {\n\t\treturn nil\n\t}\n\terr = modeledError(err)\n\tvar e *Error\n\tif errors.As(err, &e) {\n\t\treturn &jsonrpc2.Error{Code: jsonrpc2.Code(e.Code), Message: e.Message, Data: jsonrpc2.RawMessage(e.Data)}\n\t}\n\tvar upstream *jsonrpc2.Error\n\tif errors.As(err, &upstream) {\n\t\treturn upstream\n\t}\n\treturn &jsonrpc2.Error{Code: -32603, Message: \"I could not complete the RPC request\"}\n}\nfunc localError(err error) error {\n\tvar e *jsonrpc2.Error\n\tif errors.As(err, &e) {\n\t\treturn &Error{Code: int64(e.Code), Message: e.Message, Data: json.RawMessage(e.Data)}\n\t}\n\treturn err\n}\n\nfunc modeledError(err error) error {\n\tvar modeled interface{ RPCError() *Error }\n\tif errors.As(err, &modeled) {\n\t\tif rpcError := modeled.RPCError(); rpcError != nil {\n\t\t\treturn rpcError\n\t\t}\n\t}\n\treturn err\n}\n\n// UnmarshalJSON requires an integer code and a string message.\nfunc (e *Error) UnmarshalJSON(raw []byte) error {\n\tvar fields struct {\n\t\tCode    Integer         `json:\"code\"`\n\t\tMessage *string         `json:\"message\"`\n\t\tData    json.RawMessage `json:\"data\"`\n\t}\n\tif err := json.Unmarshal(raw, &fields); err != nil {\n\t\treturn err\n\t}\n\tif fields.Code == \"\" || fields.Message == nil {\n\t\treturn errors.New(\"I expected an RPC error code and message\")\n\t}\n\tcoefficient, exponent, ok := integerParts(string(fields.Code))\n\tif !ok || exponent.Cmp(big.NewInt(19)) > 0 {\n\t\treturn errors.New(\"I expected an RPC error code within int64\")\n\t}\n\tcount := int(exponent.Int64())\n\tif len(strings.TrimPrefix(coefficient, \"-\"))+count > 19 {\n\t\treturn errors.New(\"I expected an RPC error code within int64\")\n\t}\n\tcode, err := strconv.ParseInt(coefficient+strings.Repeat(\"0\", count), 10, 64)\n\tif err != nil {\n\t\treturn errors.New(\"I expected an RPC error code within int64\")\n\t}\n\t*e = Error{Code: code, Message: *fields.Message, Data: fields.Data}\n\treturn nil\n}\n",
