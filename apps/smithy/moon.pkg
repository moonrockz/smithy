pkgtype(kind: "executable")

import {
  "moonrockz/artifact-resources" @resources,
  "moonrockz/artifact-resources/local" @local_resources,
  "moonrockz/artifact-resources/http" @http_resources,
  "moonrockz/artifact-resources/cache" @resource_cache,
  "moonrockz/smithy",
  "moonrockz/smithy-validation" @validation,
  "moonrockz/smithy-codec" @codec,
  "moonrockz/smithy-codec/contract" @codec_contract,
  "moonrockz/smithy-codec/morphir",
  "moonrockz/smithy-ion-validation" @ion_validation,
  "moonrockz/ion/ion",
  "moonrockz/ion/text" @ion_text,
  "moonrockz/ion/binary" @ion_binary,
  "moonrockz/smithy-validation/rpc",
  "moonrockz/smithy-build" @build,
  "moonrockz/smithy-codegen/fixture" @codegen_fixture,
  "moonrockz/smithy-codegen-moonbit" @codegen_moonbit,
  "moonrockz/smithy-codegen-python" @codegen_python,
  "moonrockz/smithy-codegen-go" @go_codegen,
  "moonrockz/smithy-diff" @diff,
  "moonrockz/smithy-jsonschema" @jsonschema,
  "moonrockz/smithy-openapi" @openapi,
  "moonrockz/smithy-openrpc" @openrpc,
  "moonrockz/smithy-syntax" @syntax,
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
}

import {
  "moonbit-community/zipc",
} for "wbtest"

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
  "native-stub": [ "output_native.c", "input_native.c" ],
  targets: {
    "stdin_js.mbt": [ "js" ],
    "stdin_wasm_gc.mbt": [ "wasm-gc" ],
    "input_native.mbt": [ "native" ],
    "input_js.mbt": [ "js" ],
    "input_wasm.mbt": [ "wasm", "wasm-gc" ],
    "output_native.mbt": [ "native" ],
    "output_js.mbt": [ "js" ],
    "output_wasm.mbt": [ "wasm", "wasm-gc" ],
    "output_memory_wasm.mbt": [ "wasm" ],
    "output_memory_wasm_gc.mbt": [ "wasm-gc" ],
  },
)
