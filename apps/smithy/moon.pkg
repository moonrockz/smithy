pkgtype(kind: "executable")

import {
  "moonrockz/artifact-resources" @resources,
  "moonrockz/artifact-resources/local" @local_resources,
  "moonrockz/artifact-resources/http" @http_resources,
  "moonrockz/artifact-resources/cache" @resource_cache,
  "moonrockz/smithy",
  "moonrockz/smithy-validation" @validation,
  "moonrockz/smithy-validation/rpc",
  "moonrockz/smithy-build" @build,
  "moonrockz/smithy-diff" @diff,
  "moonrockz/smithy-jsonschema" @jsonschema,
  "moonrockz/smithy-openapi" @openapi,
  "moonrockz/smithy-syntax" @syntax,
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
}

import {
  "moonbit-community/zipc",
} for "wbtest"

options(
  link: { "wasm-gc": { "export-memory-name": "memory" } },
  "native-stub": [ "stdin_native.c", "output_native.c" ],
  targets: {
    "stdin_native.mbt": [ "native" ],
    "stdin_js.mbt": [ "js" ],
    "stdin_wasm.mbt": [ "wasm" ],
    "stdin_wasm_gc.mbt": [ "wasm-gc" ],
    "output_native.mbt": [ "native" ],
    "output_js.mbt": [ "js" ],
    "output_wasm.mbt": [ "wasm", "wasm-gc" ],
    "output_memory_wasm.mbt": [ "wasm" ],
    "output_memory_wasm_gc.mbt": [ "wasm-gc" ],
  },
)
