///|
struct Options {
  checkout : String
  check : Bool
} derive(Eq, Debug)

///|
/// The options of `args`, without the script binary at index 0.
fn parse_args(args : ArrayView[String]) -> Result[Options, String] {
  let mut checkout : String? = None
  let mut check = false
  for arg in args {
    if arg == "--check" {
      check = true
    } else if arg.has_prefix("-") {
      return Err("unknown option " + arg)
    } else if checkout is Some(_) {
      return Err("more than one CHECKOUT: " + arg)
    } else {
      checkout = Some(arg)
    }
  }
  Ok({ checkout: checkout.unwrap_or(".dev/out/reference-smithy"), check })
}

///|
/// UTF-16 code unit order, as Java's `String.compareTo`. `String::compare` orders by length first.
fn compare_code_units(a : String, b : String) -> Int {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    let x = a.code_unit_at(i).to_int()
    let y = b.code_unit_at(i).to_int()
    if x != y {
      return if x < y { -1 } else { 1 }
    }
  }
  a.length().compare(b.length())
}

///|
/// The starting files, replaced or added by the case files by name, sorted by name. The same merge as
/// `Lesson::case_files` in site/tour/model.
fn merge_files(start : Array[(String, String)], case_files : Array[(String, String)]) -> Array[(String, String)] {
  let merged = start.copy()
  for file in case_files {
    match merged.search_by(f => f.0 == file.0) {
      Some(i) => merged[i] = file
      None => merged.push(file)
    }
  }
  merged.sort_by((a, b) => compare_code_units(a.0, b.0))
  merged
}

///|
fn git_blob_hash(text : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha1(@utf8.encode(
    "blob " + @utf8.encode(text).length().to_string() + "\u{0000}" + text,
  )))
}

///|
fn java_quote(value : String) -> String {
  "\"" + value.replace_all(old="\\", new="\\\\").replace_all(old="\"", new="\\\"") + "\""
}

///|
async fn checked(command : String, args : Array[String]) -> String {
  let (status, out, err) = @process.collect_output(command, args)
  if status != 0 {
    eprintln(command + " failed\n" + out.text() + err.text())
    @sys.exit(1)
  }
  out.text()
}

///|
async fn collect_files(root : String, relative : String) -> Array[String] {
  let files : Array[String] = []
  if !@fs.exists(root + "/" + relative) { return files }
  for name in @fs.readdir(root + "/" + relative, sort=true) {
    let path = relative + "/" + name
    if @fs.kind(root + "/" + path) is Directory { files.append(collect_files(root, path)) }
    else { files.push(path) }
  }
  files
}

///|
/// The names in `path`, sorted, without the names that start with `.`. The same rule as `list_dir` in
/// site/tour/source/read.mbt.
async fn list_dir(path : String) -> Array[String] {
  @fs.readdir(path, sort=true).filter(name => !name.has_prefix("."))
}

///|
/// The files directly in `path`, as (name, text). The loader in site/tour/source/read.mbt fails on a sub-folder and
/// on a name that does not end in `.smithy` or `.selector` and is not a data file of the lesson; this script fails on
/// them too.
async fn read_files(path : String, data~ : Array[String] = []) -> Array[(String, String)] {
  let files : Array[(String, String)] = []
  if !@fs.exists(path) { return files }
  for name in list_dir(path) {
    if @fs.kind(path + "/" + name) is Directory ||
      !(name.has_suffix(".smithy") || name.has_suffix(".selector") || data.contains(name)) {
      fail(path + "/" + name + ": a lesson file must be a .smithy or .selector file directly in its files folder")
    }
    files.push((name, @fs.read_file(path + "/" + name).text()))
  }
  files
}

///|
/// The files of a diff lesson in `path`: the files of its folders `old` and `new`, named `old/<name>` and
/// `new/<name>`. The same rule as `read_sides` in site/tour/source/read.mbt: any other entry is an error.
async fn read_sides(path : String) -> Array[(String, String)] {
  let files : Array[(String, String)] = []
  if !@fs.exists(path) { return files }
  for side in list_dir(path) {
    if !(side == "old" || side == "new") || !(@fs.kind(path + "/" + side) is Directory) {
      fail(path + "/" + side + ": a diff lesson keeps its files in the folders old/ and new/")
    }
    for file in read_files(path + "/" + side) {
      files.push((side + "/" + file.0, file.1))
    }
  }
  files
}

///|
/// What the harness writes for a case, from the lesson output name.
struct Flags {
  json_schema : Bool
  json_ast : Bool
  openapi : String?
  http_protocols : Bool
  selector : Bool
} derive(Eq, Debug)

///|
fn flags_of(output : String?) -> Flags {
  match output {
    Some("JsonAst") => { json_schema: false, json_ast: true, openapi: None, http_protocols: false, selector: false }
    Some("JsonSchema") => { json_schema: true, json_ast: false, openapi: None, http_protocols: false, selector: false }
    Some("OpenApi30") => { json_schema: false, json_ast: false, openapi: Some("3.0.2"), http_protocols: true, selector: false }
    Some("OpenApi31") => { json_schema: false, json_ast: false, openapi: Some("3.1.0"), http_protocols: true, selector: false }
    Some("Selector") => { json_schema: false, json_ast: false, openapi: None, http_protocols: false, selector: true }
    _ => { json_schema: false, json_ast: false, openapi: None, http_protocols: false, selector: false }
  }
}

///|
/// Whether a case uses the smithy.rpc traits: a file names the namespace. The playground core always loads them;
/// the harness loads them only for these cases, so that the JSON Schema of other cases has no smithy.rpc shapes.
fn uses_smithy_rpc(files : Array[(String, String)]) -> Bool {
  files.iter().any(file => file.1.contains("smithy.rpc#"))
}

///|
/// Whether a case uses the contract traits: a file names the namespace. The harness loads `contracts.smithy` from
/// the compiled `smithy-contract-traits` module only for these cases.
fn uses_smithy_contracts(files : Array[(String, String)]) -> Bool {
  files.iter().any(file => file.1.contains("smithy.contracts#"))
}

///|
/// Whether `lesson.json` is that of a static lesson: it has no files/ and no cases/.
fn is_static(meta : Json) -> Bool {
  meta is { "static": True, .. }
}

///|
/// The selector of a case: the text of its query file (a name that ends with `.selector`), else the `selector` of
/// `lesson.json`, else none. The same rule as `query_of` in site/tour/model.
fn case_selector(files : Array[(String, String)], fixed : String?) -> String? {
  for file in files {
    if file.0.has_suffix(".selector") { return Some(file.1) }
  }
  fixed
}

///|
/// The names of the files of a lesson that hold data in place of a model: the value file of a value lesson, the
/// transcript file of a transcript lesson, and the message file of a message lesson with the request file of its
/// context. The same rule as `Engine::data_files` in site/tour/model.
fn data_files(lesson : Json) -> Array[String] {
  match lesson {
    { "value": { "file": String(file), .. }, .. } | { "transcript": { "file": String(file), .. }, .. } => [file]
    { "message": { "file": String(file), "context": { "request": String(request), .. }, .. }, .. } =>
      [file, request]
    { "message": { "file": String(file), .. }, .. } => [file]
    _ => []
  }
}

///|
/// The cases of every lesson, in the input format of the harness.
async fn lesson_cases(root : String) -> Array[Json] {
  let cases : Array[Json] = []
  for dir in list_dir(root) {
    let base = root + "/" + dir
    if !(@fs.kind(base) is Directory) { continue }
    let meta = @json.parse(@fs.read_file(base + "/lesson.json").text())
    // A static lesson has no files/ and no cases/.
    if is_static(meta) { continue }
    let flags = flags_of(match meta {
      { "output": String(output), .. } => Some(output)
      _ => None
    })
    // A diff lesson keeps the files of the old and the new model in files/old and files/new.
    let diff = meta is { "diff": True, .. }
    let data = data_files(meta)
    let read = async fn(path : String) {
      if diff { read_sides(path) } else { read_files(path, data~) }
    }
    let start = read(base + "/files")
    let fixed = match meta {
      { "selector": String(selector), .. } => Some(selector)
      _ => None
    }
    for name in list_dir(base + "/cases") {
      if !(@fs.kind(base + "/cases/" + name) is Directory) { continue }
      let files = merge_files(start, read(base + "/cases/" + name + "/files"))
      let entry : Map[String, Json] = {
        "id": Json::string(dir + "/" + name),
        "json_schema": Json::boolean(flags.json_schema),
        "json_ast": Json::boolean(flags.json_ast),
        "http_protocols": Json::boolean(flags.http_protocols),
        "smithy_rpc": Json::boolean(uses_smithy_rpc(files)),
        "smithy_contracts": Json::boolean(uses_smithy_contracts(files)),
        "diff": Json::boolean(diff),
        "load": Json::array(files.filter(f => !data.contains(f.0)).map(f => Json::string(f.0))),
        "files": Json::array(files.map(f => Json::object({ "name": Json::string(f.0), "text": Json::string(f.1) }))),
      }
      if flags.openapi is Some(version) { entry["openapi"] = Json::string(version) }
      if flags.selector && case_selector(files, fixed) is Some(selector) { entry["selector"] = Json::string(selector) }
      cases.push(Json::object(entry))
    }
  }
  cases
}

///|
/// Verify the pinned Java sources against the GitHub tree of the reference SHA and compile them with the harness.
async fn compile_reference(source : String, classes : String) -> Unit {
  let tree = @json.parse(checked("curl", ["-fsSL", "--retry", "2",
    "https://api.github.com/repos/smithy-lang/smithy/git/trees/" + reference_sha + "?recursive=1",
  ]))
  guard tree is { "sha": String(sha), "tree": Array(entries), "truncated": False, .. } && sha == reference_sha else {
    fail("Pinned Java source tree is missing, mismatched or truncated")
  }
  let blobs : Map[String, String] = Map([])
  for entry in entries {
    if entry is { "type": String("blob"), "path": String(path), "sha": String(blob), .. } { blobs[path] = blob }
  }
  if @fs.exists(classes) { @fs.rmdir(classes, recursive=true) }
  @fs.mkdir(classes, recursive=true, allow_exist=true)
  let harness_path = scratch + "/ReferenceTour.java"
  @fs.write_file(harness_path, harness)
  let sources = [harness_path]
  let resources : Map[String, String] = Map([])
  let verified : Array[Json] = []
  for module_ in [
    "smithy-utils", "smithy-jmespath", "smithy-model", "smithy-model-jmespath", "smithy-contract-traits", "smithy-build", "smithy-diff",
    "smithy-protocol-traits", "smithy-aws-traits", "smithy-jsonschema", "smithy-openapi-traits", "smithy-openapi",
  ] {
    let java_prefix = module_ + "/src/main/java"
    let resource_prefix = module_ + "/src/main/resources"
    let paths = collect_files(source, java_prefix) + collect_files(source, resource_prefix)
    if paths.is_empty() { fail("No Java sources for " + module_ + " in " + source) }
    for path in paths {
      let text = @fs.read_file(source + "/" + path).text()
      guard blobs.get(path) is Some(blob) else { fail("Untracked reference source " + path) }
      assert_eq(git_blob_hash(text), blob, msg="Java reference blob mismatch: " + path)
      verified.push(Json::object({ "path": Json::string(path), "gitBlob": Json::string(blob) }))
      if path.has_prefix(java_prefix + "/") {
        if path.has_suffix(".java") && !path.has_suffix("/module-info.java") { sources.push(source + "/" + path) }
      } else {
        let relative = path[resource_prefix.length() + 1:].to_owned()
        if (relative.has_prefix("META-INF/services/") || relative == "META-INF/smithy/manifest") && resources.get(relative) is Some(old) {
          resources[relative] = old.trim_end().to_owned() + "\n" + text
        } else { resources[relative] = text }
      }
    }
  }
  for relative, text in resources {
    let target = classes + "/" + relative
    let parts = target.split("/").map(p => p.to_owned()).to_array()
    ignore(parts.pop())
    @fs.mkdir(parts.join("/"), recursive=true, allow_exist=true)
    @fs.write_file(target, text)
  }
  @fs.write_file(scratch + "/source-inventory.json", Json::object({
    "referenceSha": Json::string(reference_sha), "files": Json::array(verified),
  }).stringify(indent=2) + "\n")
  let options = ["-proc:none", "-encoding", "UTF-8", "-d", classes, "-cp", classes] + sources
  let argfile = scratch + "/javac.args"
  @fs.write_file(argfile, options.map(java_quote).join("\n") + "\n")
  println("Compiling hash-verified pinned Java sources")
  ignore(checked("javac", ["@" + argfile]))
}

///|
async fn main {
  let options = match parse_args(@env.args()[1:]) {
    Ok(options) => options
    Err(message) => {
      eprintln(message + "\nUsage: moonx scripts/reference-tour.mbtx [CHECKOUT] [--check]")
      @sys.exit(2)
      return
    }
  }
  let classes = scratch + "/classes"
  @fs.mkdir(scratch, recursive=true, allow_exist=true)
  compile_reference(options.checkout, classes)
  let input = scratch + "/cases.json"
  @fs.write_file(input, Json::array(lesson_cases(lessons_root)).stringify(indent=2) + "\n")
  let output = scratch + "/reference-events.json"
  println(checked("java", ["-cp", classes, "ReferenceTour", input, output, reference_sha, smithy_rpc_path]).trim_end())
  let actual = @fs.read_file(output).text()
  if options.check {
    let committed = if @fs.exists(results_path) { @fs.read_file(results_path).text() } else { "" }
    if actual != committed {
      eprintln(results_path + " differs from the Java reference; run `mise run reference:tour`")
      @sys.exit(1)
    }
    println("Verified " + results_path)
  } else {
    @fs.write_file(results_path, actual)
    println("Wrote " + results_path)
  }
}

///|
test "the arguments give the checkout and the check flag" {
  assert_eq(parse_args([]), Ok({ checkout: ".dev/out/reference-smithy", check: false }))
  assert_eq(parse_args(["../smithy", "--check"]), Ok({ checkout: "../smithy", check: true }))
  assert_eq(parse_args(["--check", "../smithy"]), Ok({ checkout: "../smithy", check: true }))
  assert_true(parse_args(["--force"]) is Err(_))
  assert_true(parse_args(["a", "b"]) is Err(_))
}

///|
test "a case replaces and adds files by name, sorted in code unit order" {
  let start = [("model.smithy", "start"), ("b.smithy", "b")]
  let case_files = [("model.smithy", "edited"), ("a-long-name.smithy", "new")]
  assert_eq(merge_files(start, case_files), [
    ("a-long-name.smithy", "new"), ("b.smithy", "b"), ("model.smithy", "edited"),
  ])
  assert_eq(merge_files(start, []), [("b.smithy", "b"), ("model.smithy", "start")])
}

///|
test "the selector of a case is its query file, else the lesson selector" {
  let files = [("model.smithy", "m"), ("query.selector", "operation\n")]
  assert_eq(case_selector(files, Some("string")), Some("operation\n"))
  assert_eq(case_selector([("model.smithy", "m")], Some("string")), Some("string"))
  assert_eq(case_selector([("model.smithy", "m")], None), None)
}

///|
test "javac argument files quote spaces and Windows path separators" {
  assert_eq(java_quote("C:\\source files\\Test.java"), "\"C:\\\\source files\\\\Test.java\"")
}

///|
test "the lesson output gives the harness flags" {
  let none = { json_schema: false, json_ast: false, openapi: None, http_protocols: false, selector: false }
  assert_eq(flags_of(None), none)
  assert_eq(flags_of(Some("JsonAst")), { ..none, json_ast: true })
  assert_eq(flags_of(Some("JsonSchema")), { ..none, json_schema: true })
  assert_eq(
    flags_of(Some("OpenApi30")),
    { json_schema: false, json_ast: false, openapi: Some("3.0.2"), http_protocols: true, selector: false },
  )
  assert_eq(
    flags_of(Some("OpenApi31")),
    { json_schema: false, json_ast: false, openapi: Some("3.1.0"), http_protocols: true, selector: false },
  )
  assert_eq(flags_of(Some("Selector")), { ..none, selector: true })
}

///|
test "a case uses smithy.rpc when a file names the namespace" {
  assert_true(uses_smithy_rpc([("a.smithy", "use smithy.rpc#jsonRpc")]))
  assert_false(uses_smithy_rpc([("a.smithy", "namespace example")]))
}

///|
test "a case uses the contract traits when a file names the namespace" {
  assert_true(uses_smithy_contracts([("a.smithy", "use smithy.contracts#conditions")]))
  assert_false(uses_smithy_contracts([("a.smithy", "namespace example")]))
}

///|
test "a static lesson has no cases to read" {
  assert_true(is_static(@json.parse("{\"slug\": \"a\", \"static\": true}")))
  assert_false(is_static(@json.parse("{\"slug\": \"a\", \"static\": false}")))
  assert_false(is_static(@json.parse("{\"slug\": \"a\"}")))
}

///|
async test "lesson_cases skips a static lesson that has no cases folder" {
  let root = @fs.tmpdir(prefix="static-lessons")
  defer @fs.rmdir(root, recursive=true)
  @fs.mkdir(root + "/01-s/", recursive=true, allow_exist=true)
  @fs.write_file(root + "/01-s/lesson.json", "{\"slug\": \"s\", \"static\": true}")
  @fs.mkdir(root + "/02-m/files", recursive=true, allow_exist=true)
  @fs.mkdir(root + "/02-m/cases/start", recursive=true, allow_exist=true)
  @fs.write_file(root + "/02-m/lesson.json", "{\"slug\": \"m\"}")
  @fs.write_file(root + "/02-m/files/model.smithy", "namespace example\n")
  let cases = lesson_cases(root)
  let ids = cases.map(c => match c { { "id": String(id), .. } => id; _ => "" })
  assert_eq(ids, ["02-m/start"])
}

///|
test "the data files of a lesson are those of its engine" {
  assert_eq(data_files(@json.parse("{\"slug\": \"a\"}")), [])
  assert_eq(
    data_files(@json.parse("{\"slug\": \"a\", \"value\": {\"file\": \"order.json\", \"shape\": \"x#Y\"}}")),
    ["order.json"],
  )
  assert_eq(
    data_files(@json.parse("{\"slug\": \"a\", \"transcript\": {\"file\": \"exchange.json\", \"protocol\": \"x#P\"}}")),
    ["exchange.json"],
  )
}

///|
async test "lesson_cases loads only the model files of a transcript lesson, and keeps all files for the digest" {
  // A folder of its own, removed when the test ends, also after a failed assert.
  let root = @fs.tmpdir(prefix="transcript-lessons")
  defer @fs.rmdir(root, recursive=true)
  @fs.mkdir(root + "/01-t/files", recursive=true, allow_exist=true)
  @fs.mkdir(root + "/01-t/cases/start", recursive=true, allow_exist=true)
  @fs.write_file(
    root + "/01-t/lesson.json",
    "{\"slug\": \"t\", \"transcript\": {\"file\": \"exchange.json\", \"protocol\": \"x#P\"}}",
  )
  @fs.write_file(root + "/01-t/files/model.smithy", "namespace example\n")
  @fs.write_file(root + "/01-t/files/exchange.json", "{}")
  let cases = lesson_cases(root)
  let names = fn(key : String) {
    match cases[0] {
      { "files": Array(files), "load": Array(load), .. } =>
        if key == "load" {
          load.map(l => match l { String(name) => name; _ => "" })
        } else {
          files.map(f => match f { { "name": String(name), .. } => name; _ => "" })
        }
      _ => []
    }
  }
  assert_eq(names("load"), ["model.smithy"])
  assert_eq(names("files"), ["exchange.json", "model.smithy"])
}

///|
async test "lesson_cases reads the old and new folders of a diff lesson" {
  let root = "diff-lessons-scratch"
  if @fs.exists(root) { @fs.rmdir(root, recursive=true) }
  @fs.mkdir(root + "/01-d/files/old", recursive=true, allow_exist=true)
  @fs.mkdir(root + "/01-d/files/new", recursive=true, allow_exist=true)
  @fs.mkdir(root + "/01-d/cases/start", recursive=true, allow_exist=true)
  @fs.mkdir(root + "/01-d/cases/grow/files/new", recursive=true, allow_exist=true)
  @fs.write_file(root + "/01-d/lesson.json", "{\"slug\": \"d\", \"diff\": true}")
  @fs.write_file(root + "/01-d/files/old/model.smithy", "old\n")
  @fs.write_file(root + "/01-d/files/new/model.smithy", "new\n")
  @fs.write_file(root + "/01-d/cases/grow/files/new/model.smithy", "newer\n")
  @fs.write_file(root + "/01-d/cases/grow/files/new/extra.smithy", "extra\n")
  let cases = lesson_cases(root)
  let stray = root + "/01-d/cases/bad/files"
  @fs.mkdir(stray, recursive=true, allow_exist=true)
  @fs.write_file(stray + "/model.smithy", "a case file outside old/ and new/\n")
  let failed = try {
    ignore(lesson_cases(root))
    false
  } catch {
    _ => true
  }
  @fs.rmdir(root, recursive=true)
  let summary = cases.map(c => match c {
    { "id": String(id), "diff": True, "files": Array(files), .. } =>
      id + ": " + files.map(f => match f {
        { "name": String(name), "text": String(text), .. } => name + "=" + text.trim_end().to_owned()
        _ => "?"
      }).join(" ")
    _ => "not a diff case"
  })
  assert_eq(summary, [
    "01-d/grow: new/extra.smithy=extra new/model.smithy=newer old/model.smithy=old",
    "01-d/start: new/model.smithy=new old/model.smithy=old",
  ])
  assert_true(failed)
}

///|
async test "lesson_cases marks a model lesson as no diff case" {
  let root = "model-lessons-scratch"
  if @fs.exists(root) { @fs.rmdir(root, recursive=true) }
  @fs.mkdir(root + "/01-m/files", recursive=true, allow_exist=true)
  @fs.mkdir(root + "/01-m/cases/start", recursive=true, allow_exist=true)
  @fs.write_file(root + "/01-m/lesson.json", "{\"slug\": \"m\"}")
  @fs.write_file(root + "/01-m/files/model.smithy", "namespace example\n")
  let cases = lesson_cases(root)
  @fs.rmdir(root, recursive=true)
  assert_true(cases[0] is { "diff": False, .. })
}

///|
test "data_files of a value lesson names the value file" {
  let meta = @json.parse("{\"slug\": \"v\", \"value\": {\"file\": \"order.json\", \"shape\": \"a#B\"}}")
  assert_eq(data_files(meta), ["order.json"])
}

///|
test "data_files of a message lesson names the message file and the request file" {
  let request = @json.parse("{\"slug\": \"m\", \"message\": {\"file\": \"call.json\", \"kind\": \"request\"}}")
  assert_eq(data_files(request), ["call.json"])
  let response = @json.parse("{\"slug\": \"m\", \"message\": {\"file\": \"reply.json\", \"kind\": \"response\", \"context\": {\"request\": \"call.json\"}}}")
  assert_eq(data_files(response), ["reply.json", "call.json"])
  let named = @json.parse("{\"slug\": \"m\", \"message\": {\"file\": \"reply.json\", \"kind\": \"response\", \"context\": {\"method\": \"a\"}}}")
  assert_eq(data_files(named), ["reply.json"])
  let envelope = @json.parse("{\"slug\": \"m\", \"message\": {\"file\": \"reply.json\", \"kind\": \"response\", \"context\": \"envelope-only\"}}")
  assert_eq(data_files(envelope), ["reply.json"])
}

///|
test "data_files of a model lesson is empty" {
  assert_eq(data_files(@json.parse("{\"slug\": \"m\"}")), [])
}

///|
async test "lesson_cases loads only the model files of a value lesson, and keeps all files for the digest" {
  let root = "value-lessons-scratch"
  if @fs.exists(root) { @fs.rmdir(root, recursive=true) }
  @fs.mkdir(root + "/01-v/files", recursive=true, allow_exist=true)
  @fs.mkdir(root + "/01-v/cases/start", recursive=true, allow_exist=true)
  @fs.write_file(root + "/01-v/lesson.json", "{\"slug\": \"v\", \"value\": {\"file\": \"order.json\", \"shape\": \"a#B\"}}")
  @fs.write_file(root + "/01-v/files/model.smithy", "namespace a\n")
  @fs.write_file(root + "/01-v/files/order.json", "{}\n")
  let cases = lesson_cases(root)
  @fs.rmdir(root, recursive=true)
  match cases[0] {
    { "load": Array(load), "files": Array(files), .. } => {
      assert_eq(load.map(l => match l { String(s) => s; _ => "?" }), ["model.smithy"])
      assert_eq(files.length(), 2)
    }
    _ => fail("the case has no load list")
  }
}
