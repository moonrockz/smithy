/// Write the Java reference results of the tour lesson cases to site/tour/reference-events.json.
/// Requires a JDK with javac/java; generated code/classes stay under .dev/.
/// Usage: moonx scripts/reference-tour.mbtx [CHECKOUT] [--check]
/// CHECKOUT is a checkout of smithy-lang/smithy at the reference SHA (default .dev/out/reference-smithy).
/// --check writes to a temporary file and fails when it differs from the committed file.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}

///|
/// The commit of pkgs/smithy/PRELUDE_SHA. site/tour/check/reference_test.mbt has the same value and compares it
/// with that file.
let reference_sha : String = "30bdab593f0c2cdf96036782cc3ce15c43a711ef"

///|
let lessons_root : String = "site/tour/lessons"

///|
let results_path : String = "site/tour/reference-events.json"

///|
let scratch : String = ".dev/out/reference-tour"

///|
/// The smithy.rpc trait definitions, the text of `@rpc.trait_definitions()`. site/tour/check/reference_test.mbt
/// compares the two.
let smithy_rpc_path : String = "site/tour/smithy-rpc-traits.smithy"

///|
/// Reads the cases (`[{"id", "json_schema", "http_protocols", "smithy_rpc", "files": [{"name", "text"}], "openapi"?}]`)
/// from args[0] and writes the results to args[1], with args[2] as the reference SHA. A case with `smithy_rpc` also
/// loads the smithy.rpc trait definitions from args[3]. The digest is SHA-256 over the files sorted by name of
/// name + NUL + text + NUL, in UTF-8: the case files and, for a `smithy_rpc` case, the definitions as the file
/// `<smithy-rpc-traits>` (`reference_digest` in site/tour/check/reference_test.mbt), so that a change of the
/// definitions makes the result stale.
let harness : String =
  #|import java.nio.charset.StandardCharsets;
  #|import java.nio.file.*;
  #|import java.security.MessageDigest;
  #|import java.util.*;
  #|import java.util.logging.*;
  #|import software.amazon.smithy.jsonschema.*;
  #|import software.amazon.smithy.model.*;
  #|import software.amazon.smithy.model.loader.*;
  #|import software.amazon.smithy.model.node.*;
  #|import software.amazon.smithy.model.shapes.*;
  #|import software.amazon.smithy.model.traits.ProtocolDefinitionTrait;
  #|import software.amazon.smithy.model.validation.*;
  #|import software.amazon.smithy.openapi.*;
  #|import software.amazon.smithy.openapi.fromsmithy.*;
  #|
  #|public final class ReferenceTour {
  #|  public static void main(String[] args) throws Exception {
  #|    Logger.getLogger("").setLevel(Level.OFF);
  #|    ArrayNode input = Node.parse(Files.readString(Path.of(args[0]))).expectArrayNode();
  #|    ObjectNode.Builder cases = ObjectNode.builder();
  #|    for (Node node : input) {
  #|      ObjectNode test = node.expectObjectNode();
  #|      String id = test.expectStringMember("id").getValue();
  #|      List<ObjectNode> files = new ArrayList<>(test.expectArrayMember("files").getElementsAs(ObjectNode.class));
  #|      if (test.expectBooleanMember("smithy_rpc").getValue()) {
  #|        files.add(Node.objectNodeBuilder().withMember("name", "<smithy-rpc-traits>")
  #|            .withMember("text", Files.readString(Path.of(args[3]))).build());
  #|      }
  #|      files.sort(Comparator.comparing(file -> file.expectStringMember("name").getValue()));
  #|      MessageDigest sha = MessageDigest.getInstance("SHA-256");
  #|      ModelAssembler assembler = test.expectBooleanMember("http_protocols").getValue()
  #|          ? Model.assembler().discoverModels(ReferenceTour.class.getClassLoader())
  #|          : Model.assembler();
  #|      for (ObjectNode file : files) {
  #|        String name = file.expectStringMember("name").getValue();
  #|        String text = file.expectStringMember("text").getValue();
  #|        sha.update((name + '\0' + text + '\0').getBytes(StandardCharsets.UTF_8));
  #|        // A lesson file name ends in .smithy; the definitions load as IDL under such a name.
  #|        assembler.addUnparsedModel(name.equals("<smithy-rpc-traits>") ? "smithy-rpc-traits.smithy" : name, text);
  #|      }
  #|      ValidatedResult<Model> result = assembler.assemble();
  #|      List<String> events = new ArrayList<>();
  #|      boolean blocked = false;
  #|      for (ValidationEvent event : result.getValidationEvents()) {
  #|        Severity severity = event.getSeverity();
  #|        if (severity != Severity.WARNING && severity != Severity.DANGER && severity != Severity.ERROR) continue;
  #|        // ERROR and DANGER stop the output, as Severity::blocks_output in site/tour/model says.
  #|        if (severity != Severity.WARNING) blocked = true;
  #|        events.add(event.getId() + "|" + severity.name() + "|"
  #|            + event.getShapeId().map(ShapeId::toString).orElse("-"));
  #|      }
  #|      Collections.sort(events);
  #|      ObjectNode.Builder entry = ObjectNode.builder()
  #|          .withMember("digest", HexFormat.of().formatHex(sha.digest()))
  #|          .withMember("events", Node.fromStrings(events));
  #|      if (test.expectBooleanMember("json_schema").getValue() && !blocked) {
  #|        entry.withMember("json_schema",
  #|            JsonSchemaConverter.builder().model(result.unwrap()).build().convert().toNode());
  #|      }
  #|      if (test.getMember("openapi").isPresent() && !blocked) {
  #|        List<ShapeId> services = new ArrayList<>();
  #|        Model model = result.unwrap();
  #|        for (ServiceShape service : model.getServiceShapes()) {
  #|          boolean hasProtocol = service.getAllTraits().keySet().stream().anyMatch(t ->
  #|              model.getShape(t).map(d -> d.hasTrait(ProtocolDefinitionTrait.ID)).orElse(false));
  #|          if (hasProtocol) services.add(service.getId());
  #|        }
  #|        if (services.size() > 1) throw new IllegalStateException(id + ": more than one service with a protocol trait");
  #|        Node openapi = Node.nullNode();
  #|        if (services.size() == 1) {
  #|          ObjectNode settings = Node.objectNodeBuilder()
  #|              .withMember("service", services.get(0).toString())
  #|              .withMember("version", test.expectStringMember("openapi").getValue()).build();
  #|          try {
  #|            openapi = OpenApiConverter.create().config(OpenApiConfig.fromNode(settings)).convertToNode(model);
  #|          } catch (RuntimeException e) {
  #|            System.err.println("reference: " + id + ": the OpenAPI conversion failed: " + e);
  #|            openapi = Node.nullNode();
  #|          }
  #|        }
  #|        entry.withMember("openapi", openapi);
  #|      }
  #|      cases.withMember(id, entry.build());
  #|      System.out.println("reference: " + id);
  #|    }
  #|    ObjectNode output = ObjectNode.builder()
  #|        .withMember("reference_sha", args[2])
  #|        .withMember("cases", cases.build()).build();
  #|    Files.writeString(Path.of(args[1]), Node.prettyPrintJson(output.withDeepSortedKeys()) + "\n");
  #|  }
  #|}

///|
struct Options {
  checkout : String
  check : Bool
} derive(Eq, Debug)

///|
/// The options of `args`, without the script binary at index 0.
fn parse_args(args : ArrayView[String]) -> Result[Options, String] {
  let mut checkout : String? = None
  let mut check = false
  for arg in args {
    if arg == "--check" {
      check = true
    } else if arg.has_prefix("-") {
      return Err("unknown option " + arg)
    } else if checkout is Some(_) {
      return Err("more than one CHECKOUT: " + arg)
    } else {
      checkout = Some(arg)
    }
  }
  Ok({ checkout: checkout.unwrap_or(".dev/out/reference-smithy"), check })
}

///|
/// UTF-16 code unit order, as Java's `String.compareTo`. `String::compare` orders by length first.
fn compare_code_units(a : String, b : String) -> Int {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    let x = a.code_unit_at(i).to_int()
    let y = b.code_unit_at(i).to_int()
    if x != y {
      return if x < y { -1 } else { 1 }
    }
  }
  a.length().compare(b.length())
}

///|
/// The starting files, replaced or added by the case files by name, sorted by name. The same merge as
/// `Lesson::case_files` in site/tour/model.
fn merge_files(start : Array[(String, String)], case_files : Array[(String, String)]) -> Array[(String, String)] {
  let merged = start.copy()
  for file in case_files {
    match merged.search_by(f => f.0 == file.0) {
      Some(i) => merged[i] = file
      None => merged.push(file)
    }
  }
  merged.sort_by((a, b) => compare_code_units(a.0, b.0))
  merged
}

///|
fn git_blob_hash(text : String) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha1(@utf8.encode(
    "blob " + @utf8.encode(text).length().to_string() + "\u{0000}" + text,
  )))
}

///|
fn java_quote(value : String) -> String {
  "\"" + value.replace_all(old="\\", new="\\\\").replace_all(old="\"", new="\\\"") + "\""
}

///|
async fn checked(command : String, args : Array[String]) -> String {
  let (status, out, err) = @process.collect_output(command, args)
  if status != 0 {
    eprintln(command + " failed\n" + out.text() + err.text())
    @sys.exit(1)
  }
  out.text()
}

///|
async fn collect_files(root : String, relative : String) -> Array[String] {
  let files : Array[String] = []
  if !@fs.exists(root + "/" + relative) { return files }
  for name in @fs.readdir(root + "/" + relative, sort=true) {
    let path = relative + "/" + name
    if @fs.kind(root + "/" + path) is Directory { files.append(collect_files(root, path)) }
    else { files.push(path) }
  }
  files
}

///|
/// The names in `path`, sorted, without the names that start with `.`. The same rule as `list_dir` in
/// site/tour/source/read.mbt.
async fn list_dir(path : String) -> Array[String] {
  @fs.readdir(path, sort=true).filter(name => !name.has_prefix("."))
}

///|
/// The files directly in `path`, as (name, text). The loader in site/tour/source/read.mbt fails on a sub-folder and
/// on a name that does not end in `.smithy`; this script fails on them too.
async fn read_files(path : String) -> Array[(String, String)] {
  let files : Array[(String, String)] = []
  if !@fs.exists(path) { return files }
  for name in list_dir(path) {
    if @fs.kind(path + "/" + name) is Directory || !name.has_suffix(".smithy") {
      fail(path + "/" + name + ": a lesson file must be a .smithy file directly in its files folder")
    }
    files.push((name, @fs.read_file(path + "/" + name).text()))
  }
  files
}

///|
/// What the harness writes for a case, from the lesson output name.
struct Flags {
  json_schema : Bool
  openapi : String?
  http_protocols : Bool
} derive(Eq, Debug)

///|
fn flags_of(output : String?) -> Flags {
  match output {
    Some("JsonSchema") => { json_schema: true, openapi: None, http_protocols: false }
    Some("OpenApi30") => { json_schema: false, openapi: Some("3.0.2"), http_protocols: true }
    Some("OpenApi31") => { json_schema: false, openapi: Some("3.1.0"), http_protocols: true }
    _ => { json_schema: false, openapi: None, http_protocols: false }
  }
}

///|
/// Whether a case uses the smithy.rpc traits: a file names the namespace. The playground core always loads them;
/// the harness loads them only for these cases, so that the JSON Schema of other cases has no smithy.rpc shapes.
fn uses_smithy_rpc(files : Array[(String, String)]) -> Bool {
  files.iter().any(file => file.1.contains("smithy.rpc#"))
}

///|
/// Whether `lesson.json` is that of a static lesson: it has no files/ and no cases/.
fn is_static(meta : Json) -> Bool {
  meta is { "static": True, .. }
}

///|
/// The cases of every lesson, in the input format of the harness.
async fn lesson_cases(root : String) -> Array[Json] {
  let cases : Array[Json] = []
  for dir in list_dir(root) {
    let base = root + "/" + dir
    if !(@fs.kind(base) is Directory) { continue }
    let meta = @json.parse(@fs.read_file(base + "/lesson.json").text())
    // A static lesson has no files/ and no cases/.
    if is_static(meta) { continue }
    let flags = flags_of(match meta {
      { "output": String(output), .. } => Some(output)
      _ => None
    })
    let start = read_files(base + "/files")
    for name in list_dir(base + "/cases") {
      if !(@fs.kind(base + "/cases/" + name) is Directory) { continue }
      let files = merge_files(start, read_files(base + "/cases/" + name + "/files"))
      let entry : Map[String, Json] = {
        "id": Json::string(dir + "/" + name),
        "json_schema": Json::boolean(flags.json_schema),
        "http_protocols": Json::boolean(flags.http_protocols),
        "smithy_rpc": Json::boolean(uses_smithy_rpc(files)),
        "files": Json::array(files.map(f => Json::object({ "name": Json::string(f.0), "text": Json::string(f.1) }))),
      }
      if flags.openapi is Some(version) { entry["openapi"] = Json::string(version) }
      cases.push(Json::object(entry))
    }
  }
  cases
}

///|
/// Verify the pinned Java sources against the GitHub tree of the reference SHA and compile them with the harness.
async fn compile_reference(source : String, classes : String) -> Unit {
  let tree = @json.parse(checked("curl", ["-fsSL", "--retry", "2",
    "https://api.github.com/repos/smithy-lang/smithy/git/trees/" + reference_sha + "?recursive=1",
  ]))
  guard tree is { "sha": String(sha), "tree": Array(entries), "truncated": False, .. } && sha == reference_sha else {
    fail("Pinned Java source tree is missing, mismatched or truncated")
  }
  let blobs : Map[String, String] = Map([])
  for entry in entries {
    if entry is { "type": String("blob"), "path": String(path), "sha": String(blob), .. } { blobs[path] = blob }
  }
  if @fs.exists(classes) { @fs.rmdir(classes, recursive=true) }
  @fs.mkdir(classes, recursive=true, allow_exist=true)
  let harness_path = scratch + "/ReferenceTour.java"
  @fs.write_file(harness_path, harness)
  let sources = [harness_path]
  let resources : Map[String, String] = Map([])
  let verified : Array[Json] = []
  for module_ in [
    "smithy-utils", "smithy-jmespath", "smithy-model", "smithy-build", "smithy-diff",
    "smithy-protocol-traits", "smithy-aws-traits", "smithy-jsonschema", "smithy-openapi-traits", "smithy-openapi",
  ] {
    let java_prefix = module_ + "/src/main/java"
    let resource_prefix = module_ + "/src/main/resources"
    let paths = collect_files(source, java_prefix) + collect_files(source, resource_prefix)
    if paths.is_empty() { fail("No Java sources for " + module_ + " in " + source) }
    for path in paths {
      let text = @fs.read_file(source + "/" + path).text()
      guard blobs.get(path) is Some(blob) else { fail("Untracked reference source " + path) }
      assert_eq(git_blob_hash(text), blob, msg="Java reference blob mismatch: " + path)
      verified.push(Json::object({ "path": Json::string(path), "gitBlob": Json::string(blob) }))
      if path.has_prefix(java_prefix + "/") {
        if path.has_suffix(".java") && !path.has_suffix("/module-info.java") { sources.push(source + "/" + path) }
      } else {
        let relative = path[resource_prefix.length() + 1:].to_owned()
        if (relative.has_prefix("META-INF/services/") || relative == "META-INF/smithy/manifest") && resources.get(relative) is Some(old) {
          resources[relative] = old.trim_end().to_owned() + "\n" + text
        } else { resources[relative] = text }
      }
    }
  }
  for relative, text in resources {
    let target = classes + "/" + relative
    let parts = target.split("/").map(p => p.to_owned()).to_array()
    ignore(parts.pop())
    @fs.mkdir(parts.join("/"), recursive=true, allow_exist=true)
    @fs.write_file(target, text)
  }
  @fs.write_file(scratch + "/source-inventory.json", Json::object({
    "referenceSha": Json::string(reference_sha), "files": Json::array(verified),
  }).stringify(indent=2) + "\n")
  let options = ["-proc:none", "-encoding", "UTF-8", "-d", classes, "-cp", classes] + sources
  let argfile = scratch + "/javac.args"
  @fs.write_file(argfile, options.map(java_quote).join("\n") + "\n")
  println("Compiling hash-verified pinned Java sources")
  ignore(checked("javac", ["@" + argfile]))
}

///|
async fn main {
  let options = match parse_args(@env.args()[1:]) {
    Ok(options) => options
    Err(message) => {
      eprintln(message + "\nUsage: moonx scripts/reference-tour.mbtx [CHECKOUT] [--check]")
      @sys.exit(2)
      return
    }
  }
  let classes = scratch + "/classes"
  @fs.mkdir(scratch, recursive=true, allow_exist=true)
  compile_reference(options.checkout, classes)
  let input = scratch + "/cases.json"
  @fs.write_file(input, Json::array(lesson_cases(lessons_root)).stringify(indent=2) + "\n")
  let output = scratch + "/reference-events.json"
  println(checked("java", ["-cp", classes, "ReferenceTour", input, output, reference_sha, smithy_rpc_path]).trim_end())
  let actual = @fs.read_file(output).text()
  if options.check {
    let committed = if @fs.exists(results_path) { @fs.read_file(results_path).text() } else { "" }
    if actual != committed {
      eprintln(results_path + " differs from the Java reference; run `mise run reference:tour`")
      @sys.exit(1)
    }
    println("Verified " + results_path)
  } else {
    @fs.write_file(results_path, actual)
    println("Wrote " + results_path)
  }
}

///|
test "the arguments give the checkout and the check flag" {
  assert_eq(parse_args([]), Ok({ checkout: ".dev/out/reference-smithy", check: false }))
  assert_eq(parse_args(["../smithy", "--check"]), Ok({ checkout: "../smithy", check: true }))
  assert_eq(parse_args(["--check", "../smithy"]), Ok({ checkout: "../smithy", check: true }))
  assert_true(parse_args(["--force"]) is Err(_))
  assert_true(parse_args(["a", "b"]) is Err(_))
}

///|
test "a case replaces and adds files by name, sorted in code unit order" {
  let start = [("model.smithy", "start"), ("b.smithy", "b")]
  let case_files = [("model.smithy", "edited"), ("a-long-name.smithy", "new")]
  assert_eq(merge_files(start, case_files), [
    ("a-long-name.smithy", "new"), ("b.smithy", "b"), ("model.smithy", "edited"),
  ])
  assert_eq(merge_files(start, []), [("b.smithy", "b"), ("model.smithy", "start")])
}

///|
test "javac argument files quote spaces and Windows path separators" {
  assert_eq(java_quote("C:\\source files\\Test.java"), "\"C:\\\\source files\\\\Test.java\"")
}

///|
test "the lesson output gives the harness flags" {
  let none = { json_schema: false, openapi: None, http_protocols: false }
  assert_eq(flags_of(None), none)
  assert_eq(flags_of(Some("JsonAst")), none)
  assert_eq(flags_of(Some("JsonSchema")), { ..none, json_schema: true })
  assert_eq(
    flags_of(Some("OpenApi30")),
    { json_schema: false, openapi: Some("3.0.2"), http_protocols: true },
  )
  assert_eq(
    flags_of(Some("OpenApi31")),
    { json_schema: false, openapi: Some("3.1.0"), http_protocols: true },
  )
}

///|
test "a case uses smithy.rpc when a file names the namespace" {
  assert_true(uses_smithy_rpc([("a.smithy", "use smithy.rpc#jsonRpc")]))
  assert_false(uses_smithy_rpc([("a.smithy", "namespace example")]))
}

///|
test "a static lesson has no cases to read" {
  assert_true(is_static(@json.parse("{\"slug\": \"a\", \"static\": true}")))
  assert_false(is_static(@json.parse("{\"slug\": \"a\", \"static\": false}")))
  assert_false(is_static(@json.parse("{\"slug\": \"a\"}")))
}
