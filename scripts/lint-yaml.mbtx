///|
/// Lint every YAML file in the repository with yamllint.
///
/// Usage: `mise run lint:yaml`, or `moonx scripts/lint-yaml.mbtx`. The ignore list is in `.yamllint.yml`.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn main {
  println("🔍 Linting YAML files...")
  let code = @process.run(
    "yamllint", ["--strict", "."],
    stdout=@stdio.stdout, stderr=@stdio.stderr,
  )
  if code != 0 {
    println("❌ YAML lint reported problems.")
    @sys.exit(if code > 0 { code } else { 1 })
  }
  println("✅ YAML lint complete")
}
