----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/http",
  "moonbitlang/async@0.22.7/socket",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/codec/base64",
  "moonbit-community/zipc@0.2.2",
  "moonbit-community/flate@0.2.0/gzip",
}
----

///|
/// Controlled HTTP fixtures for the public archive provider and built CLI.
/// No live public services. Usage: moonx scripts/test-public-http.mbtx [targets]

///|
async fn command(
  root : String,
  executable : String,
  args : Array[String],
  extra_env~ : Map[String, String] = Map([]),
  expected~ : Int32 = 0,
) -> String {
  let (code, out, err) = @process.collect_output(
    executable,
    args,
    cwd=root,
    extra_env~,
  )
  assert_eq(
    code,
    expected,
    msg=args.join(" ") + "\n" + out.text() + "\n" + err.text(),
  )
  out.text() + err.text()
}

///|
fn selection(
  field : String,
  location : String,
  root : String,
  digest : String,
) -> String {
  "{\"\{field}\":\"\{location}\",\"root\":\"\{root}\",\"globs\":[\"*.smithy\"]" +
  (if field == "url" { ",\"digest\":\"\{digest}\"" } else { "" }) +
  "}"
}

///|
async fn snapshot(dir : String) -> Map[String, String] {
  let out = Map([])
  let pending = [""]
  while !pending.is_empty() {
    let relative = pending.pop().unwrap()
    for name in @fs.readdir(dir + "/" + relative) {
      let child = if relative == "" { name } else { relative + "/" + name }
      if @fs.kind(dir + "/" + child) is Directory {
        pending.push(child)
      } else {
        out[child] = @fs.read_file(dir + "/" + child).text()
      }
    }
  }
  out
}

///|
fn tar_member(name : String, data : Bytes) -> Bytes {
  let header : Array[Byte] = Array::make(512, 0)
  fn put(at : Int32, text : String) {
    for i, byte in @utf8.encode(text) {
      header[at + i] = byte
    }
  }
  put(0, name)
  put(100, "0000644")
  put(108, "0000000")
  put(116, "0000000")
  let size = data.length().to_string(radix=8)
  put(124, "0".repeat(11 - size.length()) + size)
  put(136, "00000000000")
  header[156] = b'0'
  put(257, "ustar")
  put(263, "00")
  for i in 148..<156 {
    header[i] = b' '
  }
  let mut sum = 0
  for byte in header {
    sum += byte.to_int()
  }
  let checksum = sum.to_string(radix=8)
  put(148, "0".repeat(6 - checksum.length()) + checksum)
  header[154] = 0
  header[155] = b' '
  Bytes::from_array(header) +
  data +
  Bytes::make((512 - data.length() % 512) % 512, 0)
}

///|
fn github_selection(
  base : String,
  asset : String,
  root : String,
  digest : String,
) -> String {
  let value : Json = {
    "github": {
      "repository": "owner/models",
      "tag": "v1-fixtures",
      "asset": asset,
      "api": base,
    },
    "format": if asset.has_suffix("tgz") {
      "tgz"
    } else {
      "zip"
    },
    "digest": digest,
    "root": root,
    "globs": ["*.smithy"],
  }
  value.stringify()
}

///|
async fn github_builds(
  dir : String,
  executable : String,
  prefix : Array[String],
  target : String,
  base : String,
  digests : Map[String, String],
  requests : Array[String],
  denied : Ref[Bool],
) -> Unit {
  let supported = target == "native" || target == "js"
  let initial = requests.length()
  for asset in ["models.zip", "models.tgz"] {
    let stem = target + "-github-" + asset
    let digest = digests[asset]
    for remote in [false, true] {
      let label = if remote { "remote" } else { "local" }
      fn selected(root : String) -> String {
        if remote {
          github_selection(base, asset, root, digest)
        } else {
          selection("path", asset, root, digest)
        }
      }
      let config = "{\"version\":\"2.0\",\"sources\":[" +
        selected("models") +
        "],\"imports\":[" +
        selected("imports") +
        "],\"projections\":{\"extra\":{\"imports\":[" +
        selected("projection") +
        "]}},\"outputDirectory\":\"" +
        stem +
        "-" +
        label +
        "\"}"
      let config_path = dir + "/" + stem + "-" + label + ".json"
      @fs.write_file(config_path, config)
      let args = prefix +
        [
          "build",
          "--config",
          config_path,
          "--cache-dir",
          "github-cache-" + target,
        ]
      let output = command(
        dir,
        executable,
        args,
        expected=if remote && !supported { 1 } else { 0 },
      )
      if remote && !supported {
        assert_true(output.contains("unsupported-transport"), msg=output)
      }
      if remote && supported {
        let before = snapshot(dir + "/" + stem + "-remote")
        let request_count = requests.length()
        denied.val = true
        command(
          dir,
          executable,
          args + ["--offline"],
          extra_env=if target == "native" { { "PATH": "" } } else { Map([]) },
        )
        |> ignore
        denied.val = false
        assert_eq(requests.length(), request_count)
        assert_eq(snapshot(dir + "/" + stem + "-remote"), before)
        for projection in ["source", "extra"] {
          let local_model = @fs.read_file(
            dir + "/" + stem + "-local/" + projection + "/model/model.json",
          ).text()
          assert_eq(
            @fs.read_file(
              dir + "/" + stem + "-remote/" + projection + "/model/model.json",
            ).text(),
            local_model,
          )
          assert_eq(
            local_model.contains("example#Extra"),
            projection == "extra",
          )
          // ZIP and tar/gzip also match the original local ZIP model.
          assert_eq(
            local_model,
            @fs.read_file(
              dir + "/" + target + "-local/" + projection + "/model/model.json",
            ).text(),
          )
        }
        let miss = command(
          dir,
          executable,
          prefix +
          [
            "build",
            "--config",
            config_path,
            "--offline",
            "--cache-dir",
            "github-missing-" + target,
          ],
          expected=1,
        )
        assert_true(miss.contains("offline-miss"), msg=miss)
      }
    }
  }
  assert_eq(requests.length() - initial, if supported { 6 } else { 0 })
  if supported {
    let config = "{\"version\":\"2.0\",\"sources\":[" +
      github_selection(base, "models.zip", "broken", digests["models.zip"]) +
      "]}"
    let config_path = dir + "/" + target + "-github-diagnostic.json"
    @fs.write_file(config_path, config)
    let args = prefix +
      [
        "build",
        "--config",
        config_path,
        "--cache-dir",
        "github-cache-" + target,
      ]
    let diagnostic = command(dir, executable, args + ["--offline"], expected=1)
    for
      part in [
        "github:owner/models",
        "tag=v1-fixtures",
        "release=7",
        "asset=models.zip id=42",
        digests["models.zip"],
        "!/broken/bad.smithy",
      ] {
      assert_true(diagnostic.contains(part), msg=diagnostic)
    }
    @fs.write_file(
      config_path,
      "{\"version\":\"2.0\",\"sources\":[" +
      github_selection(base, "models.zip", "models", "sha256:" + "0".repeat(64)) +
      "]}",
    )
    let mismatch = command(dir, executable, args + ["--offline"], expected=1)
    assert_true(mismatch.contains("integrity-failure"), msg=mismatch)
  }
}

///|
fn repository_selection(
  base : String,
  kind : String,
  scope : String,
  jars : Map[String, Bytes],
) -> String {
  let root = match scope {
    "sources" => "models"
    "imports" => "imports"
    _ => "projection"
  }
  let file = match scope {
    "sources" => "service.smithy"
    "imports" => "shared.smithy"
    _ => "extra.smithy"
  }
  let value : Json = if kind.has_prefix("npm") {
    {
      "npm": {
        "registry": base + "/npm",
        "package": if kind == "npm-scoped" {
          "@fixture/models"
        } else {
          "models"
        },
        "version": "1.2.3",
      },
      "root": "package/" + root,
      "globs": ["*.smithy"],
    }
  } else {
    let fields : Map[String, Json] = {
      "maven": {
        "repository": base + "/maven",
        "group": "org.example",
        "artifact": "models",
        "version": "1.0.0",
        "classifier": scope,
        "checksum": if scope == "imports" {
          "sha256"
        } else {
          "sha1"
        },
      },
    }
    // Explicit pins take precedence over repository sidecar retrieval.
    if scope == "projection" {
      fields["digest"] = Json::string(
        "sha256:" + @crypto.bytes_to_hex_string(@crypto.sha256(jars[scope])),
      )
    }
    if kind == "maven-selected" {
      fields["root"] = Json::string("META-INF/smithy")
      fields["paths"] = Json::array([Json::string(file)])
    }
    Json::object(fields)
  }
  value.stringify()
}

///|
async fn repository_builds(
  dir : String,
  executable : String,
  prefix : Array[String],
  target : String,
  base : String,
  jars : Map[String, Bytes],
  requests : Array[String],
  denied : Ref[Bool],
) -> Unit {
  let supported = target == "native" || target == "js"
  let initial = requests.length()
  for kind in ["npm-unscoped", "npm-scoped", "maven", "maven-selected"] {
    let stem = target + "-" + kind
    for remote in [false, true] {
      let label = if remote { "remote" } else { "local" }
      fn selected(scope : String) -> String {
        if remote {
          repository_selection(base, kind, scope, jars)
        } else if kind.has_prefix("npm") {
          let root = match scope {
            "sources" => "models"
            "imports" => "imports"
            _ => "projection"
          }
          selection("path", "npm-models.tgz", "package/" + root, "")
        } else {
          Json::string("maven-" + scope + ".jar").stringify()
        }
      }
      let config = "{\"version\":\"2.0\",\"sources\":[" +
        selected("sources") +
        "],\"imports\":[" +
        selected("imports") +
        "],\"projections\":{\"extra\":{\"imports\":[" +
        selected("projection") +
        "]}},\"outputDirectory\":\"" +
        stem +
        "-" +
        label +
        "\"}"
      let config_path = dir + "/" + stem + "-" + label + ".json"
      @fs.write_file(config_path, config)
      let args = prefix +
        [
          "build",
          "--config",
          config_path,
          "--cache-dir",
          "repository-cache-" + target,
        ]
      let output = command(
        dir,
        executable,
        args,
        expected=if remote && !supported { 1 } else { 0 },
      )
      if remote && !supported {
        assert_true(output.contains("unsupported-transport"), msg=output)
      }
      if remote && supported {
        let before = snapshot(dir + "/" + stem + "-remote")
        let request_count = requests.length()
        command(dir, executable, args) |> ignore
        assert_eq(requests.length(), request_count)
        denied.val = true
        command(
          dir,
          executable,
          args + ["--offline"],
          extra_env=if target == "native" { { "PATH": "" } } else { Map([]) },
        )
        |> ignore
        denied.val = false
        assert_eq(snapshot(dir + "/" + stem + "-remote"), before)
        assert_eq(requests.length(), request_count)
        for projection in ["source", "extra"] {
          let model = @fs.read_file(
            dir + "/" + stem + "-remote/" + projection + "/model/model.json",
          ).text()
          assert_eq(
            model,
            @fs.read_file(
              dir + "/" + stem + "-local/" + projection + "/model/model.json",
            ).text(),
          )
          assert_eq(
            model,
            @fs.read_file(
              dir + "/" + target + "-local/" + projection + "/model/model.json",
            ).text(),
          )
          assert_eq(model.contains("example#Extra"), projection == "extra")
          assert_false(model.contains("Unlisted"))
        }
        let miss = command(
          dir,
          executable,
          prefix +
          [
            "build",
            "--config",
            config_path,
            "--offline",
            "--cache-dir",
            "repository-missing-" + target,
          ],
          expected=1,
        )
        assert_true(miss.contains("offline-miss"), msg=miss)
      }
      assert_false(@fs.exists(dir + "/PACKAGE_HOOK_RAN"))
    }
  }
  // Two redirected metadata requests share one redirected tarball; three Maven
  // JARs need two sidecars, while the third uses its caller-provided digest.
  assert_eq(requests.length() - initial, if supported { 11 } else { 0 })
  if supported {
    for kind in ["npm-scoped", "maven"] {
      let fields = repository_selection(base, kind, "sources", jars)
      let config = "{\"version\":\"2.0\",\"sources\":[{\"digest\":\"sha256:" +
        "0".repeat(64) +
        "\"," +
        fields[1:].to_owned() +
        "]}"
      let config_path = dir + "/" + target + "-" + kind + "-mismatch.json"
      @fs.write_file(config_path, config)
      let output = command(
        dir,
        executable,
        prefix +
        [
          "build",
          "--config",
          config_path,
          "--offline",
          "--cache-dir",
          "repository-cache-" + target,
        ],
        expected=1,
      )
      assert_true(output.contains("integrity-failure"), msg=output)
      if kind.has_prefix("npm") {
        assert_true(
          output.contains(base + "/npm/%40fixture%2Fmodels/1.2.3"),
          msg=output,
        )
        assert_true(
          output.contains(base + "/npm/metadata/scoped.json"),
          msg=output,
        )
      }
      assert_true(
        output.contains(
          if kind.has_prefix("npm") {
            "@fixture/models@1.2.3"
          } else {
            "org.example:models:1.0.0:sources"
          },
        ),
        msg=output,
      )
    }
  }
}

///|
async fn credential_builds(
  dir : String,
  executable : String,
  prefix : Array[String],
  target : String,
  base : String,
  redirect_base : String,
  jars : Map[String, Bytes],
  digest : String,
  requests : Array[String],
  denied : Ref[Bool],
) -> Unit {
  let supported = target == "native" || target == "js"
  for kind in ["npm-scoped", "maven", "github"] {
    let stem = target + "-private-" + kind
    fn selected(scope : String) -> Json raise {
      let root = match scope {
        "sources" => "models"
        "imports" => "imports"
        _ => "projection"
      }
      @json.parse(
        if kind == "github" {
          github_selection(base + "/private/github", "models.zip", root, digest)
        } else {
          repository_selection(base + "/private", kind, scope, jars)
        },
      )
    }
    let binding : Json = if kind == "maven" {
      {
        "origin": base,
        "usernameEnv": "FIXTURE_USER",
        "passwordEnv": "FIXTURE_PASSWORD",
      }
    } else {
      { "origin": base, "bearerTokenEnv": "FIXTURE_TOKEN" }
    }
    let config : Json = {
      "version": "2.0",
      "sources": [selected("sources")],
      "imports": [selected("imports")],
      "projections": { "extra": { "imports": [selected("projection")] } },
      "credentials": [
        binding,
        { "origin": redirect_base, "bearerTokenEnv": "REDIRECT_TOKEN" },
      ],
      "outputDirectory": stem,
    }
    let config_path = dir + "/" + stem + ".json"
    @fs.write_file(config_path, config.stringify())
    let environment = {
      "FIXTURE_TOKEN": "fixture-token",
      "FIXTURE_USER": "fixtures",
      "FIXTURE_PASSWORD": "password",
      "REDIRECT_TOKEN": "must-not-be-forwarded",
    }
    let args = prefix +
      ["build", "--config", config_path, "--cache-dir", stem + "-cache"]
    let output = command(
      dir,
      executable,
      args,
      extra_env=environment,
      expected=if supported { 0 } else { 1 },
    )
    if !supported {
      assert_true(output.contains("unsupported-transport"), msg=output)
      continue
    }
    let before = snapshot(dir + "/" + stem)
    let count = requests.length()
    command(dir, executable, args, extra_env=environment) |> ignore
    assert_eq(requests.length(), count)
    denied.val = true
    command(dir, executable, args + ["--offline"], extra_env=environment)
    |> ignore
    denied.val = false
    assert_eq(requests.length(), count)
    assert_eq(snapshot(dir + "/" + stem), before)
    for projection in ["source", "extra"] {
      assert_eq(
        @fs.read_file(dir + "/" + stem + "/" + projection + "/model/model.json").text(),
        @fs.read_file(
          dir + "/" + target + "-local/" + projection + "/model/model.json",
        ).text(),
      )
    }
    guard config is Object(anonymous_fields) else { abort("fixture config") }
    ignore(anonymous_fields.remove("credentials"))
    let anonymous_path = dir + "/" + stem + "-anonymous.json"
    @fs.write_file(anonymous_path, Json::object(anonymous_fields).stringify())
    let missing = command(
      dir,
      executable,
      prefix +
      ["build", "--config", anonymous_path, "--cache-dir", stem + "-cache"],
      expected=1,
    )
    assert_true(
      missing.contains("authentication-required") &&
      missing.contains("HTTP status 401"),
      msg=missing,
    )
    // Changing credentials cannot reuse the warmed cache, even offline.
    for mode in ["missing", "invalid", "insufficient", "changed-offline"] {
      let failed_env = environment.copy()
      if kind == "maven" {
        failed_env["FIXTURE_PASSWORD"] = if mode == "missing" {
          ""
        } else if mode == "insufficient" {
          "insufficient"
        } else {
          "invalid"
        }
      } else {
        failed_env["FIXTURE_TOKEN"] = if mode == "missing" {
          ""
        } else if mode == "insufficient" {
          "insufficient"
        } else {
          "invalid"
        }
      }
      let failed = command(
        dir,
        executable,
        args + (if mode == "changed-offline" { ["--offline"] } else { [] }),
        extra_env=failed_env,
        expected=1,
      )
      assert_true(
        failed.contains(
          if mode == "missing" {
            "credential environment variable"
          } else if mode == "changed-offline" {
            "offline-miss"
          } else {
            "authentication-required"
          },
        ),
        msg=failed,
      )
      if mode == "insufficient" {
        assert_true(failed.contains("HTTP status 403"), msg=failed)
      }
      for
        secret in [
          "fixture-token", "password", "must-not-be-forwarded", "Bearer insufficient",
          "Basic Zml4dHVyZXM6",
        ] {
        assert_false(failed.contains(secret), msg=failed)
      }
    }
    // Generated files and every cache entry must exclude supplied secrets.
    for folder in [stem] {
      for name, text in snapshot(dir + "/" + folder) {
        for
          secret in [
            "fixture-token", "must-not-be-forwarded", "Zml4dHVyZXM6cGFzc3dvcmQ=",
          ] {
          assert_false(name.contains(secret) || text.contains(secret), msg=name)
        }
      }
    }
    for name in @fs.readdir(dir + "/" + stem + "-cache") {
      let data = @fs.read_file(dir + "/" + stem + "-cache/" + name).binary()
      for
        secret in [
          "fixture-token", "must-not-be-forwarded", "Zml4dHVyZXM6cGFzc3dvcmQ=",
        ] {
        assert_false(
          name.contains(secret) || data.find(@utf8.encode(secret)[:]) is Some(_),
          msg=name,
        )
      }
    }
    if @env.get_env_var("OS") != Some("Windows_NT") {
      command(dir, "node", [
        "-e",
        "const fs=require('node:fs');const dir=process.argv[1];for(const name of fs.readdirSync(dir)){if(fs.statSync(dir+'/'+name).mode & 0o077)process.exit(1)}",
        stem + "-cache",
      ])
      |> ignore
    }
    command(dir, executable, prefix + ["clean", "--config", config_path], extra_env={
      "FIXTURE_TOKEN": "",
      "FIXTURE_USER": "",
      "FIXTURE_PASSWORD": "",
      "REDIRECT_TOKEN": "",
    })
    |> ignore
  }
}

///|
async fn exercise(root : String, targets : Array[String]) -> Unit {
  let dir = root + "/.dev/out/public-http"
  if @fs.exists(dir) {
    @fs.rmdir(dir, recursive=true)
  }
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  let zip = @zipc.Archive::empty()
  let mut tar = b""
  let mut npm_tar = b""
  let jars : Map[String, Bytes] = Map([])
  for
    (path, text) in [
      (
        "models/service.smithy", "$version: \"2\"\nnamespace example\nstructure Service { value: Shared }",
      ),
      (
        "imports/shared.smithy", "$version: \"2\"\nnamespace example\nstring Shared",
      ),
      (
        "projection/extra.smithy", "$version: \"2\"\nnamespace example\nstring Extra",
      ),
      (
        "broken/bad.smithy", "$version: \"2\"\nnamespace example\nstructure Bad { value: Missing }",
      ),
    ] {
    tar = tar + tar_member(path, @utf8.encode(text))
    npm_tar = npm_tar + tar_member("package/" + path, @utf8.encode(text))
    if !path.has_prefix("broken/") {
      let parts = path.split("/").to_array()
      let scope = match parts[0] {
        "models" => "sources"
        "imports" => "imports"
        _ => "projection"
      }
      let name = parts[1].to_owned()
      let jar = @zipc.Archive::empty()
      for
        (entry, content) in [
          ("META-INF/smithy/manifest", name + "\n"),
          ("META-INF/smithy/" + name, text),
          (
            "META-INF/smithy/unlisted.smithy", "$version: \"2\"\nnamespace example\nstring Unlisted",
          ),
        ] {
        ignore(
          jar.add(
            @zipc.Member::make(
              entry,
              @zipc.File(@zipc.File::stored_from_bytes(@utf8.encode(content))),
            ),
          ),
        )
      }
      jars[scope] = jar.to_bytes()
      @fs.write_file(dir + "/maven-" + scope + ".jar", jars[scope])
    }
    ignore(
      zip.add(
        @zipc.Member::make(
          path,
          @zipc.File(@zipc.File::stored_from_bytes(@utf8.encode(text))),
        ),
      ),
    )
  }
  npm_tar = npm_tar +
    tar_member(
      "package/package.json", b"{\"name\":\"fixture\",\"version\":\"1.2.3\",\"scripts\":{\"install\":\"node hook.js\"}}",
    ) +
    tar_member(
      "package/hook.js", b"require('fs').writeFileSync('PACKAGE_HOOK_RAN','bad'); throw new Error('package hooks must never run');",
    )
  let npm_tgz = @gzip.gzip_compress(npm_tar + Bytes::make(1024, 0))
  @fs.write_file(dir + "/npm-models.tgz", npm_tgz)
  let tgz = @gzip.gzip_compress(tar + Bytes::make(1024, 0))
  @fs.write_file(dir + "/models.tgz", tgz)
  let bytes = zip.to_bytes()
  let digest = "sha256:" + @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
  @fs.write_file(dir + "/models.zip", bytes)
  let server = @http.Server(@socket.Addr::parse("127.0.0.1:0"))
  defer server.close()
  let base = "http://\{server.addr}"
  let redirect_server = @http.Server(@socket.Addr::parse("127.0.0.1:0"))
  defer redirect_server.close()
  let redirect_base = "http://\{redirect_server.addr}"
  let leaked_authorization = Ref(false)
  let requests : Array[String] = []
  let denied = Ref(false)
  @async.with_task_group(group => {
    group.spawn_bg(no_wait=true, () => {
      redirect_server.run_forever(allow_failure=true, (request, _, conn) => {
        defer conn.close()
        if request.headers.get("authorization") is Some(_) {
          leaked_authorization.val = true
        }
        conn.send_response(200, "Redirected asset")
        conn.write(bytes)
        conn.end_response()
      })
    })
    group.spawn_bg(no_wait=true, () => {
      server.run_forever(allow_failure=true, (request, _, conn) => {
        defer conn.close()
        let wire_path = request.path
        let private = wire_path.has_prefix("/private/")
        let path = if wire_path.has_prefix("/private/github/") {
          wire_path[15:].to_owned()
        } else if private {
          wire_path[8:].to_owned()
        } else {
          wire_path
        }
        requests.push(wire_path)
        if denied.val {
          conn.send_response(503, "Network disabled")
          conn.end_response()
          return
        }
        if private {
          let auth = request.headers.get("authorization")
          let expected = if path.has_prefix("/maven/") {
            "Basic Zml4dHVyZXM6cGFzc3dvcmQ="
          } else {
            "Bearer fixture-token"
          }
          let insufficient = auth == Some("Bearer insufficient") ||
            auth == Some("Basic Zml4dHVyZXM6aW5zdWZmaWNpZW50")
          if auth != Some(expected) {
            conn.send_response(
              if insufficient {
                403
              } else {
                401
              },
              "Credential rejected",
            )
            conn.end_response()
            return
          }
          if path == "/repos/owner/models/releases/assets/42" {
            if request.headers.get("accept") != Some("application/octet-stream") {
              conn.send_response(403, "Asset media type required")
            } else {
              conn.send_response(302, "Asset download", extra_headers={
                "Location": redirect_base + "/asset.zip",
              })
            }
            conn.end_response()
            return
          }
        }
        if path.has_prefix("/maven/") {
          let scope = if path.contains("-sources.jar") {
            "sources"
          } else if path.contains("-imports.jar") {
            "imports"
          } else {
            "projection"
          }
          let expected = "/maven/org/example/models/1.0.0/models-1.0.0-" +
            scope +
            ".jar"
          let body = jars[scope]
          if path == expected {
            conn.send_response(200, "JAR")
            conn.write(body)
          } else if path == expected + ".sha1" {
            conn.send_response(200, "Checksum")
            conn.write(
              @utf8.encode(@crypto.bytes_to_hex_string(@crypto.sha1(body))),
            )
          } else if path == expected + ".sha256" {
            conn.send_response(200, "Checksum")
            conn.write(
              @utf8.encode(@crypto.bytes_to_hex_string(@crypto.sha256(body))),
            )
          } else {
            conn.send_response(404, "Missing artifact")
          }
          conn.end_response()
          return
        }
        if path == "/npm/models/1.2.3" ||
          path == "/npm/%40fixture%2Fmodels/1.2.3" {
          let destination = if path.contains("%40") {
            "/npm/metadata/scoped.json"
          } else {
            "/npm/metadata/unscoped.json"
          }
          conn.send_response(302, "npm metadata redirect", extra_headers={
            "Location": (if private { "/private" } else { "" }) + destination,
          })
          conn.end_response()
          return
        }
        if path == "/npm/metadata/scoped.json" ||
          path == "/npm/metadata/unscoped.json" {
          let name = if path == "/npm/metadata/scoped.json" {
            "@fixture/models"
          } else {
            "models"
          }
          let metadata : Json = {
            "name": name,
            "version": "1.2.3",
            "dist": {
              "tarball": base +
              (if private { "/private" } else { "" }) +
              "/npm/archive",
              "integrity": "sha512-" +
              @base64.encode(
                Bytes::from_array(@crypto.sha512(npm_tgz).iter().to_array())[:],
              ),
            },
            "scripts": { "install": "node hook.js" },
          }
          conn.send_response(200, "npm metadata")
          conn.write(@utf8.encode(metadata.stringify()))
          conn.end_response()
          return
        }
        if path.has_prefix("/npm/") && path != "/npm/archive" {
          conn.send_response(404, "Missing package/version")
          conn.end_response()
          return
        }
        if path == "/disconnect" {
          return
        }
        if path == "/slow" {
          @async.sleep(2000)
        }
        if path == "/slow-redirect" || path == "/slow-redirect-final" {
          @async.sleep(650)
        }
        let redirect = match path {
          "/slow-redirect" => Some("/slow-redirect-final")
          "/relative" => Some("/bytes")
          "/fragment" => Some("/bytes#download")
          "/absolute" => Some(base + "/bytes")
          "/archive" => Some("/models.zip?version=1")
          "/github/models.zip" => Some("/models.zip?github=1")
          "/github/models.tgz" => Some("/models.tgz")
          "/npm/archive" => Some("/npm-models.tgz")
          "/loop" => Some("/loop")
          "/file-redirect" => Some("file:///etc/passwd")
          "/credential-redirect" =>
            Some(
              base.replace(old="http://", new="http://user:password@") +
              "/bytes",
            )
          _ => None
        }
        if redirect is Some(location) {
          conn.send_response(302, "Redirect", extra_headers={
            "Location": location,
          })
        } else {
          let status = match path {
            "/missing" => 404
            "/auth" => 401
            "/forbidden" => 403
            "/failure" => 500
            _ => 200
          }
          if path == "/large" {
            conn.send_response(status, "Fixture", extra_headers={
              "Content-Length": "32768",
            })
            conn.write(Bytes::make(32768, 65))
          } else if path == "/stream" {
            conn.send_response(status, "Fixture")
            for _ in 0..<32 {
              conn.write(Bytes::make(1024, 65))
              conn.flush()
            }
          } else {
            conn.send_response(status, "Fixture")
            if path == "/repos/owner/models/releases/tags/v1-fixtures" {
              conn.write(
                b"{\"id\":7,\"tag_name\":\"v1-fixtures\",\"draft\":false}",
              )
            } else if path ==
              "/repos/owner/models/releases/7/assets?per_page=100&page=1" {
              let assets : Json = [
                {
                  "id": 42,
                  "name": "models.zip",
                  "state": "uploaded",
                  "browser_download_url": base + "/github/models.zip",
                  "digest": digest,
                },
                {
                  "id": 43,
                  "name": "models.tgz",
                  "state": "uploaded",
                  "browser_download_url": base + "/github/models.tgz",
                },
              ]
              conn.write(@utf8.encode(assets.stringify()))
            } else if path == "/npm-models.tgz" {
              conn.write(npm_tgz)
            } else if path == "/models.tgz" {
              conn.write(tgz)
            } else if path.has_prefix("/models.zip") {
              conn.write(bytes)
            } else {
              conn.write(b"fixture\n200\nhttps://fake.invalid/a\x00")
            }
          }
        }
        conn.end_response()
      })
    })
    for target in targets {
      let supported = target == "native" || target == "js"
      command(
        root,
        "moon",
        [
          "test", "pkgs/artifact-resources/http", "--target", target, "--deny-warn",
        ],
        extra_env=if supported {
          { "SMITHY_HTTP_FIXTURE": base }
        } else {
          { "SMITHY_UNSUPPORTED_HTTP_TEST": "1" }
        },
      )
      |> ignore
      command(root, "moon", [
        "build", "apps/smithy", "--target", target, "--release", "--deny-warn",
      ])
      |> ignore
      let stem = root +
        "/_build/\{target}/release/build/moonrockz/smithy-cli/smithy-cli"
      if target == "native" && @env.get_env_var("OS") == Some("Windows_NT") {
        // This executable must never be mistaken for curl by Windows lookup.
        @fs.write_file(dir + "/curl.exe", @fs.read_file(stem + ".exe"))
      }
      let executable = if target == "native" {
        stem + ".exe"
      } else if target == "js" {
        "node"
      } else {
        "moonrun"
      }
      let prefix = if target == "native" {
        []
      } else if target == "js" {
        [stem + ".js"]
      } else {
        [stem + ".wasm", "--"]
      }
      let initial_requests = requests.length()
      for remote in [false, true] {
        let field = if remote { "url" } else { "path" }
        let location = if remote { base + "/archive" } else { "models.zip" }
        let label = if remote { "remote" } else { "local" }
        let config = "{\"version\":\"2.0\",\"sources\":[" +
          selection(field, location, "models", digest) +
          "],\"imports\":[" +
          selection(field, location, "imports", digest) +
          "],\"projections\":{\"extra\":{\"imports\":[" +
          selection(field, location, "projection", digest) +
          "]}},\"outputDirectory\":\"\{target}-\{label}\"}"
        let config_path = dir + "/\{target}-\{label}.json"
        @fs.write_file(config_path, config)
        let args = prefix +
          ["build", "--config", config_path, "--cache-dir", "cache-" + target]
        let output = command(
          dir,
          executable,
          args,
          expected=if remote && !supported { 1 } else { 0 },
        )
        if remote && !supported {
          assert_true(output.contains("unsupported-transport"))
        }
      }
      if supported {
        // Three input positions share one acquisition, including the redirect.
        assert_eq(requests.length() - initial_requests, 2)
        let config_path = dir + "/\{target}-remote.json"
        let args = prefix +
          ["build", "--config", config_path, "--cache-dir", "cache-" + target]
        let before = snapshot(dir + "/\{target}-remote")
        let request_count = requests.length()
        command(dir, executable, args) |> ignore
        assert_eq(requests.length(), request_count)
        denied.val = true
        command(
          dir,
          executable,
          args + ["--offline"],
          extra_env=if target == "native" { { "PATH": "" } } else { Map([]) },
        )
        |> ignore
        assert_eq(snapshot(dir + "/\{target}-remote"), before)
        assert_eq(requests.length(), request_count)
        let miss = command(
          dir,
          executable,
          prefix +
          [
            "build",
            "--config",
            config_path,
            "--offline",
            "--cache-dir",
            "missing-" + target,
          ],
          expected=1,
        )
        assert_true(miss.contains("offline-miss"), msg=miss)
        let cache_dir = dir + "/cache-" + target
        let content_path = cache_dir + "/sha256-" + digest[7:].to_owned()
        // An orphan temporary write cannot turn a missing mapping into a hit.
        @fs.mkdir(dir + "/interrupted-" + target, recursive=true)
        @fs.write_file(
          dir + "/interrupted-" + target + "/sha256-partial.tmp",
          b"partial",
        )
        let interrupted = command(
          dir,
          executable,
          prefix +
          [
            "build",
            "--config",
            config_path,
            "--offline",
            "--cache-dir",
            "interrupted-" + target,
          ],
          expected=1,
        )
        assert_true(interrupted.contains("offline-miss"), msg=interrupted)
        @fs.write_file(content_path, b"corrupted")
        for offline in [false, true] {
          let corrupt = command(
            dir,
            executable,
            args + (if offline { ["--offline"] } else { [] }),
            expected=1,
          )
          assert_true(corrupt.contains("cache-corrupt"), msg=corrupt)
        }
        @fs.remove(content_path)
        let absent = command(dir, executable, args + ["--offline"], expected=1)
        assert_true(absent.contains("cache-corrupt"), msg=absent)
        @fs.write_file(content_path, bytes)
        let metadata_path = cache_dir +
          "/" +
          @fs.readdir(cache_dir).filter(name => name.has_prefix("ref-v1-"))[0]
        let metadata = @fs.read_file(metadata_path)
        @fs.write_file(metadata_path, b"partial metadata")
        let bad_metadata = command(
          dir,
          executable,
          args + ["--offline"],
          expected=1,
        )
        assert_true(bad_metadata.contains("cache-corrupt"), msg=bad_metadata)
        @fs.write_file(metadata_path, metadata)
        for
          cache_path in [
            "",
            "cache:*",
            "cache/NUL",
            "cache/trailing.",
            target + "-remote",
          ] {
          let invalid_path = command(
            dir,
            executable,
            prefix +
            ["build", "--config", config_path, "--cache-dir", cache_path],
            expected=2,
          )
          assert_true(invalid_path.contains("cache"), msg=invalid_path)
        }
        command(dir, executable, prefix + ["clean", "--config", config_path])
        |> ignore
        assert_true(@fs.exists(content_path))
        command(dir, executable, args + ["--offline"]) |> ignore
        assert_eq(snapshot(dir + "/\{target}-remote"), before)
        // Configuration settings use the same cache and policy as CLI flags.
        let config_text = @fs.read_file(config_path).text()
        @fs.write_file(
          config_path,
          @utf8.encode(
            "{\"offline\":true,\"cacheDirectory\":\"cache-" +
            target +
            "\"," +
            config_text[1:].to_owned(),
          ),
        )
        command(dir, executable, prefix + ["build", "--config", config_path])
        |> ignore
        @fs.write_file(config_path, @utf8.encode(config_text))
        assert_eq(requests.length(), request_count)
        denied.val = false
        for projection in ["source", "extra"] {
          let local_model = @fs.read_file(
            dir + "/\{target}-local/\{projection}/model/model.json",
          ).text()
          let remote = @fs.read_file(
            dir + "/\{target}-remote/\{projection}/model/model.json",
          ).text()
          assert_eq(remote, local_model)
          assert_eq(remote.contains("example#Extra"), projection == "extra")
        }
        assert_eq(
          @fs.read_file(dir + "/\{target}-remote/source/sources/service.smithy").text(),
          @fs.read_file(dir + "/\{target}-local/source/sources/service.smithy").text(),
        )
        if target == "native" {
          command(
            dir,
            executable,
            prefix + ["build", "--config", dir + "/native-local.json"],
            extra_env={ "PATH": "" },
          )
          |> ignore
          if @env.get_env_var("OS") != Some("Windows_NT") {
            let missing_curl = command(
              dir,
              executable,
              prefix +
              [
                "build",
                "--config",
                dir + "/native-remote.json",
                "--cache-dir",
                "cold-missing-curl",
              ],
              extra_env={ "PATH": "" },
              expected=1,
            )
            assert_true(
              missing_curl.contains("transport-failure"),
              msg=missing_curl,
            )
          }
        }
        @fs.write_file(
          dir + "/diagnostic.json",
          "{\"version\":\"2.0\",\"sources\":[" +
          selection("url", base + "/archive", "broken", digest) +
          "]}",
        )
        let diagnostic = command(
          dir,
          executable,
          prefix + ["build", "--config", dir + "/diagnostic.json"],
          expected=1,
        )
        assert_true(diagnostic.contains(base + "/archive"), msg=diagnostic)
        assert_true(
          diagnostic.contains(base + "/models.zip?version=1"),
          msg=diagnostic,
        )
        assert_true(diagnostic.contains(digest), msg=diagnostic)
        assert_true(diagnostic.contains("!/broken/bad.smithy"), msg=diagnostic)
        let offline_diagnostic = command(
          dir,
          executable,
          prefix + ["build", "--config", dir + "/diagnostic.json", "--offline"],
          expected=1,
        )
        assert_eq(offline_diagnostic, diagnostic)
        for
          (endpoint, code) in [
            ("missing", "missing-asset"),
            ("auth", "authentication-required"),
            ("failure", "http-status"),
            ("disconnect", "transport-failure"),
            ("models.zip", "integrity-failure"),
          ] {
          let config = "{\"version\":\"2.0\",\"sources\":[" +
            selection(
              "url",
              base + "/" + endpoint,
              "models",
              "sha256:" + "0".repeat(64),
            ) +
            "]}"
          @fs.write_file(dir + "/error.json", config)
          let output = command(
            dir,
            executable,
            prefix + ["build", "--config", dir + "/error.json"],
            expected=1,
          )
          assert_true(output.contains(code), msg=output)
        }
      }
      github_builds(
        dir,
        executable,
        prefix,
        target,
        base,
        {
          "models.zip": digest,
          "models.tgz": "sha256:" +
          @crypto.bytes_to_hex_string(@crypto.sha256(tgz)),
        },
        requests,
        denied,
      )
      repository_builds(
        dir, executable, prefix, target, base, jars, requests, denied,
      )
      credential_builds(
        dir, executable, prefix, target, base, redirect_base, jars, digest, requests,
        denied,
      )
      assert_false(
        leaked_authorization.val,
        msg="Authorization crossed redirect origin",
      )
      println(
        "Public and authenticated HTTP, GitHub, npm and Maven fixtures passed: \{target}",
      )
    }
  })
}

///|
async fn main {
  let args = @env.args()[1:].to_owned()
  exercise(
    @fs.realpath("."),
    if args.is_empty() {
      ["native", "js", "wasm", "wasm-gc"]
    } else {
      args
    },
  )
}

///|
async test "controlled public HTTP acquisition and CLI builds" {
  exercise(@fs.realpath(".."), ["native", "js", "wasm", "wasm-gc"])
}
