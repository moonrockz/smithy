  #|    Path expected = corpus.resolve("events.json");
  #|    if (check) Node.assertEquals(actual, Node.parse(Files.readString(expected)));
  #|    else Files.writeString(expected, Node.prettyPrintJson(actual) + "\n");
  #|    System.out.println("Reference verified " + inputs.size() + " model pairs and " + mutations.size() + " mutations");
  #|  }
  #|  @SuppressWarnings("unchecked")
  #|  private static void checkGoldens(Path root, boolean expectFailure) throws Exception {
