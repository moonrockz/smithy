  #|        ObjectNode mutation = entry.expectObjectNode();
  #|        ShapeId shapeId = ShapeId.from(mutation.expectStringMember("shape").getValue());
  #|        ShapeId traitId = ShapeId.from(mutation.expectStringMember("trait").getValue());
  #|        AbstractShapeBuilder<?, ?> builder = Shape.shapeToBuilder(newModel.expectShape(shapeId));
  #|        if (mutation.containsMember("value")) {
  #|          Node value = mutation.expectMember("value");
  #|          builder.addTrait(TraitFactory.createServiceFactory().createTrait(traitId, shapeId, value)
  #|              .orElseGet(() -> new DynamicTrait(traitId, value)));
  #|        } else builder.removeTrait(traitId);
  #|        newModel = ModelTransformer.create().replaceShapes(newModel, List.of(builder.build()));
  #|      }
  #|      cases.withValue(compare(oldModel, newModel).merge(test));
  #|      System.out.println("verified mutation: " + test.expectStringMember("id").getValue());
  #|    }
  #|    ObjectNode actual = ObjectNode.builder()
  #|      .withMember("referenceSha", "30bdab593f0c2cdf96036782cc3ce15c43a711ef")
