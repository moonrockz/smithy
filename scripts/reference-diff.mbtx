  #|      if (!Files.isRegularFile(newPath)) throw new IllegalStateException("Missing new model: " + oldPath);
  #|      Model oldModel = Model.assembler().addImport(oldPath).assemble().unwrap();
  #|      Model newModel = Model.assembler().addImport(newPath).assemble().unwrap();
  #|      String oldName = corpus.relativize(oldPath).toString().replace('\\', '/');
  #|      String newName = corpus.relativize(newPath).toString().replace('\\', '/');
  #|      cases.withValue(compare(oldModel, newModel).withMember("old", oldName).withMember("new", newName));
  #|      System.out.println("verified: " + oldName);
  #|    }
  #|    ArrayNode mutations = Node.parse(Files.readString(corpus.resolve("mutations.json"))).expectArrayNode();
  #|    for (Node node : mutations) {
  #|      ObjectNode test = node.expectObjectNode();
