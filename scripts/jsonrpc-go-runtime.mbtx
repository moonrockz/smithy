///|
/// Embed the Go runtime source files in the portable Go generator.
/// Run without arguments to write the copy. Use --check to check for drift.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
fn render_runtime(files : Array[(String, String)]) -> String {
  let ordered = files.copy()
  ordered.sort_by((a, b) => a.0.lexical_compare(b.0))
  let out = StringBuilder()
  out.write_string(
    "// Generated by scripts/jsonrpc-go-runtime.mbtx. Do not edit.\n\n///|\nfn runtime_files() -> Map[String, String] {\n  {\n",
  )
  for file in ordered {
    out.write_string(
      "    " +
      Json::string(file.0).stringify() +
      ": " +
      Json::string(file.1).stringify() +
      ",\n",
    )
  }
  out.write_string("  }\n}\n")
  out.to_string()
}

///|
test "runtime source keeps exact source text and file paths" {
  let rendered = render_runtime([
    ("exact.go", "package jsonrpc\n// $T and \\\"\n"),
  ])
  assert_true(rendered.contains("\"exact.go\""))
  assert_true(rendered.contains("package jsonrpc\\n// $T and"))
}

///|
async fn main {
  let files : Array[(String, String)] = []
  for name in @fs.readdir("runtimes/go", sort=true) {
    if (name.has_suffix(".go") && !name.has_suffix("_test.go")) ||
      name == "go.sum" ||
      name == "go.mod" {
      files.push((name, @fs.read_file("runtimes/go/" + name).text()))
    }
  }
  if files.is_empty() {
    eprintln("I found no Go runtime source files in runtimes/go.")
    @sys.exit(1)
  }
  let path = "pkgs/smithy-codegen-go/runtime_embedded.mbt"
  let content = render_runtime(files)
  if @env.args().contains("--check") {
    if !@fs.exists(path) || @fs.read_file(path).text() != content {
      eprintln(
        "I found a Go runtime copy that differs from runtimes/go. Run mise run jsonrpc:go:runtime.",
      )
      @sys.exit(1)
    }
  } else {
    @fs.write_file(path, content)
  }
}
