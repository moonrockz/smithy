///|
/// Vendor and embed the official JMESPath compliance suite for offline tests.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn fetch(url : String) -> String {
  let (code, out, err) = @process.collect_output("curl", ["-fsSL", "--retry", "3", url])
  if code != 0 { eprintln(err.text()); @sys.exit(1) }
  out.text()
}

///|
async fn main {
  let args = @env.args()
  let ref_ = if args.length() > 1 { args[1] } else { "master" }
  let commit = @json.parse(fetch("https://api.github.com/repos/jmespath/jmespath.test/commits/\{ref_}"))
  guard commit is { "sha": String(sha), .. } else { eprintln("No JMESPath commit SHA in GitHub response"); @sys.exit(1); return }
  let listing = @json.parse(fetch("https://api.github.com/repos/jmespath/jmespath.test/git/trees/\{sha}?recursive=1"))
  guard listing is { "tree": Array(entries), "truncated": False, .. } else { eprintln("Incomplete JMESPath file listing"); @sys.exit(1); return }
  let paths : Array[String] = []
  for entry in entries {
    if entry is { "path": String(path), "type": String("blob"), .. } && path.has_prefix("tests/") && path.has_suffix(".json") { paths.push(path) }
  }
  paths.sort()
  if paths.is_empty() { eprintln("No JMESPath compliance files"); @sys.exit(1) }
  @fs.mkdir("pkgs/jmespath/compliance", recursive=true)
  let out = StringBuilder()
  out.write_string("// Generated by scripts/vendor-jmespath.mbtx from jmespath/jmespath.test at \{sha}.\n\n///|\nfn compliance_corpus() -> Array[(String, String)] {\n  [\n")
  for path in paths {
    let text = fetch("https://raw.githubusercontent.com/jmespath/jmespath.test/\{sha}/\{path}")
    @json.parse(text) |> ignore
    let name = path[6:].to_owned()
    @fs.write_file("pkgs/jmespath/compliance/\{name}", text)
    out.write_string("    (\"\{name}\",\n      (\n")
    for line in text.split("\n") { out.write_string("        #|\{line}\n") }
    out.write_string("      ),\n    ),\n")
  }
  out.write_string("  ]\n}\n")
  @fs.write_file("pkgs/jmespath/compliance_data_test.mbt", out.to_string())
  @fs.write_file("pkgs/jmespath/COMPLIANCE_SHA", sha + "\n")
  let code = @process.run("moon", ["fmt"])
  if code != 0 { @sys.exit(code) }
  println("Vendored \{paths.length()} JMESPath compliance files at \{sha}")
}
