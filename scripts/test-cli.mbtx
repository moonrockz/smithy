  assert_true(@fs.read_file("\{dir}/jar-projection-output/withJar/model/model.json").text().contains("foo.baz#A"))
  @fs.write_file("\{dir}/broken.jar", b"not a ZIP")
  @fs.write_file("\{dir}/broken-jar.json", "{\"version\":\"2.0\",\"sources\":[\"broken.jar\"],\"outputDirectory\":\"broken-jar-output\"}")
  let (archive_out, archive_err) = runner.command(["build", "--config", "broken-jar.json"], 1)
  // moonrun's wasm-gc print host routes eprintln through stdout.
