  @fs.write_file("\{dir}/jar-build.json", "{\"version\":\"2.0\",\"sources\":[\"jar-import.jar\"],\"imports\":[\"input.smithy\"],\"outputDirectory\":\"jar-output\"}")
  runner.command(["build", "--config", "jar-build.json"], 0) |> ignore
