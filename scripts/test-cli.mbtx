  @fs.write_file("\{dir}/jar-projection.json", "{\"version\":\"2.0\",\"sources\":[\"input.smithy\"],\"outputDirectory\":\"jar-projection-output\",\"projections\":{\"withJar\":{\"imports\":[\"jar-import.jar\"]}}}")
  runner.command(["build", "--config", "jar-projection.json"], 0) |> ignore
