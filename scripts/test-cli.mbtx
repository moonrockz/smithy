///|
/// Exercise the built CLI, including real stdin pipes, diagnostics, file writes
/// and conversions. Scratch inputs stay under .dev/out/cli-tests/.
/// Usage: mise run test:cli -- [native wasm js wasm-gc]
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonrockz/ion@0.6.0/text" @ion_text,
  "moonrockz/ion@0.6.0/binary" @ion_binary,
  "moonbit-community/zipc@0.2.2",
  "moonbit-community/flate@0.2.0/gzip",
  "moonbitlang/x@0.5.5/sys",
}

///|
struct Runner {
  target : String
  executable : String
  prefix : Array[String]
  dir : String
}

///|
async fn Runner::command(
  self : Runner,
  args : Array[String],
  expected : Int32,
  input? : String,
  input_bytes? : Bytes,
  extra_env~ : Map[String, String] = Map([]),
) -> (String, String) {
  let all = self.prefix.copy()
  all.append(args)
  let input = match input {
    Some(text) => Some(@utf8.encode(text))
    None => input_bytes
  }
  let (code, out, err) = match input {
    None => @process.collect_output(self.executable, all, cwd=self.dir, extra_env~)
    Some(text) =>
      @async.with_task_group(group => {
        let (stdin, writer) = @process.write_to_process()
        group.spawn_bg(() => {
          defer writer.close()
          writer.write(text)
        })
        @process.collect_output(self.executable, all, cwd=self.dir, stdin~, extra_env~)
      })
  }
  assert_eq(
    code,
    expected,
    msg="\{self.target}: \{args.join(" ")}\n\{err.text()}",
  )
  (out.text().replace_all(old="\r\n", new="\n"), err.text())
}

///|
/// Runs a POSIX shell command line in the scratch directory.
async fn Runner::command_in_shell(
  self : Runner,
  line : String,
  expected : Int32,
) -> (String, String) {
  let (code, out, err) = @process.collect_output("sh", ["-c", line], cwd=self.dir)
  assert_eq(code, expected, msg="\{self.target}: \{line}\n\{err.text()}")
  (out.text().replace_all(old="\r\n", new="\n"), err.text())
}

///|
fn jsonl_records(text : String) -> Array[Json] raise {
  if text.is_empty() {
    return []
  }
  assert_true(text.has_suffix("\n"))
  let records : Array[Json] = []
  for line in text[:text.length() - 1].split("\n") {
    assert_false(line.is_empty())
    assert_false(line.contains("\r"))
    records.push(@json.parse(line))
  }
  records
}

///|
/// Qualify encoding, status, sink behavior and diagnostics on the actual built
/// executable. Unit tests separately exercise every nullable field and failures
/// at write, flush and close boundaries.
async fn exercise_diff_jsonl(runner : Runner, root : String) -> Unit {
  let dir = runner.dir
  let base = ["diff", "--old", "input.smithy", "--new", "changed.smithy"]
  let (text, _) = runner.command(base, 1)
  let (explicit_text, _) = runner.command(base + ["--format=text"], 1)
  assert_eq(explicit_text, text)
  let (output, err) = runner.command(base + ["--format", "jsonl"], 1)
  assert_eq(err, "")
  let records = jsonl_records(output)
  assert_eq(records.length(), 1)
  guard records[0]
    is {
      "id": String(id),
      "severity": String(severity),
      "shape": String(shape),
      "message": String(message),
      "source": {
        "file": String(source_file),
        "path": "",
        "span": { "start": Number(start, ..), "length": Number(length, ..), .. },
        ..
      },
      ..
    } else {
    fail("unexpected JSONL record: \{output}")
  }
  assert_eq(id, "ChangedMemberTarget")
  assert_eq(severity, "ERROR")
  assert_eq(shape, "example#Example$name")
  assert_true(source_file.has_suffix("changed.smithy"))
  assert_true(start >= 0 && length > 0)
  assert_eq(text, "[\{severity}] \{shape}: \{message} | \{id}\n")
  let (equals_output, _) = runner.command(base + ["--format=jsonl"], 1)
  assert_eq(equals_output, output)
  let (file_out, file_err) = runner.command(
    base + ["--format=jsonl", "--output", "changes.jsonl"],
    1,
  )
  assert_eq(file_out, "")
  assert_eq(file_err, "")
  assert_eq(@fs.read_file("\{dir}/changes.jsonl").text(), output)
  // Unicode paths exercise native Windows UTF-8 to UTF-16 conversion too.
  runner.command(base + ["--format=jsonl", "--output", "変更🐟.jsonl"], 1)
  |> ignore
  assert_eq(@fs.read_file("\{dir}/変更🐟.jsonl").text(), output)
  let same = [
    "diff", "--old", "input.smithy", "--new", "input.smithy", "--format=jsonl",
  ]
  let (empty, empty_err) = runner.command(same, 0)
  assert_eq(empty, "")
  assert_eq(empty_err, "")
  let (empty_file, _) = runner.command(same + ["--output", "changes.jsonl"], 0)
  assert_eq(empty_file, "")
  assert_eq(@fs.read_file("\{dir}/changes.jsonl").text(), "")
  for flags in [["--format", "csv"], ["--format"], ["--format="], ["--stream"]] {
    @fs.write_file("\{dir}/preserved.jsonl", "keep me")
    let (out, err) = runner.command(
      [
        "diff", "--old", "missing.smithy", "--new", "missing.smithy", "--output",
        "preserved.jsonl",
      ] +
      flags,
      2,
    )
    assert_eq(out, "")
    assert_false(err.is_empty())
    assert_false(err.contains("invalid-archive"))
    assert_eq(@fs.read_file("\{dir}/preserved.jsonl").text(), "keep me")
  }
  @fs.write_file("\{dir}/preserved.jsonl", "keep me")
  let (invalid, invalid_err) = runner.command(
    [
      "diff", "--old", "broken.smithy", "--new", "input.smithy", "--format=jsonl",
      "--output", "preserved.jsonl",
    ],
    1,
  )
  assert_eq(invalid, "")
  assert_true(invalid_err.contains("Target.UnresolvedShape"))
  assert_eq(@fs.read_file("\{dir}/preserved.jsonl").text(), "keep me")
  let (failed, failed_err) = runner.command(
    base + ["--format=jsonl", "--output", "missing-parent/changes.jsonl"],
    1,
  )
  assert_eq(failed, "")
  assert_true(failed_err.contains("could not open output"))
  if ["native", "js"].contains(runner.target) && @fs.exists("/dev/full") {
    let (out, err) = runner.command(
      base + ["--format=jsonl", "--output", "/dev/full"],
      1,
    )
    assert_eq(out, "")
    assert_true(
      err.contains("could not write output") ||
      err.contains("could not flush output"),
    )
  }
  let warning_model = "$version: \"2\"\nnamespace example\n@deprecated\nstring Legacy\nstructure Example { name: Legacy }\n"
  @fs.write_file("\{dir}/warning-old.smithy", warning_model)
  @fs.write_file("\{dir}/warning-new.smithy", warning_model + "string Added\n")
  let (warning_out, warning_err) = runner.command(
    [
      "diff", "--old", "warning-old.smithy", "--new", "warning-new.smithy", "--format=jsonl",
    ],
    0,
  )
  assert_eq(jsonl_records(warning_out).length(), 1)
  assert_true(
    warning_err.contains("WARNING") && warning_err.contains("Deprecated"),
  )
  // NOTE-only, WARNING-only and suppressed comparisons retain existing statuses.
  let warning = "\{root}/tests/tck/diff/upstream/diffs/previewFeatures/changed-member-target"
  let suppressed = "\{root}/tests/tck/diff/upstream/suppressions"
  for
    (old, new, expected_severity) in [
      (
        "$version: \"2\"\nnamespace example\n", "$version: \"2\"\nnamespace example\nstring Added\n",
        "NOTE",
      ),
      (
        @fs.read_file(warning + ".a.smithy").text(),
        @fs.read_file(warning + ".b.smithy").text(),
        "WARNING",
      ),
      (
        @fs.read_file(suppressed + "-a.smithy").text(),
        @fs.read_file(suppressed + "-b.smithy").text(),
        "",
      ),
    ] {
    @fs.write_file("\{dir}/fixture.a.smithy", old)
    @fs.write_file("\{dir}/fixture.b.smithy", new)
    let (out, err) = runner.command(
      [
        "diff", "--old", "fixture.a.smithy", "--new", "fixture.b.smithy", "--format=jsonl",
      ],
      0,
    )
    assert_eq(err, "")
    let events = jsonl_records(out)
    if expected_severity == "" {
      assert_eq(events.length(), 0)
    } else {
      assert_false(events.is_empty())
      for event in events {
        guard event is { "severity": String(severity), .. } else {
          fail("missing severity")
        }
        assert_eq(severity, expected_severity)
      }
    }
  }
  // Metadata carries no shape/source; JSON escaping round-trips control data.
  let message = "line\nreturn\rtab\tquote\"slash\\nul\u0000雪🐟"
  let old_model : Json = {
    "smithy": "2",
    "metadata": { "changed": "old" },
    "shapes": {},
  }
  let new_model : Json = {
    "smithy": "2",
    "metadata": { "changed": message },
    "shapes": {},
  }
  @fs.write_file("\{dir}/old-meta.json", old_model.stringify())
  @fs.write_file("\{dir}/new-meta.json", new_model.stringify())
  let (meta_out, _) = runner.command(
    [
      "diff", "--old", "old-meta.json", "--new", "new-meta.json", "--format=jsonl",
    ],
    0,
  )
  let metadata = jsonl_records(meta_out)
  assert_eq(metadata.length(), 1)
  guard metadata[0]
    is {
      "id": "ChangedMetadata",
      "severity": "WARNING",
      "shape": Null,
      "source": Null,
      "message": String(value),
      ..
    } else {
    fail("unexpected metadata record")
  }
  assert_true(value.contains(Json(message).stringify()))
  // A single record larger than the host's I/O chunk and the pipe capacity
  // exercises partial writes and UTF-8 split across Wasm transfer chunks.
  let large_message = message.repeat(4000)
  let large_model : Json = {
    "smithy": "2",
    "metadata": { "changed": large_message },
    "shapes": {},
  }
  @fs.write_file("\{dir}/new-meta.json", large_model.stringify())
  let large_args = [
    "diff", "--old", "old-meta.json", "--new", "new-meta.json", "--format=jsonl",
  ]
  let (large_out, _) = runner.command(large_args, 0)
  let large_records = jsonl_records(large_out)
  assert_eq(large_records.length(), 1)
  guard large_records[0] is { "message": String(large_value), .. } else {
    fail("missing large event message")
  }
  assert_true(large_value.contains(Json(large_message).stringify()))
  let (large_file_out, _) = runner.command(large_args + ["--output", "large.jsonl"], 0)
  assert_eq(large_file_out, "")
  assert_eq(@fs.read_file("\{dir}/large.jsonl").text(), large_out)
  runner.command(["ast", "changed.smithy", "--output", "new-ast.json"], 0)
  |> ignore
  let (ast_out, _) = runner.command(
    ["diff", "--old", "old-ast.json", "--new", "new-ast.json", "--format=jsonl"],
    1,
  )
  guard jsonl_records(ast_out)[0]
    is {
      "source": {
        "file": String(ast_source),
        "path": "/shapes/example#Example/members/name",
        "span": Null,
        ..
      },
      ..
    } else {
    fail("missing JSON AST source path: \{ast_out}")
  }
  assert_true(ast_source.has_suffix("new-ast.json"))
  let (directory_out, _) = runner.command(
    ["diff", "--old", "old-models", "--new", "new-models", "--format=jsonl"],
    1,
  )
  let (directory_again, _) = runner.command(
    ["diff", "--old", "old-models", "--new", "new-models", "--format=jsonl"],
    1,
  )
  assert_eq(directory_out, directory_again)
  assert_eq(jsonl_records(directory_out).length(), 1)
  for
    (name, source) in [
      ("old.jar", "input.smithy"),
      ("new.jar", "changed.smithy"),
    ] {
    let archive = @zipc.Archive::empty()
    ignore(
      archive.add(
        @zipc.Member::make(
          "META-INF/smithy/manifest",
          @zipc.File(@zipc.File::stored_from_bytes(b"model.smithy\n")),
        ),
      ),
    )
    ignore(
      archive.add(
        @zipc.Member::make(
          "META-INF/smithy/model.smithy",
          @zipc.File(
            @zipc.File::stored_from_bytes(
              @fs.read_file("\{dir}/\{source}").binary(),
            ),
          ),
        ),
      ),
    )
    @fs.write_file("\{dir}/\{name}", archive.to_bytes())
  }
  let (jar_out, _) = runner.command(
    ["diff", "--old", "old.jar", "--new", "new.jar", "--format=jsonl"],
    1,
  )
  guard jsonl_records(jar_out)[0]
    is { "source": { "file": String(jar_source), .. }, .. } else {
    fail("missing JAR source")
  }
  assert_true(jar_source.has_suffix("new.jar!/META-INF/smithy/model.smithy"))
  // Real pipes qualify early delivery and backpressure with output larger than
  // a pipe buffer. The first record arrives while the producer is still live.
  let prefix = "$version: \"2\"\nnamespace example.stream\n"
  @fs.write_file("\{dir}/stream-old.smithy", prefix)
  let added = StringBuilder()
  added.write_string(prefix)
  for i in 0..<2000 {
    added.write_string("string Shape\{i}\n")
  }
  @fs.write_file("\{dir}/stream-new.smithy", added.to_string())
  let arguments = runner.prefix +
    [
      "diff", "--old", "stream-old.smithy", "--new", "stream-new.smithy", "--format=jsonl",
    ]
  @async.with_timeout(30000, () => {
    @async.with_task_group(group => {
      let (reader, stdout) = @process.read_from_process()
      defer reader.close()
      let (errors, stderr) = @process.read_from_process()
      defer errors.close()
      let process = @process.spawn(
        group,
        runner.executable,
        arguments,
        cwd=dir,
        stdout~,
        stderr~,
      )
      let first = reader.read_until("\n").unwrap()
      guard @json.parse(first) is { "id": "AddedShape", .. } else {
        fail("missing first event")
      }
      assert_eq(process.try_wait(), None)
      @async.sleep(20)
      let rest = reader.read_all().text()
      assert_eq(jsonl_records(first + "\n" + rest).length(), 2000)
      assert_eq(process.wait(), 0)
      assert_eq(errors.read_all().text(), "")
    })
  })
  @async.with_timeout(30000, () => {
    @async.with_task_group(group => {
      let (reader, stdout) = @process.read_from_process()
      let (errors, stderr) = @process.read_from_process()
      defer errors.close()
      let process = @process.spawn(
        group,
        runner.executable,
        arguments,
        cwd=dir,
        stdout~,
        stderr~,
      )
      ignore(reader.read_until("\n"))
      reader.close()
      assert_eq(process.wait(), 1)
      let error = errors.read_all().text()
      assert_true(
        error.contains("could not write output") ||
        error.contains("could not flush output"),
        msg=error,
      )
      assert_false(error.contains("panic"))
    })
  })
}

///|
async fn exercise_rpc_responses(runner : Runner, root : String, skip_stdin : Bool) -> Unit {
  let model = @fs.read_file(root + "/examples/json-rpc/responses.smithy").text()
  @fs.write_file(runner.dir + "/responses.smithy", model)
  let base = ["validate", "rpc", "--version", "2.0", "--service", "example#Replies", "--response", "reply.json", "responses.smithy", "--diagnostics", "json"]
  for (version, method_, response, status, code, pointer, shape) in [
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":1}", 0, "", "", ""),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"result\":\"19\",\"id\":1}", 1, "TypeMismatch", "/result", "example#SubtractOutput$value"),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"result\":21,\"id\":1}", 1, "Range", "/result", "example#SubtractOutput$value"),
    ("2.0", "get_data", "{\"jsonrpc\":\"2.0\",\"result\":[\"hello\",5],\"id\":1}", 0, "", "", ""),
    ("2.0", "get_data", "{\"jsonrpc\":\"2.0\",\"result\":[],\"id\":1}", 1, "Length", "/result", "example#DataOutput$items"),
    ("2.0", "get_object", "{\"jsonrpc\":\"2.0\",\"result\":{\"count\":1},\"id\":1}", 0, "", "", ""),
    ("2.0", "get_object", "{\"jsonrpc\":\"2.0\",\"result\":{},\"id\":1}", 1, "RequiredMember", "/result/count", "example#ObjectOutput$count"),
    ("2.0", "ping", "{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":1}", 0, "", "", ""),
    ("2.0", "ping", "{\"jsonrpc\":\"2.0\",\"result\":{},\"id\":1}", 1, "TypeMismatch", "/result", "example#Ping"),
    ("2.0", "subtract", "{\"result\":19,\"id\":1}", 1, "InvalidVersion", "/jsonrpc", "example#Subtract"),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"result\":19}", 1, "InvalidId", "/id", "example#Subtract"),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"result\":19,\"error\":null,\"id\":1}", 1, "InvalidEnvelope", "", "example#Subtract"),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"error\":null,\"id\":1}", 1, "InvalidError", "/error", "example#Subtract"),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":1001,\"message\":\"failure\",\"data\":\"detail\"},\"id\":1}", 0, "", "", ""),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":1001,\"message\":\"failure\",\"data\":1},\"id\":1}", 1, "TypeMismatch", "/error/data", "example#Problem$detail"),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":1002,\"message\":\"failure\"},\"id\":1}", 1, "UnknownError", "/error/code", "example#Subtract"),
    ("2.0", "subtract", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32603,\"message\":\"Internal error\"},\"id\":1}", 0, "", "", ""),
    ("1.0", "echo", "{\"result\":\"Hello JSON-RPC\",\"error\":null,\"id\":1}", 0, "", "", ""),
    ("1.0", "postMessage", "{\"result\":1,\"error\":null,\"id\":99}", 0, "", "", ""),
    ("1.0", "postMessage", "{\"result\":1,\"error\":null,\"id\":101}", 0, "", "", ""),
    ("1.0", "subtract", "{\"result\":19,\"error\":null,\"id\":{\"exact\":[9007199254740993]}}", 0, "", "", ""),
    ("1.0", "subtract", "{\"result\":19,\"id\":1}", 1, "InvalidEnvelope", "", "example#Subtract"),
    ("1.0", "subtract", "{\"result\":19,\"error\":\"failure\",\"id\":1}", 1, "InvalidEnvelope", "/result", "example#Subtract"),
  ] {
    @fs.write_file(runner.dir + "/reply.json", response)
    let args = base.copy(); args[3] = version
    let (out, _) = runner.command(args + ["--method", method_], status)
    guard @json.parse(out) is Object(report) else { fail("Expected one complete response report") }
    assert_eq(report.get("scope"), Some(Json::string("methodPayload")))
    assert_eq(report.get("valid"), Some(Json::boolean(status == 0)))
    if code != "" {
      guard report.get("findings") is Some(Array([Object(finding), ..])) else { fail("Expected response finding") }
      assert_eq(finding.get("code"), Some(Json::string(code)))
      assert_eq(finding.get("pointer"), Some(Json::string(pointer)))
      assert_eq(finding.get("shape"), Some(Json::string(shape)))
    }
  }
  for (request, response, status, code) in [
    ("{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":9007199254740993}", "{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":9007199254740993}", 0, ""),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":9007199254740993}", "{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":9007199254740992}", 1, "IdMismatch"),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"foobar\",\"id\":\"1\"}", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":\"1\"}", 0, ""),
    ("{\"jsonrpc\":\"2.0\",\"method\":1,\"params\":\"bar\"}", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"},\"id\":null}", 0, ""),
    ("{\"a\":truX}", "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32700,\"message\":\"Parse error\"},\"id\":null}", 0, ""),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}", "{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":null}", 1, "UnexpectedResponse"),
  ] {
    @fs.write_file(runner.dir + "/request.json", request)
    @fs.write_file(runner.dir + "/reply.json", response)
    let (out, _) = runner.command(base + ["--request", "request.json"], status)
    guard @json.parse(out) is Object(report) else { fail("Expected request-context response report") }
    assert_eq(report.get("scope"), Some(Json::string("requestContext")))
    if code != "" {
      guard report.get("findings") is Some(Array([Object(finding), ..])) else { fail("Expected context finding") }
      assert_eq(finding.get("code"), Some(Json::string(code)))
    }
  }
  @fs.write_file(runner.dir + "/reply.json", "{\"jsonrpc\":\"2.0\",\"result\":\"unchecked\",\"id\":1}")
  let (missing, _) = runner.command(base, 1)
  assert_true(missing.contains("MissingContext"))
  let (limited, _) = runner.command(base + ["--envelope-only"], 0)
  assert_true(limited.contains("LimitedScope") && limited.contains("\"scope\":\"envelope\""))
  runner.command(base + ["--operation", "example#Subtract"], 1) |> ignore
  let text_args = base[:9].to_owned()
  let (out, stderr) = runner.command(text_args + ["--method", "subtract"], 1)
  // moonrun's wasm-gc print host routes eprintln through stdout.
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("/result") && err.contains("TypeMismatch"))
  @fs.write_file(runner.dir + "/reply.json", "{\"result\":null,\"error\":{\"code\":1001,\"message\":\"failed\",\"data\":1},\"id\":1}")
  let legacy = base.copy(); legacy[3] = "1.0"
  let (out, _) = runner.command(legacy + ["--method", "subtract", "--legacy-errors", "code-message-data"], 1)
  assert_true(out.contains("/error/data") && out.contains("example#Problem$detail"))
  let (out, _) = runner.command(legacy + ["--method", "subtract"], 0)
  assert_true(out.contains("LimitedScope") && out.contains("legacyError"))
  @fs.write_file(runner.dir + "/request.json", "{\"method\":\"subtract\",\"params\":[42,23],\"id\":{\"exact\":[9007199254740993]}}")
  @fs.write_file(runner.dir + "/reply.json", "{\"result\":19,\"error\":null,\"id\":{\"exact\":[9007199254740993]}}")
  runner.command(legacy + ["--request", "request.json"], 0) |> ignore
  @fs.write_file(runner.dir + "/reply.json", "{\"result\":19,\"error\":null,\"id\":{\"exact\":[9007199254740992]}}")
  let (out, _) = runner.command(legacy + ["--request", "request.json"], 1)
  assert_true(out.contains("IdMismatch"))
  for (method_, params) in [("subtract", "[42,\"bad\"]"), ("missing", "[]")] {
    @fs.write_file(runner.dir + "/request.json", "{\"method\":\"" + method_ + "\",\"params\":" + params + ",\"id\":1}")
    @fs.write_file(runner.dir + "/reply.json", "{\"result\":null,\"error\":\"legacy failure\",\"id\":1}")
    runner.command(legacy + ["--request", "request.json"], 0) |> ignore
    @fs.write_file(runner.dir + "/reply.json", "{\"result\":19,\"error\":null,\"id\":1}")
    let (out, _) = runner.command(legacy + ["--request", "request.json"], 1)
    assert_true(out.contains("InvalidContext"))
  }
  let missing_file = base.copy(); missing_file[7] = "missing-reply.json"
  runner.command(missing_file + ["--envelope-only"], 1) |> ignore
  runner.command(base + ["--request", "missing-request.json"], 1) |> ignore
  if !skip_stdin && (runner.target != "wasm-gc" || @env.get_env_var("OS") != Some("Windows_NT")) {
    let request_stdin = base + ["--request", "-"]
    @fs.write_file(runner.dir + "/reply.json", "{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":1}")
    runner.command(request_stdin, 0, input="{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":1}") |> ignore
    let response_stdin = base.copy(); response_stdin[7] = "-"
    runner.command(response_stdin + ["--method", "ping"], 0, input="{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":1}") |> ignore
  }
}

async fn exercise_rpc_batches(runner : Runner, root : String, skip_stdin : Bool) -> Unit {
  @fs.write_file(runner.dir + "/batches.smithy", @fs.read_file(root + "/examples/json-rpc/batches.smithy").text())
  let base = ["validate", "rpc", "--version", "2.0", "--service", "batch#Api", "--batch", "batches.smithy", "--diagnostics", "json"]
  let mixed = @fs.read_file(root + "/examples/json-rpc/batch-mixed.json").text()
  let replies = @fs.read_file(root + "/examples/json-rpc/batch-replies.json").text()
  let notifications = @fs.read_file(root + "/examples/json-rpc/batch-notifications.json").text()
  let invalid_error = "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32600,\"message\":\"Invalid Request\"},\"id\":null}"
  let parse_error = "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32700,\"message\":\"Parse error\"},\"id\":null}"
  let large_call = "[{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":9007199254740993}]"
  let null_reply = "[{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":9007199254740993}]"
  for (request, response, status, code, pointer) in [
    (mixed, Some(replies), 0, "", ""),
    (notifications, None, 0, "", ""),
    ("[{\"jsonrpc\":\"2.0\",\"method\":\"missing\"}]", None, 0, "", ""),
    ("[\n{\"jsonrpc\":\"2.0\",\"method\":\"sum\",\"params\":[1,2,4],\"id\":\"1\"},\n{\"jsonrpc\":\"2.0\",\"method\"\n]", Some(parse_error), 0, "", ""),
    ("[]", Some(invalid_error), 0, "", ""),
    ("[1]", Some("[" + invalid_error + "]"), 0, "", ""),
    ("[1,2,3]", Some("[" + invalid_error + "," + invalid_error + "," + invalid_error + "]"), 0, "", ""),
    ("[[],null]", Some("[" + invalid_error + "," + invalid_error + "]"), 0, "", ""),
    (large_call, Some(null_reply), 0, "", ""),
    (large_call, Some("[{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":9007199254740992}]"), 1, "UnexpectedResponse", "/0/id"),
    (large_call, None, 1, "MissingResponse", ""),
    (notifications, Some("[]"), 1, "InvalidEnvelope", ""),
    (notifications, Some("[{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":null}]"), 1, "UnexpectedResponse", "/0/id"),
    (large_call, Some("[{\"jsonrpc\":\"2.0\",\"result\":{},\"id\":9007199254740993}]"), 1, "TypeMismatch", "/0/result"),
    (large_call, Some("[{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":9007199254740993},{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":9007199254740993}]"), 1, "DuplicateResponse", "/1/id"),
    ("[{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":1},{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":1.0}]", Some("[{\"jsonrpc\":\"2.0\",\"result\":null,\"id\":1}]"), 1, "AmbiguousId", ""),
    (large_call, Some("["), 1, "InvalidJson", ""),
    (large_call, Some("[{\"id\":1,\"id\":2}]"), 1, "DuplicateJsonKey", ""),
    ("[{\"id\":1,\"id\":2}]", Some(parse_error), 1, "InvalidContext", ""),
  ] {
    @fs.write_file(runner.dir + "/batch-requests.json", request)
    let args = if response is Some(response) {
      @fs.write_file(runner.dir + "/batch-responses.json", response)
      base + ["--response", "batch-responses.json", "--request", "batch-requests.json"]
    } else { base + ["--no-response", "--request", "batch-requests.json"] }
    let (out, _) = runner.command(args, status)
    guard @json.parse(out) is Object(report) else { fail("Expected one complete batch report") }
    assert_eq(report.get("valid"), Some(Json::boolean(status == 0)))
    if code != "" {
      guard report.get("findings") is Some(Array(findings)) else { fail("Missing batch findings") }
      assert_true(findings.iter().any(f => f is Object(fields) && fields.get("code") == Some(Json::string(code)) && fields.get("pointer") == Some(Json::string(pointer))), msg=out)
    }
  }
  for (request, status, code, pointer) in [
    (notifications, 0, "", ""),
    (mixed, 1, "InvalidVersion", "/3/jsonrpc"),
    ("[]", 1, "InvalidEnvelope", ""),
    ("[1]", 1, "InvalidEnvelope", "/0"),
    ("[1,2,3]", 1, "InvalidEnvelope", "/2"),
    ("[", 1, "InvalidJson", ""),
    ("[{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,\"bad\"]}]", 1, "TypeMismatch", "/0/params/1"),
    ("[" + "1,".repeat(99) + "1]", 1, "InvalidEnvelope", "/99"),
    ("[" + "1,".repeat(100) + "1]", 1, "LimitExceeded", "/100"),
    ("[".repeat(130) + "0" + "]".repeat(130), 1, "JsonInputLimit", ""),
  ] {
    @fs.write_file(runner.dir + "/batch-requests.json", request)
    let (out, _) = runner.command(base + ["--message", "batch-requests.json"], status)
    guard @json.parse(out) is Object(report) else { fail("Expected request batch report") }
    assert_eq(report.get("valid"), Some(Json::boolean(status == 0)))
    if code != "" {
      guard report.get("findings") is Some(Array(findings)) else { fail("Missing request batch findings") }
      assert_true(findings.iter().any(f => f is Object(fields) && fields.get("code") == Some(Json::string(code)) && fields.get("pointer") == Some(Json::string(pointer))), msg=out)
    }
  }
  let legacy = base.copy(); legacy[3] = "1.0"
  let (out, _) = runner.command(legacy + ["--message", "batch-requests.json"], 1)
  assert_true(out.contains("UnsupportedMessage"))
  @fs.write_file(runner.dir + "/batch-responses.json", null_reply)
  for context in [["--method", "ping"], ["--operation", "batch#Ping"], ["--envelope-only"]] {
    let (out, _) = runner.command(base + ["--response", "batch-responses.json"] + context, 0)
    guard @json.parse(out) is Object(report) else { fail("Expected scoped batch report") }
    assert_eq(report.get("scope"), Some(Json::string(if context[0] == "--envelope-only" { "envelope" } else { "methodPayload" })))
  }
  let (out, _) = runner.command(base + ["--response", "batch-responses.json"], 1)
  assert_true(out.contains("MissingContext"))
  runner.command(base + ["--no-response"], 2) |> ignore
  runner.command(base + ["--message", "batch-requests.json", "--no-response", "--request", "batch-requests.json"], 2) |> ignore
  if !skip_stdin && (runner.target != "wasm-gc" || @env.get_env_var("OS") != Some("Windows_NT")) {
    runner.command(base + ["--message", "-"], 0, input=notifications) |> ignore
    runner.command(base + ["--no-response", "--request", "-"], 0, input=notifications) |> ignore
    @fs.write_file(runner.dir + "/batch-requests.json", large_call)
    runner.command(base + ["--response", "-", "--request", "batch-requests.json"], 0, input=null_reply) |> ignore
  }
}

///|
async fn exercise_rpc(runner : Runner, root : String, skip_stdin : Bool) -> Unit {
  let model = @fs.read_file(root + "/examples/json-rpc/calculator.smithy").text()
  @fs.write_file(runner.dir + "/rpc.smithy", model)
  let base = ["validate", "rpc", "--version", "2.0", "--service", "example#Calculator", "--message", "rpc.json", "rpc.smithy"]
  for (message, status, code, pointer) in [
    ("{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":9007199254740993}", 0, "", ""),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,\"23\"]}", 1, "TypeMismatch", "/params/1"),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":{\"minuend\":42}}", 1, "RequiredMember", "/params/subtrahend"),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}", 0, "", ""),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"ping\",\"id\":null}", 0, "DiscouragedId", "/id"),
    ("{\"jsonrpc\":\"2.0\",\"method\":\"missing\"}", 1, "UnknownMethod", "/method"),
    ("[]", 1, "UnsupportedMessage", ""),
    ("{\"a\":truX}", 1, "InvalidJson", ""),
  ] {
    @fs.write_file(runner.dir + "/rpc.json", message)
    let (out, _) = runner.command(base + ["--diagnostics", "json"], status)
    guard @json.parse(out) is Object(result) else { fail("Expected RPC diagnostics") }
    assert_eq(result.get("valid"), Some(Json::boolean(status == 0)))
    if code != "" {
      guard result.get("findings") is Some(Array([Object(finding), ..])) else { fail("Expected an RPC finding") }
      assert_eq(finding.get("code"), Some(Json::string(code)))
      assert_eq(finding.get("pointer"), Some(Json::string(pointer)))
      if code == "TypeMismatch" {
        assert_eq(finding.get("shape"), Some(Json::string("example#SubtractInput$subtrahend")))
        assert_eq(finding.get("operation"), Some(Json::string("example#Subtract")))
      }
      if code == "InvalidJson" { assert_eq(finding.get("offset"), Some(Json::number(8.0))) }
    }
    runner.command(base, status) |> ignore
  }
  @fs.write_file(runner.dir + "/rpc.json", "{\"method\":\"subtract\",\"params\":[42,23],\"id\":null}")
  let legacy = base.copy(); legacy[3] = "1.0"
  runner.command(legacy, 0) |> ignore
  let invalid_version = base.copy(); invalid_version[3] = "1.1"
  runner.command(invalid_version, 2) |> ignore
  let bad_service = base.copy(); bad_service[5] = "example#Subtract"
  runner.command(bad_service, 2) |> ignore
  let missing_message = base.copy(); missing_message[7] = "missing-rpc.json"
  runner.command(missing_message + ["--diagnostics", "json"], 1) |> ignore
  for args in [["validate", "rpc", "--help"], ["help", "validate", "rpc"]] {
    let (help, _) = runner.command(args, 0)
    assert_true(help.contains("Usage: smithy validate rpc") && help.contains("--message"))
  }
  if !skip_stdin && (runner.target != "wasm-gc" || @env.get_env_var("OS") != Some("Windows_NT")) {
    let stdin_message = legacy.copy(); stdin_message[7] = "-"
    runner.command(stdin_message, 0, input="{\"method\":\"ping\",\"params\":[],\"id\":null}") |> ignore
    let stdin_model = legacy.copy(); stdin_model[8] = "-"
    runner.command(stdin_model + ["--from", "idl"], 0, input=model) |> ignore
  }
  let double_stdin = legacy.copy(); double_stdin[7] = "-"; double_stdin[8] = "-"
  runner.command(double_stdin + ["--from", "idl"], 2) |> ignore
  @fs.write_file(runner.dir + "/bad-value.json", "{\"a\":truX}")
  let (out, _) = runner.command(["validate", "value", "--shape", "example#Example", "--value", "bad-value.json", "--diagnostics", "json", "input.smithy"], 1)
  guard @json.parse(out) is { "findings": [ { "offset": Number(offset, ..), .. }, .. ], .. } else { fail("Expected value parse offset") }
  assert_eq(offset, 8.0)
}

///|
async fn exercise_ion(runner : Runner, skip_stdin : Bool) -> Unit {
  @fs.write_file(
    runner.dir + "/ion.smithy",
    "$version: \"2\"\nnamespace example\n@range(min: 1, max: 100)\ninteger Count\nstructure Input { @required count: Count }\n",
  )
  let args = [
    "validate", "value", "--shape", "example#Input", "--value", "value.ion", "--input-format",
    "ion-text", "--diagnostics", "json", "ion.smithy",
  ]
  for
    (text, code, finding) in [
      ("{count: 2}", 0, ""),
      ("{count: 0}", 1, "Range"),
      ("{}", 1, "RequiredMember"),
      ("{count: null.int}", 1, "TypeMismatch"),
      ("{count: ready}", 1, "UnsupportedValue"),
      ("{count: 1, count: 2}", 1, "DuplicateMember"),
      ("tag::{count: 2}", 1, "UnsupportedValue"),
      ("{count: (1 2)}", 1, "UnsupportedValue"),
    ] {
    @fs.write_file(runner.dir + "/value.ion", text)
    let (text_out, _) = runner.command(args, code)
    let json = @json.parse(text_out)
    guard json is Object(result) else { fail("Expected Ion findings") }
    assert_eq(result.get("valid"), Some(Json::boolean(code == 0)))
    if finding != "" {
      guard result.get("findings") is Some(Array(findings)) else {
        fail("Expected findings")
      }
      assert_true(
        findings.any(f => f is { "code": String(c), .. } && c == finding),
      )
      if finding == "Range" {
        guard findings
          is [
            {
              "nativeKind": String("int"),
              "shape": String("example#Input$count"),
              "pointer": String("/count"),
              ..
            },
          ] else {
          fail(text_out)
        }
      }
      if finding == "DuplicateMember" {
        assert_true(
          findings.any(f => {
            f
            is {
              "path": [
                {
                  "kind": String("field"),
                  "name": String("count"),
                  "occurrence": Number(1.0, ..),
                  ..
                },
              ],
              ..
            }
          }),
        )
      }
    }
    let binary = @ion_binary.write_binary_value(@ion_text.read_ion(text))
    @fs.write_file(runner.dir + "/value.10n", binary)
    let binary_args = [
      "validate", "value", "--shape", "example#Input", "--value", "value.10n", "--input-format",
      "ion-binary", "--diagnostics", "json", "ion.smithy",
    ]
    let (binary_out, _) = runner.command(binary_args, code)
    assert_eq(@json.parse(binary_out), json)
    assert_eq(@fs.read_file(runner.dir + "/value.ion").text(), text)
    if !skip_stdin && finding == "Range" {
      let (out, _) = runner.command(
        [
          "validate", "value", "--shape", "example#Input", "--value", "-", "--input-format",
          "ion-binary", "--diagnostics", "json", "ion.smithy",
        ],
        1,
        input_bytes=binary,
      )
      assert_eq(@json.parse(out), json)
    }
  }
  for
    (text, problem) in [
      ("", "IonSelection"),
      ("{count: 0} {count: 2}", "IonSelection"),
      ("{", "InvalidIon"),
    ] {
    @fs.write_file(runner.dir + "/value.ion", text)
    let (out, _) = runner.command(args, 1)
    assert_true(out.contains(problem) && out.contains("value.ion"), msg=out)
  }
  @fs.write_file(runner.dir + "/value.ion", "{count: 0} {count: 2}")
  let (selected, _) = runner.command(args + ["--ion-index", "1"], 0)
  assert_true(selected.contains("\"valid\":true"))
  runner.command(args + ["--ion-index", "2"], 1) |> ignore
  runner.command(args + ["--ion-index", "-1"], 2) |> ignore
  if !skip_stdin {
    runner.command(
      [
        "validate", "value", "--shape", "example#Input", "--value", "-", "--input-format",
        "ion-text", "ion.smithy",
      ],
      0,
      input="{count: 2}",
    )
    |> ignore
  }
  @fs.write_file(runner.dir + "/value.10n", b"\xe0\x01\x00\xea\xde")
  let (out, _) = runner.command(
    [
      "validate", "value", "--shape", "example#Input", "--value", "value.10n", "--input-format",
      "ion-binary", "--diagnostics", "json", "ion.smithy",
    ],
    1,
  )
  assert_true(out.contains("InvalidIon") && out.contains("value.10n"))
  let oversized = Bytes::make(16 * 1024 * 1024 + 1, b' ')
  @fs.write_file(runner.dir + "/oversized.ion", oversized)
  let (out, _) = runner.command(
    [
      "validate", "value", "--shape", "example#Input", "--value", "oversized.ion",
      "--input-format", "ion-text", "--diagnostics", "json", "ion.smithy",
    ],
    1,
  )
  assert_true(out.contains("IonInputLimit"), msg=out)
  if !skip_stdin {
    // Keep the pipe open after the limit byte. A reader that waits for EOF
    // cannot complete this command before the timeout.
    @async.with_timeout(15000, () => {
      @async.with_task_group(group => {
        let (stdin, writer) = @process.write_to_process()
        defer writer.close()
        group.spawn_bg(() => writer.write(oversized))
        let args = runner.prefix +
          [
            "validate", "value", "--shape", "example#Input", "--value", "-", "--input-format",
            "ion-text", "--diagnostics", "json", "ion.smithy",
          ]
        let (code, out, err) = @process.collect_output(
          runner.executable,
          args,
          cwd=runner.dir,
          stdin~,
        )
        assert_eq(code, 1, msg=err.text())
        assert_true(out.text().contains("IonInputLimit"), msg=out.text())
      })
    })
  }
}

///|
/// Check whole transcripts through the built CLI: exit codes, the JSON report
/// and expectation matching.
async fn exercise_rpc_transcripts(runner : Runner, root : String, skip_stdin : Bool) -> Unit {
  for model in ["peers.smithy", "batches.smithy", "lifecycle.smithy"] {
    @fs.write_file(runner.dir + "/" + model, @fs.read_file(root + "/examples/json-rpc/" + model).text())
  }
  for (protocol, model, transcript, status, valid, code) in [
    ("example.peers#EchoChat", "peers.smithy", "echo.json", 0, true, ""),
    ("example.peers#EchoChat", "peers.smithy", "chat.json", 0, true, ""),
    ("example.peers#EchoChat", "peers.smithy", "echo.md", 0, true, ""),
    ("example.peers#EchoChat", "peers.smithy", "chat.md", 0, true, ""),
    ("example.peers#Editor", "peers.smithy", "editor.json", 0, true, ""),
    ("example.peers#Editor", "peers.smithy", "editor-negative.json", 0, false, "UnsolicitedResponse"),
    ("batch#Link", "batches.smithy", "batches.json", 0, true, ""),
    ("example.peers#OrderedEditor", "peers.smithy", "editor.json", 0, true, ""),
    ("example.lifecycle#Lifecycle", "lifecycle.smithy", "lifecycle-valid.json", 0, true, ""),
    ("example.lifecycle#Lifecycle", "lifecycle.smithy", "lifecycle-violation.json", 0, false, "StateViolation"),
  ] {
    @fs.write_file(runner.dir + "/" + transcript, @fs.read_file(root + "/examples/json-rpc/transcripts/" + transcript).text())
    let args = ["validate", "rpc", "transcript", "--protocol", protocol, model, transcript]
    let (out, _) = runner.command(args + ["--diagnostics", "json"], status)
    guard @json.parse(out) is Object(report) else { fail("Expected one complete transcript report") }
    assert_eq(report.get("valid"), Some(Json::boolean(valid)), msg=out)
    assert_eq(report.get("complete"), Some(Json::boolean(true)), msg=out)
    guard report.get("findings") is Some(Array(findings)) else { fail("Missing transcript findings") }
    if code == "" {
      assert_eq(findings.length(), 0, msg=out)
      assert_eq(report.get("expectations"), None, msg=out)
    } else {
      guard findings is [Object(first), ..] else { fail("Expected a transcript finding") }
      assert_eq(first.get("code"), Some(Json::string(code)), msg=out)
      guard report.get("expectations") is Some(Object(expectations)) else { fail("Expected the expectation result") }
      assert_eq(expectations.get("matched"), Some(Json::boolean(true)), msg=out)
      assert_eq(expectations.get("missing"), Some(Json::array([])), msg=out)
      assert_eq(expectations.get("unexpected"), Some(Json::array([])), msg=out)
    }
    runner.command(args, status) |> ignore
  }
  let editor = ["validate", "rpc", "transcript", "--protocol", "example.peers#Editor", "peers.smithy"]
  // A transcript without an expect list exits 1 on an error finding.
  @fs.write_file(runner.dir + "/unsolicited.json", "{\"version\":\"2.0\",\"entries\":[{\"from\":\"server\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":9,\"result\":\"full\"}}]}")
  let (out, _) = runner.command(editor + ["unsolicited.json", "--diagnostics", "json"], 1)
  guard @json.parse(out) is Object(report) else { fail("Expected the unsolicited report") }
  assert_eq(report.get("valid"), Some(Json::boolean(false)))
  assert_eq(report.get("entries"), Some(Json::number(1.0)))
  guard report.get("findings") is Some(Array([Object(first), ..])) else { fail("Expected the unsolicited finding") }
  assert_eq(first.get("code"), Some(Json::string("UnsolicitedResponse")))
  assert_eq(first.get("entry"), Some(Json::number(0.0)))
  let (out, stderr) = runner.command(editor + ["unsolicited.json"], 1)
  // moonrun's wasm-gc print host routes eprintln through stdout.
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("unsolicited.json:1:56: entry 0 server: error UnsolicitedResponse: "), msg=err)
  // A partial transcript reports outstanding calls as advisories and exits 0;
  // --complete turns them into missing replies.
  @fs.write_file(runner.dir + "/partial.json", "{\"version\":\"2.0\",\"entries\":[{\"from\":\"client\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}}]}")
  let (out, _) = runner.command(editor + ["partial.json", "--diagnostics", "json"], 0)
  assert_true(out.contains("\"outstanding\":1") && out.contains("OutstandingCall"), msg=out)
  let (out, _) = runner.command(editor + ["partial.json", "--complete", "--diagnostics", "json"], 1)
  assert_true(out.contains("MissingResponse"), msg=out)
  // An advisory reader finding does not hide the missing version: exit 2 with the hint.
  @fs.write_file(runner.dir + "/noversion.json", "{\"comment\":\"x\",\"entries\":[{\"from\":\"client\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}}]}")
  let (out, stderr) = runner.command(editor + ["noversion.json"], 2)
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("--version"), msg=err)
  // A document with an error finding and no version still exits 1.
  @fs.write_file(runner.dir + "/noversion-error.json", "{\"entries\":[{\"from\":\"client\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}}],\"entries\":[]}")
  runner.command(editor + ["noversion-error.json"], 1) |> ignore
  // A malformed document without a version follows --expect: a match exits 0, a mismatch exits 1.
  @fs.write_file(runner.dir + "/broken.json", "{\"entries\":[")
  @fs.write_file(runner.dir + "/broken-match.expect.json", "[{\"code\":\"InvalidTranscript\"}]")
  @fs.write_file(runner.dir + "/broken-miss.expect.json", "[{\"code\":\"WrongResponder\"}]")
  runner.command(editor + ["broken.json", "--expect", "broken-match.expect.json"], 0) |> ignore
  runner.command(editor + ["broken.json", "--expect", "broken-miss.expect.json"], 1) |> ignore
  // Markdown without a version behaves the same way.
  @fs.write_file(runner.dir + "/noversion.md", "# Chat\n\n```jsonrpc client -> server\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}\n```\n")
  let (out, stderr) = runner.command(editor + ["noversion.md"], 2)
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("--version"), msg=err)
  // An expect list that does not match exits 1 and names the missing finding.
  @fs.write_file(runner.dir + "/mismatch.json", "{\"version\":\"2.0\",\"expect\":[{\"code\":\"WrongResponder\",\"entry\":0}],\"entries\":[{\"from\":\"server\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":9,\"result\":\"full\"}}]}")
  let (out, _) = runner.command(editor + ["mismatch.json", "--diagnostics", "json"], 1)
  guard @json.parse(out) is { "expectations": { "matched": False, "missing": [{ "code": String(missing), .. }], "unexpected": [{ "code": String(unexpected), .. }], .. }, .. } else { fail("Expected a failed expectation: \{out}") }
  assert_eq(missing, "WrongResponder")
  assert_eq(unexpected, "UnsolicitedResponse")
  // --expect gives the expected findings of a document without an expect list.
  @fs.write_file(runner.dir + "/unsolicited.expect.json", "[{\"code\":\"UnsolicitedResponse\",\"entry\":0}]")
  let (out, _) = runner.command(editor + ["unsolicited.json", "--expect", "unsolicited.expect.json", "--diagnostics", "json"], 0)
  guard @json.parse(out) is { "valid": False, "expectations": { "matched": True, .. }, .. } else { fail("Expected a matched --expect: \{out}") }
  @fs.write_file(runner.dir + "/wrong.expect.json", "[{\"code\":\"WrongResponder\"}]")
  let (out, stderr) = runner.command(editor + ["unsolicited.json", "--expect", "wrong.expect.json"], 1)
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("unsolicited.json: expect: I expected WrongResponder; no finding matches it."), msg=err)
  // --expect and an expect list in the document conflict; a malformed or missing expect file is a usage error.
  let (out, stderr) = runner.command(editor + ["mismatch.json", "--expect", "unsolicited.expect.json"], 2)
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("--expect unsolicited.expect.json and the expect list in mismatch.json"), msg=err)
  @fs.write_file(runner.dir + "/bad.expect.json", "[{\"code\":\"Nope\"}]")
  let (out, stderr) = runner.command(editor + ["unsolicited.json", "--expect", "bad.expect.json"], 2)
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("bad.expect.json:1:2: I do not know the finding code \"Nope\""), msg=err)
  runner.command(editor + ["unsolicited.json", "--expect", "missing.expect.json"], 2) |> ignore
  // --legacy-errors code-message-data checks 1.0 application errors, which are opaque by default.
  let chat = ["validate", "rpc", "transcript", "--protocol", "example.peers#EchoChat", "peers.smithy", "legacy.json", "--diagnostics", "json"]
  let mapped = chat + ["--legacy-errors", "code-message-data"]
  for (error, status) in [("{\"code\":-32603,\"message\":\"Internal error\"}", 0), ("{\"code\":7,\"message\":\"failed\"}", 1)] {
    @fs.write_file(runner.dir + "/legacy.json", "{\"version\":\"1.0\",\"entries\":[{\"from\":\"client\",\"message\":{\"method\":\"echo\",\"params\":[\"hi\"],\"id\":1}},{\"from\":\"server\",\"message\":{\"result\":null,\"error\":" + error + ",\"id\":1}}]}")
    let (out, _) = runner.command(chat, 0)
    guard @json.parse(out) is { "findings": [{ "code": "LimitedScope", "severity": "advisory", .. }], .. } else { fail("Expected an opaque legacy error: \{out}") }
    let (out, _) = runner.command(mapped, status)
    if status == 0 {
      guard @json.parse(out) is { "findings": [], .. } else { fail("Expected a checked legacy error: \{out}") }
    } else {
      guard @json.parse(out) is { "findings": [{ "code": "UnknownError", .. }], .. } else { fail("Expected an unmodeled legacy error: \{out}") }
    }
  }
  // --legacy-errors needs version 1.0, from the flag or from the document.
  for args in [["unsolicited.json", "--legacy-errors", "opaque"], ["unsolicited.json", "--version", "2.0", "--legacy-errors", "opaque"], ["unsolicited.json", "--legacy-errors", "full"]] {
    runner.command(editor + args, 2) |> ignore
  }
  // A malformed transcript is an error finding, not a usage error.
  @fs.write_file(runner.dir + "/broken.json", "{\"version\":\"2.0\",\"entries\":[{\"from\":\"client\"}]}")
  let (out, _) = runner.command(editor + ["broken.json", "--diagnostics", "json"], 1)
  assert_true(out.contains("InvalidTranscript"), msg=out)
  // A misspelled "entries" key is an error, not an empty valid transcript.
  @fs.write_file(runner.dir + "/misspelled.json", "{\"version\":\"2.0\",\"complete\":true,\"entires\":[{\"from\":\"client\",\"message\":{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}}]}")
  let (out, _) = runner.command(editor + ["misspelled.json", "--diagnostics", "json"], 1)
  assert_true(out.contains("InvalidTranscript") && out.contains("entires"), msg=out)
  runner.command(editor + ["misspelled.json"], 1) |> ignore
  // An unknown top-level key is an advisory only.
  @fs.write_file(runner.dir + "/commented.json", "{\"version\":\"2.0\",\"comment\":\"x\",\"entries\":[{\"from\":\"client\",\"message\":{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}}]}")
  let (out, _) = runner.command(editor + ["commented.json", "--diagnostics", "json"], 0)
  assert_true(out.contains("\"advisory\"") && out.contains("comment"), msg=out)
  @fs.write_file(runner.dir + "/unversioned.json", "[{\"from\":\"client\",\"message\":{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}}]")
  runner.command(editor + ["unversioned.json"], 2) |> ignore
  runner.command(editor + ["unversioned.json", "--version", "2.0"], 0) |> ignore
  runner.command(editor + ["unsolicited.json", "--version", "1.0"], 2) |> ignore
  runner.command(editor + ["unsolicited.json", "--complete", "--partial"], 2) |> ignore
  runner.command(["validate", "rpc", "transcript", "--protocol", "example.peers#Missing", "peers.smithy", "unsolicited.json"], 2) |> ignore
  // An order trait that names an undeclared state is a contract error.
  @fs.write_file(runner.dir + "/bad-session.smithy", @fs.read_file(runner.dir + "/lifecycle.smithy").text().replace(old="allowedIn: [\"ready\"], onSuccess: \"stopping\"", new="allowedIn: [\"done\"], onSuccess: \"stopping\""))
  let (out, stderr) = runner.command(["validate", "rpc", "transcript", "--protocol", "example.lifecycle#Lifecycle", "bad-session.smithy", "lifecycle-valid.json"], 2)
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("allowedIn"), msg=err)
  runner.command(editor + ["missing-transcript.json"], 1) |> ignore
  @fs.write_file(runner.dir + "/notes.md", "# notes")
  // A Markdown file with no jsonrpc blocks and no version is a usage error.
  runner.command(editor + ["notes.md"], 2) |> ignore
  runner.command(editor + ["notes.md", "--version", "2.0"], 0) |> ignore
  @fs.write_file(runner.dir + "/broken.md", "---\nversion: 2.0\n---\n```jsonrpc\n{}\n```\n")
  let (out, _) = runner.command(editor + ["broken.md", "--diagnostics", "json"], 1)
  assert_true(out.contains("InvalidTranscript") && out.contains("\"line\":4"), msg=out)
  runner.command(editor + ["--input-format", "jsonl", "notes.md"], 2) |> ignore
  for args in [["validate", "rpc", "transcript", "--help"], ["help", "validate", "rpc", "transcript"]] {
    let (help, _) = runner.command(args, 0)
    assert_true(help.contains("Usage: smithy validate rpc transcript") && help.contains("--protocol"), msg=help)
  }
  if !skip_stdin && (runner.target != "wasm-gc" || @env.get_env_var("OS") != Some("Windows_NT")) {
    let text = @fs.read_file(root + "/examples/json-rpc/transcripts/editor.json").text()
    runner.command(editor + ["--input-format", "json", "-"], 0, input=text) |> ignore
    runner.command(editor + ["-"], 2, input=text) |> ignore
  }
}

///|
/// Gives the JSON Lines of a streamed transcript: the findings, then the
/// summary object of the last line.
fn transcript_stream(out : String) -> (Array[Json], Map[String, Json]) raise {
  let records = jsonl_records(out)
  guard records.pop() is Some({ "summary": Object(summary), .. }) else {
    fail("Expected a final summary line: \{out}")
  }
  (records, summary)
}

///|
/// Check JSONL logs through the built CLI: presets, a mapping file, a
/// one-sender log, usage errors, and findings that arrive before end of input.
async fn exercise_rpc_log_streams(runner : Runner, root : String, skip_stdin : Bool) -> Unit {
  @fs.write_file(runner.dir + "/peers.smithy", @fs.read_file(root + "/examples/json-rpc/peers.smithy").text())
  for name in ["editor.jsonl", "editor-dir.ndjson", "mcp-like.jsonl", "mcp-like.mapping.json"] {
    @fs.write_file(runner.dir + "/" + name, @fs.read_file(root + "/examples/json-rpc/transcripts/" + name).text())
  }
  let editor = ["validate", "rpc", "transcript", "--protocol", "example.peers#Editor", "--version", "2.0", "peers.smithy"]
  let directions = ["--log-preset", "dir-message", "--direction", "in=client", "--direction", "out=server"]
  // The default dir-message map is request = client and response = server.
  let (out, _) = runner.command(editor + ["editor-dir.ndjson", "--diagnostics", "json"], 0)
  let (findings, summary) = transcript_stream(out)
  assert_eq(findings.length(), 0, msg=out)
  assert_eq(summary.get("valid"), Some(Json::boolean(true)), msg=out)
  assert_eq(summary.get("correlation"), Some(Json::boolean(true)), msg=out)
  assert_eq(summary.get("entries"), Some(Json::number(9.0)), msg=out)
  assert_eq(summary.get("lines"), Some(Json::number(9.0)), msg=out)
  // A mapping file reads a prefixed log with escaped messages.
  let (out, _) = runner.command(editor + ["--log-mapping", "mcp-like.mapping.json", "mcp-like.jsonl", "--diagnostics", "json"], 0)
  let (findings, summary) = transcript_stream(out)
  assert_eq(findings.length(), 0, msg=out)
  for (key, count) in [("lines", 10.0), ("not_json", 2.0), ("skipped", 1.0), ("entries", 7.0), ("outstanding", 0.0)] {
    assert_eq(summary.get(key), Some(Json::number(count)), msg="\{key}: \{out}")
  }
  // A raw log has one sender, so correlation is off and the summary says so.
  @fs.write_file(runner.dir + "/client.jsonl", "starting\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":42}}\n{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}\n")
  let raw = editor + ["--log-preset", "raw", "--sender", "client", "client.jsonl"]
  let (out, _) = runner.command(raw + ["--diagnostics", "json", "--complete"], 0)
  let (findings, summary) = transcript_stream(out)
  assert_eq(findings.length(), 0, msg=out)
  assert_eq(summary.get("correlation"), Some(Json::boolean(false)), msg=out)
  assert_eq(summary.get("outstanding"), Some(Json::number(0.0)), msg=out)
  assert_eq(summary.get("not_json"), Some(Json::number(1.0)), msg=out)
  let (_, err) = runner.command(raw, 0)
  assert_true(err.contains("client.jsonl: summary: valid:true complete:true entries:2 outstanding:0 correlation:false lines:3 not_json:1 skipped:0"), msg=err)
  // Findings stream one per line before the summary, and exit 1.
  @fs.write_file(runner.dir + "/unsolicited.jsonl", "{\"dir\":\"response\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":9,\"result\":\"full\"}}\n{\"dir\":\"sideways\",\"message\":{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}}\n")
  let (out, _) = runner.command(editor + ["unsolicited.jsonl", "--diagnostics", "json"], 1)
  let (findings, summary) = transcript_stream(out)
  guard findings is [{ "code": "UnsolicitedResponse", "entry": Number(0.0, ..), "line": Number(1.0, ..), .. }, { "code": "InvalidTranscript", "line": Number(2.0, ..), .. }] else {
    fail("Expected an unsolicited reply and an unmapped direction: \{out}")
  }
  assert_eq(summary.get("valid"), Some(Json::boolean(false)), msg=out)
  let (_, err) = runner.command(editor + ["unsolicited.jsonl"], 1)
  assert_true(err.contains("unsolicited.jsonl:1:29: entry 0 server: error UnsolicitedResponse: "), msg=err)
  assert_true(err.contains("unsolicited.jsonl: summary: valid:false"), msg=err)
  // --expect matches a log at the end: findings still stream, and the summary has the match.
  @fs.write_file(runner.dir + "/unsolicited.expect.json", "[{\"code\":\"UnsolicitedResponse\",\"entry\":0},{\"code\":\"InvalidTranscript\"}]")
  let (out, _) = runner.command(editor + ["unsolicited.jsonl", "--expect", "unsolicited.expect.json", "--diagnostics", "json"], 0)
  let (findings, summary) = transcript_stream(out)
  assert_eq(findings.length(), 2, msg=out)
  guard summary.get("expectations") is Some({ "matched": True, "missing": [], "unexpected": [], .. }) else { fail("Expected a matched log: \{out}") }
  let (_, err) = runner.command(editor + ["unsolicited.jsonl", "--expect", "unsolicited.expect.json"], 0)
  assert_true(err.contains("unsolicited.jsonl: summary: valid:false") && err.contains(" matched:true"), msg=err)
  @fs.write_file(runner.dir + "/short.expect.json", "[{\"code\":\"UnsolicitedResponse\",\"entry\":0},{\"code\":\"MissingResponse\"}]")
  let (out, _) = runner.command(editor + ["unsolicited.jsonl", "--expect", "short.expect.json", "--diagnostics", "json"], 1)
  let (_, summary) = transcript_stream(out)
  guard summary.get("expectations") is Some({ "matched": False, "missing": [{ "code": "MissingResponse", .. }], "unexpected": [{ "code": "InvalidTranscript", .. }], .. }) else {
    fail("Expected a failed log expectation: \{out}")
  }
  @fs.write_file(runner.dir + "/broken.expect.json", "{\"code\":\"UnsolicitedResponse\"}")
  runner.command(editor + ["unsolicited.jsonl", "--expect", "broken.expect.json"], 2) |> ignore
  // --legacy-errors reaches the checker of a 1.0 log.
  @fs.write_file(runner.dir + "/chat.jsonl", "{\"dir\":\"request\",\"message\":{\"method\":\"echo\",\"params\":[\"hi\"],\"id\":1}}\n{\"dir\":\"response\",\"message\":{\"result\":null,\"error\":{\"code\":7,\"message\":\"failed\"},\"id\":1}}\n")
  let chat = ["validate", "rpc", "transcript", "--protocol", "example.peers#EchoChat", "--version", "1.0", "peers.smithy", "chat.jsonl", "--diagnostics", "json"]
  let (out, _) = runner.command(chat, 0)
  assert_true(out.contains("LimitedScope"), msg=out)
  let (out, _) = runner.command(chat + ["--legacy-errors", "code-message-data"], 1)
  assert_true(out.contains("UnknownError"), msg=out)
  runner.command(editor + ["unsolicited.jsonl", "--legacy-errors", "code-message-data"], 2) |> ignore
  // Usage and contract errors exit 2.
  @fs.write_file(runner.dir + "/bad.mapping.json", "{\"sender\": \"nobody\"}")
  for args in [
    ["editor.jsonl"] + directions.map(arg => if arg == "out=server" { "out=nobody" } else { arg }),
    ["--log-preset", "raw", "--sender", "nobody", "client.jsonl"],
    ["--log-preset", "raw", "client.jsonl"],
    ["--log-preset", "raw", "--log-mapping", "mcp-like.mapping.json", "client.jsonl"],
    ["--log-mapping", "bad.mapping.json", "mcp-like.jsonl"],
    ["--log-mapping", "missing.mapping.json", "mcp-like.jsonl"],
  ] {
    runner.command(editor + args, 2) |> ignore
  }
  runner.command(["validate", "rpc", "transcript", "--protocol", "example.peers#Editor", "peers.smithy", "editor-dir.ndjson"], 2) |> ignore
  for args in [["validate", "rpc", "transcript", "--help"], ["help", "validate", "rpc", "transcript"]] {
    let (help, _) = runner.command(args, 0)
    assert_true(help.contains("--log-preset") && help.contains("--direction") && help.contains("--expect") && help.contains("read all of the input first"), msg=help)
  }
  if skip_stdin || (runner.target == "wasm-gc" && @env.get_env_var("OS") == Some("Windows_NT")) {
    return
  }
  // A mixed log through stdin, with the direction values of its writer.
  let text = @fs.read_file(root + "/examples/json-rpc/transcripts/editor.jsonl").text()
  let (out, _) = runner.command(editor + directions + ["--diagnostics", "json", "-"], 0, input=text)
  let (findings, summary) = transcript_stream(out)
  assert_eq(findings.length(), 0, msg=out)
  for (key, count) in [("lines", 19.0), ("not_json", 8.0), ("skipped", 2.0), ("entries", 9.0)] {
    assert_eq(summary.get(key), Some(Json::number(count)), msg="\{key}: \{out}")
  }
  assert_eq(summary.get("correlation"), Some(Json::boolean(true)), msg=out)
  if runner.target != "native" {
    return
  }
  // Native reads stdin as it arrives: the first finding comes out while the
  // writer still holds the pipe open.
  @async.with_timeout(15000, () => {
    @async.with_task_group(group => {
      let (stdin, writer) = @process.write_to_process()
      let (reader, stdout) = @process.read_from_process()
      defer reader.close()
      let status = group.spawn(() => {
        @process.run(runner.executable, editor + ["--diagnostics", "json", "-"], cwd=runner.dir, stdin~, stdout~)
      })
      writer.write("{\"dir\":\"request\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"missing/method\"}}\n")
      guard reader.read_until("\n") is Some(first) else { fail("Expected a finding before end of input") }
      guard @json.parse(first) is { "entry": Number(0.0, ..), "severity": "error", .. } else {
        fail("Expected an error finding for entry 0: \{first}")
      }
      writer.close()
      let rest = reader.read_all().text()
      assert_eq(status.wait(), 1, msg=rest)
      assert_true(rest.contains("\"summary\""), msg=rest)
    })
  })
}

///|
/// Check JSONL log files: a file of many read chunks, and on native a FIFO
/// whose findings come out before its writer closes it.
async fn exercise_rpc_log_files(runner : Runner, root : String) -> Unit {
  @fs.write_file(runner.dir + "/peers.smithy", @fs.read_file(root + "/examples/json-rpc/peers.smithy").text())
  let editor = ["validate", "rpc", "transcript", "--protocol", "example.peers#Editor", "--version", "2.0", "peers.smithy"]
  // 20,000 valid lines with two-byte characters, so chunk boundaries fall
  // inside lines and characters, then one error on the last line.
  let log = StringBuilder()
  for id in 1..=10000 {
    log.write_string("{\"dir\":\"request\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":\{id},\"method\":\"textDocument/hover\",\"params\":{\"uri\":\"file:///\u{e9}\{id}\"}}}\n")
    log.write_string("{\"dir\":\"response\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":\{id},\"result\":\"d\u{e9}j\u{e0} vu\"}}\n")
  }
  log.write_string("{\"dir\":\"request\",\"message\":{\"jsonrpc\":\"2.0\",\"method\":\"missing/method\"}}\n")
  @fs.write_file(runner.dir + "/large.jsonl", log.to_string())
  let (out, _) = runner.command(editor + ["large.jsonl", "--diagnostics", "json"], 1)
  let (findings, summary) = transcript_stream(out)
  guard findings is [{ "code": "UnknownMethod", "entry": Number(20000.0, ..), "line": Number(20001.0, ..), .. }] else {
    fail("Expected one finding on the last line: \{out}")
  }
  for (key, count) in [("lines", 20001.0), ("entries", 20001.0), ("outstanding", 0.0), ("not_json", 0.0)] {
    assert_eq(summary.get(key), Some(Json::number(count)), msg="\{key}: \{out}")
  }
  // A path that opens but cannot be read, such as a directory on POSIX,
  // gives the same InputRead report and exit status as a missing file:
  // no summary, and no "could not read" error after it.
  @fs.mkdir(runner.dir + "/folder.jsonl", allow_exist=true)
  for diagnostics in ["text", "json"] {
    let options = ["--diagnostics", diagnostics]
    let (missing_out, missing_err) = runner.command(editor + ["absent.jsonl"] + options, 1)
    let (folder_out, folder_err) = runner.command(editor + ["folder.jsonl"] + options, 1)
    assert_true((missing_out + missing_err).contains("InputRead"), msg=missing_out + missing_err)
    assert_eq(folder_out, missing_out.replace_all(old="absent.jsonl", new="folder.jsonl"))
    assert_eq(folder_err, missing_err.replace_all(old="absent.jsonl", new="folder.jsonl"))
    if @env.get_env_var("OS") != Some("Windows_NT") {
      // An unreadable stdin, here a directory opened as descriptor 0, gives
      // the same report as the unreadable file, not a crash.
      let words = [runner.executable]
      words.append(runner.prefix)
      words.append(editor + ["-"] + options)
      let quoted = words.map(word => "'" + word.replace_all(old="'", new="'\\''") + "'")
      let (stdin_out, stdin_err) = runner.command_in_shell(
        quoted.join(" ") + " < folder.jsonl", 1,
      )
      assert_true((stdin_out + stdin_err).contains("InputRead"), msg=stdin_out + stdin_err)
      assert_false(stdin_out.contains("\"summary\""), msg=stdin_out)
    }
  }
  if runner.target != "native" || @env.get_env_var("OS") == Some("Windows_NT") {
    return
  }
  // A FIFO streams like stdin: the first finding comes out while the writer
  // still holds it open. Skip where mkfifo is not available.
  let fifo = runner.dir + "/live.jsonl"
  let made = try {
    let (code, _, _) = @process.collect_output("mkfifo", [fifo])
    code == 0
  } catch {
    _ => false
  }
  if !made {
    println("skipped the FIFO case: mkfifo is not available")
    return
  }
  @async.with_timeout(15000, () => {
    @async.with_task_group(group => {
      let (reader, stdout) = @process.read_from_process()
      defer reader.close()
      let status = group.spawn(() => {
        @process.run(runner.executable, editor + ["--diagnostics", "json", "live.jsonl"], cwd=runner.dir, stdout~)
      })
      let writer = @fs.open(fifo, mode=WriteOnly)
      let mut open = true
      defer (if open { writer.close() })
      writer.write("{\"dir\":\"request\",\"message\":{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"missing/method\"}}\n")
      guard reader.read_until("\n") is Some(first) else { fail("Expected a finding before the FIFO closes") }
      guard @json.parse(first) is { "entry": Number(0.0, ..), "severity": "error", .. } else {
        fail("Expected an error finding for entry 0: \{first}")
      }
      open = false
      writer.close()
      let rest = reader.read_all().text()
      assert_eq(status.wait(), 1, msg=rest)
      assert_true(rest.contains("\"summary\""), msg=rest)
    })
  })
}

///|
/// The landing page shows `site/landing/sample/`. This runs the command of
/// `command.txt` on the sample model and value and requires the shown output.
async fn exercise_landing_sample(runner : Runner, root : String) -> Unit {
  let sample = "\{root}/site/landing/sample"
  for name in ["order.smithy", "order.json"] {
    @fs.write_file(
      "\{runner.dir}/\{name}",
      @fs.read_file("\{sample}/\{name}").binary(),
    )
  }
  let command = @fs.read_file("\{sample}/command.txt").text().trim().to_owned()
  let words = command.split(" ").map(w => w.to_owned()).collect()
  guard words.length() > 1 && words[0] == "smithy" else {
    fail("command.txt must start with smithy: \{command}")
  }
  let (out, stderr) = runner.command(words[1:].to_owned(), 1)
  let err = if runner.target == "wasm-gc" { out + stderr } else { stderr }
  // A Windows checkout may turn the sample files into CRLF: compare without line-ending differences.
  let shown = @fs.read_file("\{sample}/output.txt").text()
  assert_eq(
    err.replace_all(old="\r\n", new="\n"),
    shown.replace_all(old="\r\n", new="\n"),
  )
}

///|
/// Every model command resolves the bundled smithy.rpc traits and treats their
/// definitions as built-in, as it does for the prelude.
async fn exercise_rpc_traits(runner : Runner, root : String) -> Unit {
  let dir = runner.dir
  let model = @fs.read_file(root + "/examples/json-rpc/peers.smithy").text()
  @fs.write_file(dir + "/peers.smithy", model)
  fn check_ast(text : String) raise {
    guard @json.parse(text) is { "shapes": Object(shapes), .. } else {
      fail("Expected a JSON AST: \{text}")
    }
    assert_false(shapes.keys().any(id => id.has_prefix("smithy.rpc#")), msg=text)
    guard shapes.get("example.peers#ChatServer") is Some({ "traits": Object(traits), .. }) else {
      fail("Expected the ChatServer traits: \{text}")
    }
    assert_true(traits.contains("smithy.rpc#jsonRpc"))
  }
  runner.command(["validate", "peers.smithy"], 0) |> ignore
  let (ast, _) = runner.command(["ast", "peers.smithy"], 0)
  check_ast(ast)
  let (converted, _) = runner.command(["convert", "--to", "json", "peers.smithy"], 0)
  check_ast(converted)
  assert_eq(converted, ast)
  let (selected, _) = runner.command(["select", "--selector", "[trait|smithy.rpc#jsonRpc]", "peers.smithy"], 0)
  for service in ["ChatServer", "ChatClient", "LanguageServer", "LanguageClient", "Sink"] {
    assert_true(selected.contains("example.peers#\{service}\n"), msg=selected)
  }
  assert_eq(selected.trim_end().to_owned().split("\n").count(), 5)
  // The IDL output holds no smithy.rpc namespace and reads back to the same model.
  runner.command(["convert", "--to", "idl", "--output-dir", "peers-idl", "peers.smithy"], 0) |> ignore
  assert_true(@fs.exists(dir + "/peers-idl/example.peers.smithy"))
  assert_false(@fs.exists(dir + "/peers-idl/smithy.rpc.smithy"))
  let (round_trip, _) = runner.command(["ast", "peers-idl/example.peers.smithy"], 0)
  // to_idl sorts the shapes, so compare the parsed documents.
  assert_eq(@json.parse(round_trip), @json.parse(ast))
  runner.command(["ast", "peers.smithy", "--output", "peers-ast.json"], 0) |> ignore
  runner.command(["validate", "peers-ast.json"], 0) |> ignore
  let (same, _) = runner.command(["diff", "--old", "peers.smithy", "--new", "peers.smithy"], 0)
  assert_eq(same, "")
  let (same_json, _) = runner.command(["diff", "--old", "peers-ast.json", "--new", "peers.smithy"], 0)
  assert_eq(same_json, "")
  // A projection with imports loads its model again from the JSON AST.
  @fs.write_file(
    dir + "/peers-extra.smithy",
    "$version: \"2\"\nnamespace example.extra\n\nuse smithy.rpc#method\n\n@method(name: \"extra\", params: \"named\", nullResult: true)\noperation Extra {}\n",
  )
  @fs.write_file(
    dir + "/peers-build.json",
    "{\"version\":\"1.0\",\"sources\":[\"peers.smithy\"],\"outputDirectory\":\"peers-build\",\"projections\":{\"peers\":{\"imports\":[\"peers-extra.smithy\"],\"plugins\":{\"openrpc\":{\"service\":\"example.peers#LanguageServer\"}}}}}",
  )
  runner.command(["build", "--config", "peers-build.json"], 0) |> ignore
  let document = @fs.read_file(dir + "/peers-build/peers/openrpc/openrpc.json").text()
  assert_true(document.contains("textDocument/hover"), msg=document)
  let projected = @fs.read_file(dir + "/peers-build/peers/model/model.json").text()
  check_ast(projected)
  assert_true(projected.contains("example.extra#Extra"))
  runner.command(["clean", "--config", "peers-build.json"], 0) |> ignore
  // A model that defines a bundled trait again gets the built-in diagnostic.
  @fs.write_file(
    dir + "/own-rpc.smithy",
    "$version: \"2\"\nnamespace smithy.rpc\n\n@trait(selector: \"service\")\nstructure jsonRpc { other: String }\n",
  )
  let (own_out, own_err) = runner.command(["validate", "own-rpc.smithy"], 1)
  let own = own_out + own_err
  assert_true(own.contains("I cannot redefine the built-in shape smithy.rpc#jsonRpc."), msg=own)
}

///|
/// A documentation comment that documents nothing is Smithy's
/// Model.BadDocumentationComment warning, with no shape, in `validate`. `build`
/// shows the warning while it loads the model. Its build report has no such
/// event, as in Smithy, which validates the loaded model again for the report.
async fn exercise_bad_doc_comment(runner : Runner) -> Unit {
  let dir = runner.dir
  @fs.write_file(
    dir + "/docs.smithy",
    "$version: \"2\"\nnamespace example\n\n@sensitive\n/// The name.\nstring Name\n",
  )
  let (out, err) = runner.command(["validate", "docs.smithy"], 0)
  let shown = (out + err).trim_end().to_owned()
  assert_true(shown.has_prefix("[WARNING] -: "), msg=shown)
  assert_true(shown.has_suffix(" | Model.BadDocumentationComment"), msg=shown)
  assert_eq(shown.split("\n").count(), 1)
  @fs.write_file(
    dir + "/docs-build.json",
    "{\"version\":\"1.0\",\"sources\":[\"docs.smithy\"],\"outputDirectory\":\"docs-build\"}",
  )
  let (build_out, build_err) = runner.command(["build", "--config", "docs-build.json"], 0)
  let build_shown = build_out + build_err
  assert_true(build_shown.contains("warning[SM-PARSE-009]"), msg=build_shown)
  let info = @json.parse(
    @fs.read_file(dir + "/docs-build/source/build-info/smithy-build-info.json").text(),
  )
  guard info is { "validationEvents": Array(events), .. } else {
    fail("no validationEvents in the build report")
  }
  assert_true(
    !events.iter().any(e => e is { "id": String("Model.BadDocumentationComment"), .. }),
    msg=info.stringify(),
  )
  runner.command(["clean", "--config", "docs-build.json"], 0) |> ignore
  // Smithy reports no event for a doc comment before `apply`; the CLI still
  // shows the hint where it prints diagnostics.
  @fs.write_file(
    dir + "/apply-docs.smithy",
    "$version: \"2\"\nnamespace example\n\nstring Name\n\n/// Ignored.\napply Name @sensitive\n",
  )
  let (validate_out, validate_err) = runner.command(["validate", "apply-docs.smithy"], 0)
  assert_eq((validate_out + validate_err).trim_end(), "")
  let (ast_out, ast_err) = runner.command(["ast", "apply-docs.smithy"], 0)
  assert_true((ast_out + ast_err).contains("warning[SM-PARSE-008]"), msg=ast_err)
}

///|
/// The README files whose `console` and `LANG file=NAME` fences run. Keep it equal to
/// `@source.cli_doc_files` in site/tour/source/include.mbt.
let readme_files : Array[String] = ["apps/smithy/README.md"]

///|
priv struct DocCommand {
  args : Array[String]
  output : String
  status : Int32
} derive(Eq, Debug)

///|
priv enum DocStep {
  Fixture(name~ : String, text~ : String)
  Session(Array[DocCommand])
} derive(Eq, Debug)

///|
/// Words of a command line; a single-quoted word keeps its spaces.
fn shell_words(line : String) -> Result[Array[String], String] {
  let words : Array[String] = []
  let word = StringBuilder()
  let mut started = false
  let mut quoted = false
  for c in line {
    if quoted {
      if c == '\'' {
        quoted = false
      } else {
        word.write_char(c)
      }
      continue
    }
    match c {
      '\'' => {
        quoted = true
        started = true
      }
      ' ' =>
        if started {
          words.push(word.to_string())
          word.reset()
          started = false
        }
      '|' | '>' | '<' | ';' | '&' | '"' | '`' | '$' | '\\' =>
        return Err("I cannot run the shell character \{c} in `\{line}`.")
      _ => {
        word.write_char(c)
        started = true
      }
    }
  }
  if quoted {
    return Err("I found an unclosed quote in `\{line}`.")
  }
  if started {
    words.push(word.to_string())
  }
  Ok(words)
}

///|
fn doc_fixture_name(info : String) -> Result[String?, String] {
  for word in info.split(" ") {
    let word = word.to_owned()
    if word.has_prefix("file=") {
      let name = word[5:].to_owned()
      let plain = !name.is_empty() &&
        name != "." &&
        name != ".." &&
        name.iter().all(c => {
          (c is ('a'..='z') || c is ('A'..='Z') || c is ('0'..='9')) || c == '.' || c == '_' || c == '-'
        })
      guard plain else {
        return Err(
          "I expected a plain file name after file= and found `\{name}`.",
        )
      }
      return Ok(Some(name))
    }
  }
  Ok(None)
}

///|
/// True when an argument names an absolute path, or has a `..` segment, so it could leave the scratch folder.
fn doc_path_leaves(word : String) -> Bool {
  let drive = word.length() >= 2 && word[1] == ':'
  word.has_prefix("/") ||
  word.has_prefix("\\") ||
  drive ||
  word.split("/").any(part => part.split("\\").any(seg => seg == ".."))
}

///|
/// True when an info string names a console fence: `console`, alone or followed by a character
/// that is not a letter, digit, `_` or `-` (a space, a tab). Such a fence runs, or is an error.
fn is_console_info(info : String) -> Bool {
  guard info.has_prefix("console") else { return false }
  if info.length() == 7 {
    return true
  }
  let c = info[7]
  let word = (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '_' ||
    c == '-'
  !word
}

///|
/// The exit status that a console fence expects, from its info string. The info string is exactly
/// `console`, with status 0, or `console status=N` with N from 1 to 125 in plain digits (no sign, no
/// leading zero). Any other info word is an error, so no fence is skipped or read in two ways.
/// `@source.tested_snippet` in site/tour/source/include.mbt must use the same rule.
fn doc_console_status(info : String) -> Result[Int32, String] {
  if info == "console" {
    return Ok(0)
  }
  let found = "I expected `console` or `console status=N` with N from 1 to 125 and found `\{info}`."
  guard info.has_prefix("console status=") else { return Err(found) }
  let digits : String = info[15:].to_owned()
  if digits.is_empty() ||
    digits.length() > 3 ||
    digits[0] == '0' ||
    !digits.iter().all(c => c >= '0' && c <= '9') {
    return Err(found)
  }
  let n = @string.parse_int(digits) catch { _ => 0 }
  if n < 1 || n > 125 {
    return Err(found)
  }
  Ok(n)
}

///|
fn doc_session(
  body : Array[String],
  status~ : Int32,
) -> Result[DocStep, String] {
  let commands : Array[DocCommand] = []
  let mut args : Array[String]? = None
  let mut output : Array[String] = []
  fn finish(
    commands : Array[DocCommand],
    args : Array[String]?,
    output : Array[String],
  ) -> Unit {
    if args is Some(args) {
      let text = if output.is_empty() { "" } else { output.join("\n") + "\n" }
      commands.push({ args, output: text, status })
    }
  }

  for line in body {
    if line.has_prefix("$ ") {
      finish(commands, args, output)
      let words = match shell_words(line[2:].to_owned()) {
        Ok(words) => words
        Err(msg) => return Err(msg)
      }
      guard words.length() > 0 && words[0] == "smithy" else {
        return Err("I can run only a smithy command and found `\{line}`.")
      }
      for word in words[1:] {
        if doc_path_leaves(word) {
          return Err(
            "I cannot run an argument that is an absolute path or has a .. segment: `\{word}` in `\{line}`.",
          )
        }
      }
      args = Some(words[1:].to_owned())
      output = []
    } else {
      guard args is Some(_) else {
        return Err("I found output before the first command: `\{line}`.")
      }
      output.push(line)
    }
  }
  finish(commands, args, output)
  if commands.is_empty() {
    return Err("I found a console block with no command.")
  }
  Ok(Session(commands))
}

///|
/// The fixture and console fences of `markdown`, in order. Other fences are skipped.
///
/// THE RULE (`@source` in site/tour/source/include.mbt must use the same one):
/// - A fence starts at the start of a line with three or more backticks. The info string is the rest of
///   the line. A fence closes at the first line of at least as many backticks, after up to 3 spaces (as in
///   CommonMark) and with only spaces or tabs after.
/// - A console fence is a fence whose first info word is `console`, whatever words follow. Every
///   command of it runs, and a console fence with no command is an error. The info word `status=N`
///   (N from 1 to 125) makes each command exit with N; the lines after a command are then its stdout
///   followed by its stderr. Without it each command exits 0 and writes nothing to stderr.
/// - A fixture fence is a fence with an info word `file=NAME`. Its text is written to NAME.
/// - A fence that starts with spaces or tabs, or with `~~~`, and that would be a console or fixture fence,
///   is an error: I cannot tell whether a test runs it. I never skip it in silence.
/// - Every other fence is skipped.
fn doc_steps(markdown : String) -> Result[Array[DocStep], String] {
  let lines = markdown
    .split("\n")
    .map(l => l.trim_end(chars="\r").to_owned())
    .collect()
  let steps : Array[DocStep] = []
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    i += 1
    let first = line.trim_start().to_owned()
    if !line.has_prefix("```") {
      if (first.has_prefix("```") || first.has_prefix("~~~")) &&
        (is_console_info(first.trim_start(chars="`~").trim().to_owned()) ||
        first.contains(" file=")) {
        return Err(
          "I found a console or file= fence that does not start at the start of a line: `\{line}`. I cannot tell whether a test runs it.",
        )
      }
      continue
    }
    let mut ticks = 0
    while ticks < line.length() && line[ticks] == '`' {
      ticks += 1
    }
    let info = line[ticks:].trim().to_owned()
    let body : Array[String] = []
    let mut closed = false
    while i < lines.length() {
      let inner = lines[i]
      i += 1
      let indent = inner.iter().take(4).take_while(c => c == ' ').count()
      let inner_ticks = inner[indent:].iter().take_while(c => c == '`').count()
      let tail = inner[indent + inner_ticks:].trim(chars=" \t")
      if indent <= 3 && inner_ticks >= ticks && tail.is_empty() {
        closed = true
        break
      }
      body.push(inner)
    }
    guard closed else {
      return Err("I found a fence that never closes: `\{line}`.")
    }
    if is_console_info(info) {
      let status = match doc_console_status(info) {
        Ok(status) => status
        Err(msg) => return Err(msg)
      }
      match doc_session(body, status~) {
        Ok(step) => steps.push(step)
        Err(msg) => return Err(msg)
      }
    } else {
      match doc_fixture_name(info) {
        Ok(Some(name)) => {
          let text = if body.is_empty() { "" } else { body.join("\n") + "\n" }
          steps.push(Fixture(name~, text~))
        }
        Ok(None) => ()
        Err(msg) => return Err(msg)
      }
    }
  }
  Ok(steps)
}

///|
/// Writes each fixture into a fresh `<runner.dir>/readme` and runs each command there.
async fn check_readme(runner : Runner, root : String) -> Unit {
  for file in readme_files {
    check_readme_text(runner, file, @fs.read_file("\{root}/\{file}").text())
  }
}

///|
/// Runs the fences of one README text; `file` names it in the messages.
async fn check_readme_text(
  runner : Runner,
  file : String,
  text : String,
) -> Unit {
  let dir = "\{runner.dir}/readme"
  let scratch = { ..runner, dir }
  let steps = match doc_steps(text) {
    Ok(steps) => steps
    Err(msg) => fail("\{file}: \{msg}")
  }
  if @fs.exists(dir) {
    @fs.rmdir(dir, recursive=true)
  }
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  let mut ran = 0
  for step in steps {
    match step {
      Fixture(name~, text~) => @fs.write_file("\{dir}/\{name}", text)
      Session(commands) => {
        for command in commands {
          ran += 1
          let (out, err) = scratch.command(command.args, command.status)
          if command.status == 0 {
            assert_eq(
              err,
              "",
              msg="\{file}: smithy \{command.args.join(" ")} wrote to stderr",
            )
            assert_eq(
              out,
              command.output,
              msg="\{file}: smithy \{command.args.join(" ")}\nthe README shows:\n\{command.output}\nthe command wrote:\n\{out}",
            )
          } else {
            // wasm-gc writes eprintln to stdout, so stdout then stderr is the same text on every target.
            let text = out + err.replace_all(old="\r\n", new="\n")
            assert_eq(
              text,
              command.output,
              msg="\{file}: smithy \{command.args.join(" ")} (status \{command.status})\nthe README shows:\n\{command.output}\nthe command wrote:\n\{text}",
            )
          }
        }
      }
    }
  }
  if ran == 0 {
    fail("I found no console block in \{file}")
  }
}

///|
/// The non-zero status branch of `check_readme_text`: a README that shows the failure of a command
/// passes; a README that expects a status the command does not give, or other text, fails.
async fn check_readme_status(runner : Runner) -> Unit {
  let model = "```smithy file=bad.smithy\n$version: \"2\"\nnamespace x\nstructure A { b: Missing }\n```\n\n"
  let shown = "[ERROR] x#A$b: I could not resolve shape x#Missing, referenced by x#A$b. | Target.UnresolvedShape\n"
  let good = model +
    "```console status=1\n$ smithy validate bad.smithy\n\{shown}```\n"
  check_readme_text(runner, "status-good.md", good)
  let cases = [
    // The command exits 1, and the README expects 0 (a plain fence).
    ("status-plain.md", model + "```console\n$ smithy validate bad.smithy\n```\n", "validate bad.smithy"),
    // The command exits 0, and the README expects 1.
    ("status-zero.md", "```console status=1\n$ smithy version\n```\n", "version"),
    // The status is right and the text is not.
    (
      "status-text.md",
      model + "```console status=1\n$ smithy validate bad.smithy\n[ERROR] other\n```\n",
      "(status 1)\nthe README shows:\n[ERROR] other\n",
    ),
  ]
  for c in cases {
    let (name, text, want) = c
    let failed = try {
      check_readme_text(runner, name, text)
      None
    } catch {
      e => Some(e.to_string())
    }
    match failed {
      Some(msg) => assert_true(msg.contains(want), msg="\{name}: \{msg} lacks \{want}")
      None => fail("\{name}: the check passed, and I expected it to fail")
    }
  }
}

///|
/// The cases of `site/playground/cli_check/cli-cases.json`: each runs in its own
/// directory, and the lines it prints (stdout, then stderr) are the lines that
/// the playground core must give for the same input.
async fn exercise_engine_cases(runner : Runner, root : String) -> Unit {
  let cases = @json.parse(
    @fs.read_file("\{root}/site/playground/cli_check/cli-cases.json").text(),
  )
  guard cases is { "cases": Array(cases), .. } else {
    fail("cli-cases.json must have a cases array")
  }
  // The ids that the file must hold: a case lost in a merge fails here.
  let expected_ids = ["value-consumer-valid", "value-consumer-invalid", "value-unknown-reject", "value-unknown-ignore", "value-json-names", "value-member-target", "value-not-json", "value-duplicate-key", "value-missing-target", "value-invalid-model", "value-unsupported-pattern", "value-unsupported-timestamp", "value-json-limit", "rpc-call", "rpc-invalid", "rpc-reply", "rpc-error", "rpc-reply-no-context", "rpc-not-json", "rpc-missing-service", "rpc-legacy-call", "rpc-legacy-error", "rpc-legacy-opaque", "rpc-legacy-version-2", "rpc-envelope-only", "rpc-unknown-reject", "rpc-unknown-ignore", "diff-constraints-added", "diff-removed-shape"]
  let seen : Array[String] = []
  for item in cases {
    guard item is { "id": String(id), .. } else {
      fail("a case needs an id: \{item.stringify()}")
    }
    assert_false(seen.contains(id), msg="duplicate case id \{id}")
    seen.push(id)
  }
  assert_true(!cases.is_empty(), msg="cli-cases.json has no case")
  assert_eq(seen, expected_ids)
  for item in cases {
    guard item
      is {
        "id": String(id),
        "args": Array(args),
        "files": Array(files),
        "status": Number(status, ..),
        "lines": Array(lines),
        ..
      } else {
      fail("a case needs id, args, files, status and lines: \{item.stringify()}")
    }
    let dir = "\{runner.dir}/engine/\{id}"
    @fs.mkdir(dir, recursive=true, allow_exist=true)
    for file in files {
      guard file is { "name": String(name), .. } else {
        fail("\{id}: a file needs a name")
      }
      let text = match file {
        { "text": _, "from": _, .. } =>
          fail("\{id}: file \{name} needs exactly one of text and from")
        { "text": String(text), .. } => text
        { "from": String(from), .. } =>
          @fs.read_file("\{root}/\{from}").text()
        _ => fail("\{id}: file \{name} needs exactly one of text and from")
      }
      @fs.write_file("\{dir}/\{name}", text)
    }
    let args = args.map(arg => {
      guard arg is String(arg) else { fail("\{id}: an argument must be a string") }
      arg
    })
    let (out, err) = { ..runner, dir, }.command(args, status.to_int())
    let printed : Array[Json] = []
    for line in (out + err).replace_all(old="\r\n", new="\n").split("\n") {
      let line = line.to_owned()
      if !line.is_empty() {
        printed.push(Json::string(line))
      }
    }
    let expected = Json::array(lines).stringify()
    let got = Json::array(printed).stringify()
    assert_eq(got, expected, msg="\{id}: the CLI printed \{got} but the case has \{expected}")
  }
}

///|
/// The pairs of `tests/tck/diff/events.json` that have files (the 21 mutation
/// cases have none): the lines that `smithy diff` prints for each pair, sorted,
/// are the corpus events without SUPPRESSED, and the status is 1 when the pair
/// is breaking. With `all` false, only the first 5 pairs run.
async fn exercise_diff_corpus(runner : Runner, root : String, all~ : Bool) -> Unit {
  let corpus = "\{root}/tests/tck/diff"
  guard @json.parse(@fs.read_file("\{corpus}/events.json").text())
    is { "cases": Array(cases), .. } else {
    fail("events.json must have a cases array")
  }
  let mut ran = 0
  for item in cases {
    if item is { "mutations": _, .. } {
      continue
    }
    if !all && ran >= 5 {
      break
    }
    guard item
      is {
        "old": String(old),
        "new": String(new),
        "breaking": breaking,
        "events": Array(events),
        ..
      } else {
      fail("a corpus case needs old, new, breaking and events")
    }
    let expected : Array[String] = []
    for event in events {
      guard event
        is {
          "id": String(id),
          "shape": String(shape),
          "severity": String(severity),
          "message": String(message),
          ..
        } else {
        fail("\{old}: an event needs id, shape, severity and message")
      }
      if severity != "SUPPRESSED" {
        let escaped = message
          .replace_all(old="\r\n", new="\n")
          .replace_all(old="\n", new="\\n")
        expected.push("[" + severity + "] " + shape + ": " + escaped + " | " + id)
      }
    }
    let status : Int32 = if breaking is True { 1 } else { 0 }
    let (out, _) = runner.command(
      ["diff", "--old", "\{corpus}/\{old}", "--new", "\{corpus}/\{new}"],
      status,
    )
    let printed : Array[String] = []
    for line in out.split("\n") {
      let line = line.to_owned()
      if !line.is_empty() {
        printed.push(line)
      }
    }
    printed.sort_by((a, b) => a.lexical_compare(b))
    expected.sort_by((a, b) => a.lexical_compare(b))
    assert_eq(
      Json::array(printed.map(Json::string)).stringify(),
      Json::array(expected.map(Json::string)).stringify(),
      msg="\{runner.target}: \{old}",
    )
    ran += 1
  }
  assert_true(ran >= 5, msg="the corpus ran \{ran} pairs")
  if all {
    assert_eq(ran, 67)
  }
}

///|
async fn exercise(
  root : String,
  target : String,
  skip_stdin~ : Bool = false,
) -> Unit {
  let (code, _, err) = @process.collect_output(
    "moon",
    ["build", "apps/smithy", "--target", target, "--release", "--deny-warn"],
    cwd=root,
  )
  guard code == 0 else { fail("CLI build failed: \{err.text()}") }
  let stem = "\{root}/_build/\{target}/release/build/moonrockz/smithy-cli/smithy-cli"
  let suffix = if skip_stdin { "-files" } else { "" }
  let dir = "\{root}/.dev/out/cli-tests/\{target}\{suffix}"
  if @fs.exists(dir) {
    @fs.rmdir(dir, recursive=true)
  }
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  let executable = if target == "native" {
    stem + ".exe"
  } else if target == "js" {
    "node"
  } else {
    "moonrun"
  }
  let prefix = if target == "native" {
    []
  } else if target == "js" {
    [stem + ".js"]
  } else {
    [stem + ".wasm", "--"]
  }
  let runner : Runner = { target, executable, prefix, dir, }
  let input = "$version: \"2\"\nmetadata values = [9007199254740993]\nnamespace example\n// comment\nstructure  Example {\nname : String\n}\n"
  @fs.write_file("\{dir}/input.smithy", input)
  exercise_landing_sample(runner, root)
  exercise_rpc(runner, root, skip_stdin)
  exercise_rpc_traits(runner, root)
  exercise_engine_cases(runner, root)
  exercise_rpc_responses(runner, root, skip_stdin)
  exercise_rpc_batches(runner, root, skip_stdin)
  exercise_rpc_transcripts(runner, root, skip_stdin)
  exercise_rpc_log_streams(runner, root, skip_stdin)
  exercise_rpc_log_files(runner, root)
  exercise_ion(runner, skip_stdin)
  exercise_bad_doc_comment(runner)
  @fs.write_file(
    "\{dir}/broken.smithy",
    "$version: \"2\"\nnamespace example\nstructure Broken { x: Missing }",
  )
  @fs.write_file("\{dir}/syntax.smithy", "structure {")
  // Model diff loads snapshots independently and reports one event per line.
  let changed_input = input.replace_all(old="name : String", new="name : Integer")
  @fs.write_file("\{dir}/changed.smithy", changed_input)
  let (unchanged_diff, _) = runner.command(["diff", "--old", "input.smithy", "--new", "input.smithy"], 0)
  assert_eq(unchanged_diff, "")
  let (breaking_diff, _) = runner.command(["diff", "--old", "input.smithy", "--new", "changed.smithy"], 1)
  assert_true(breaking_diff.contains("[ERROR] example#Example$name:") && breaking_diff.contains("| ChangedMemberTarget"))
  assert_eq(breaking_diff.trim_end().to_owned().split("\n").count(), 1)
  ignore(runner.command(["diff", "--old", "input.smithy", "--new", "changed.smithy", "--output", "changes.txt"], 1))
  assert_eq(@fs.read_file("\{dir}/changes.txt").text(), breaking_diff)
  ignore(runner.command(["diff", "--old", "broken.smithy", "--new", "input.smithy"], 1))
  ignore(runner.command(["diff", "--old", "missing.smithy", "--new", "input.smithy"], 1))
  ignore(runner.command(["diff", "--old", "input.smithy"], 2))
  @fs.mkdir("\{dir}/old-models", allow_exist=true)
  @fs.mkdir("\{dir}/new-models", allow_exist=true)
  @fs.write_file("\{dir}/old-models/model.smithy", input)
  @fs.write_file("\{dir}/new-models/model.smithy", changed_input)
  let (directory_diff, _) = runner.command(["diff", "--old", "old-models", "--new", "new-models"], 1)
  assert_eq(directory_diff, breaking_diff)
  ignore(runner.command(["ast", "input.smithy", "--output", "old-ast.json"], 0))
  let (json_diff, _) = runner.command(["diff", "--old", "old-ast.json", "--new", "input.smithy"], 0)
  assert_eq(json_diff, "")
  exercise_diff_jsonl(runner, root)
  exercise_diff_corpus(runner, root, all=target == "native")
  let (version, _) = runner.command(["version"], 0)
  assert_true(version.has_prefix("smithy "))
  let (help, _) = runner.command(["--help"], 0)
  assert_true(help.contains("Usage: smithy") && help.contains("Commands:"))
  assert_false(help.contains("validate-value"))
  for args in [[], ["help"], ["-h"]] {
    let (out, _) = runner.command(args, 0)
    assert_eq(out, help)
  }
  for command in [
    "ast", "validate", "select", "diff", "format", "convert", "build", "clean", "version",
  ] {
    let (help, _) = runner.command([command, "--help"], 0)
    assert_true(help.contains("Usage: smithy \{command}"))
    for args in [[command, "-h"], ["help", command]] {
      let (out, _) = runner.command(args, 0)
      assert_eq(out, help)
    }
    assert_eq(help.contains("--to"), command == "convert")
    assert_eq(help.contains("--selector"), command == "select")
    assert_eq(help.contains("--check"), command == "format")
    assert_eq(help.contains("--format"), command == "diff")
    if command == "diff" {
      assert_true(help.contains("jsonl") && help.contains("flushes"))
      assert_false(help.contains("--stream"))
    }
  }
  for args in [["validate", "value", "--help"], ["validate", "value", "-h"], ["help", "validate", "value"]] {
    let (help, _) = runner.command(args, 0)
    assert_true(help.contains("Usage: smithy validate value") && help.contains("--shape") && help.contains("--value"))
    assert_false(help.contains("--service"))
  }
  runner.command(["validate-value"], 2) |> ignore
  let value_model = "$version: \"2\"\nnamespace example\n@range(min: 1, max: 100)\ninteger Count\nstructure Input { @required count: Count }\n"
  let protocol_model = @fs.read_file(root + "/examples/protocol-tests/greeting.smithy").text()
  @fs.write_file(runner.dir + "/protocol.smithy", protocol_model)
  runner.command(["validate", "--protocol-tests", "protocol.smithy"], 0) |> ignore
  for (source, finding) in [
    (protocol_model.replace_all(old="params: {name: \"Ada\"}", new="params: {name: 1}"), "HttpRequestTestsInput"),
    (protocol_model.replace_all(old="id: \"GreetingRequest\"", new="id: \"GreetingRequest\"\n    appliesTo: \"both\""), "TraitValue"),
    (protocol_model + "\n@smithy.test#httpRequestTests([{id: \"GreetingRequest\", protocol: fixtureProtocol, method: \"GET\", uri: \"/\"}])\noperation Other {}\n", "UniqueProtocolTestCaseId"),
  ] {
    @fs.write_file(runner.dir + "/protocol-invalid.smithy",source)
    let (out, err) = runner.command(["validate", "--protocol-tests", "protocol-invalid.smithy"], 1)
    assert_true((out + err).contains(finding),msg=out+err)
  }
  @fs.write_file("\{dir}/value-model.smithy", value_model)
  let value_args = ["validate", "value", "--shape", "example#Input", "--value", "value.json", "value-model.smithy"]
  runner.command(["validate", "--from", "json", "value"] + value_args[2:].to_owned(), 2) |> ignore
  runner.command(["validate", "value-model.smithy", "value"] + value_args[2:].to_owned(), 2) |> ignore
  for (text, expected_code, finding) in [
    ("{\"count\":2}", 0, ""),
    ("{\"count\":0}", 1, "Range"),
    ("{}", 1, "RequiredMember"),
    ("{\"count\":null}", 1, "TypeMismatch"),
    ("{\"count\":\"2\"}", 1, "TypeMismatch"),
    ("{\"count\":2,\"extra\":1}", 1, "UnknownMember"),
    ("{\"count\":1,\"count\":2}", 1, "DuplicateJsonKey"),
    ("{", 1, "InvalidJson"),
  ] {
    @fs.write_file("\{dir}/value.json", text)
    let (out, err) = runner.command(value_args, expected_code)
    if expected_code == 0 { assert_eq(out + err, "") } else { assert_true((out + err).contains(finding), msg=out + err) }
    let (out, _) = runner.command(value_args + ["--diagnostics", "json"], expected_code)
    guard @json.parse(out) is Object(result) else { fail("Expected structured value result") }
    assert_eq(result.get("valid"), Some(Json::boolean(expected_code == 0)))
    if finding == "Range" {
      guard result.get("findings") is Some(Array([Object(first), ..])) else { fail("Expected range finding") }
      assert_eq(first.get("code"), Some(Json::string("Range")))
      assert_eq(first.get("pointer"), Some(Json::string("/count")))
      assert_eq(first.get("shape"), Some(Json::string("example#Input$count")))
    }
    assert_eq(@fs.read_file("\{dir}/value.json").text(), text)
  }
  @fs.write_file("\{dir}/value.json", "{\"count\":2}")
  @fs.write_file("\{dir}/timestamp.smithy", "$version: \"2\"\nnamespace example\n@timestampFormat(\"date-time\")\ntimestamp Time\nstructure Input { @required at: Time }\n")
  let timestamp_args = ["validate", "value", "--shape", "example#Input", "--value", "timestamp.json", "timestamp.smithy"]
  for (text, expected_code) in [
    ("2016-12-31T23:59:60Z", 0),
    ("2017-01-01T05:29:60.5+05:30", 0),
    ("2016-12-31T23:59:60+01:00", 1),
    ("2017-12-31T23:59:60Z", 1),
  ] {
    @fs.write_file("\{dir}/timestamp.json", "{\"at\":\"" + text + "\"}")
    let (out, err) = runner.command(timestamp_args, expected_code)
    if expected_code == 0 { assert_eq(out + err, "") } else { assert_true((out + err).contains("InvalidTimestamp")) }
    let (out, err) = runner.command(timestamp_args + ["--diagnostics", "json"], expected_code)
    assert_eq(err, "")
    guard @json.parse(out) is Object(result) else { fail("Expected timestamp diagnostics") }
    assert_eq(result.get("valid"), Some(Json::boolean(expected_code == 0)))
    assert_eq(result.get("complete"), Some(Json::boolean(true)))
    if expected_code == 0 { assert_eq(result.get("findings"), Some(Json::array([]))) } else {
      guard result.get("findings") is Some(Array([Object(finding)])) else { fail("Expected one timestamp finding") }
      assert_eq(finding.get("code"), Some(Json::string("InvalidTimestamp")))
      assert_eq(finding.get("pointer"), Some(Json::string("/at")))
      assert_eq(finding.get("shape"), Some(Json::string("example#Input$at")))
    }
  }
  runner.command(["validate", "value", "--shape", "example#Missing", "--value", "value.json", "value-model.smithy"], 2) |> ignore
  runner.command(["validate", "value", "--shape", "not-an-id", "--value", "value.json", "value-model.smithy"], 2) |> ignore
  runner.command(["validate", "value", "--shape", "example#Input", "value-model.smithy"], 2) |> ignore
  runner.command(value_args + ["--diagnostics", "xml"], 2) |> ignore
  runner.command(["validate", "value", "--shape", "example#Input", "--value", "missing.json", "value-model.smithy"], 1) |> ignore
  if !skip_stdin && (target != "wasm-gc" || @env.get_env_var("OS") != Some("Windows_NT")) {
    runner.command(["validate", "value", "--shape", "example#Input", "--value", "-", "value-model.smithy"], 0, input="{\"count\":2}") |> ignore
    runner.command(["validate", "value", "--shape", "example#Input", "--value", "value.json", "--from", "idl", "-"], 0, input=value_model) |> ignore
  }
  runner.command(["validate", "value", "--shape", "example#Input", "--value", "-", "--from", "idl", "-"], 2) |> ignore
  @fs.write_file("\{dir}/precise.smithy", "$version: \"2\"\nnamespace example\n@range(min: 0.10000000000000000001)\nbigDecimal Precise\n")
  @fs.write_file("\{dir}/precise.json", "0.10000000000000000000")
  runner.command(["validate", "value", "--shape", "example#Precise", "--value", "precise.json", "precise.smithy"], 1) |> ignore
  assert_eq(@fs.read_file("\{dir}/value-model.smithy").text(), value_model)
  let (invalid_model, _) = runner.command(["validate", "value", "--shape", "example#Broken", "--value", "value.json", "--diagnostics", "json", "broken.smithy"], 1)
  guard @json.parse(invalid_model) is Object(model_result) && model_result.get("findings") is Some(Array([Object(model_finding), ..])) else { fail("Expected model diagnostics") }
  assert_eq(model_finding.get("source"), Some(Json::string("broken.smithy")))
  let (missing_model, missing_model_err) = runner.command(["validate", "value", "--shape", "example#Input", "--value", "value.json", "--diagnostics", "json", "missing.smithy"], 1)
  guard @json.parse(missing_model) is Object(missing_result) && missing_result.get("findings") is Some(Array([Object(missing_finding), ..])) else { fail("Expected structured model read diagnostics") }
  assert_eq(missing_finding.get("source"), Some(Json::string("missing.smithy")))
  assert_eq(missing_finding.get("code"), Some(Json::string("InputRead")))
  assert_eq(missing_model_err, "")
  for (configuration, severity) in [("selector: \"structure\"", "DANGER"), ("selector: \"[\"", "ERROR")] {
    @fs.write_file("\{dir}/value-invalid-event.smithy", "$version: \"2\"\nmetadata validators = [{name: \"EmitEachSelector\", configuration: {" + configuration + "}}]\nnamespace example\nstructure Input {}\n")
    @fs.write_file("\{dir}/value-empty.json", "{}")
    let (event_out, event_err) = runner.command(["validate", "value", "--shape", "example#Input", "--value", "value-empty.json", "--diagnostics", "json", "value-invalid-event.smithy"], 1)
    guard @json.parse(event_out) is Object(event_result) && event_result.get("findings") is Some(Array([Object(event_finding), ..])) else { fail("Expected model validation event") }
    assert_eq(event_finding.get("severity"), Some(Json::string(severity)))
    assert_eq(event_result.get("valid"), Some(Json::boolean(false)))
    assert_eq(event_err, "")
  }
  let (out, _) = runner.command(["convert", "missing.smithy", "--help"], 0)
  assert_true(out.contains("Usage: smithy convert"))
  runner.command(["help", "unknown"], 2) |> ignore
  runner.command(["version", "unexpected"], 2) |> ignore
  let (flag_version, _) = runner.command(["--version"], 0)
  assert_eq(flag_version, version)
  runner.command(["unknown"], 2) |> ignore
  let (out, err) = runner.command(["convert", "input.smithy"], 2)
  assert_true((out + err).contains("Usage: smithy convert"))
  runner.command(["ast", "missing.smithy"], 1) |> ignore
  let (out, stderr) = runner.command(["validate", "broken.smithy"], 1)
  let err = if target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("[ERROR] example#Broken$x:") && err.contains(" | Target.UnresolvedShape"))
  let (out, stderr) = runner.command(["ast", "broken.smithy"], 1)
  let err = if target == "wasm-gc" { out + stderr } else { stderr }
  assert_true(err.contains("SM-MODEL-004") && err.contains("broken.smithy:3:"))
  runner.command(["validate", "syntax.smithy"], 1) |> ignore
  @fs.write_file(
    "\{dir}/configured.smithy",
    "$version: \"2\"\nmetadata validators = [{name: \"EmitEachSelector\", id: \"Selected\", configuration: {selector: \"structure\"}}]\nnamespace example\nstructure Found {}\n",
  )
  let (out, stderr) = runner.command(["validate", "configured.smithy"], 1)
  let events = out + stderr
  assert_true(events.contains("[DANGER] example#Found: Selector capture matched selector: structure | Selected"))
  runner.command(["select", "input.smithy"], 2) |> ignore
  let (selected, _) = runner.command(
    ["select", "--selector", "[id|namespace=example]", "input.smithy"],
    0,
  )
  assert_eq(selected, "example#Example\nexample#Example$name\n")
  let (selected, _) = runner.command(
    [
      "select", "--selector",
      "structure[id|namespace=example]:futureFunction(*)", "input.smithy",
    ],
    0,
  )
  assert_eq(selected, "")
  let (ast, _) = runner.command(["ast", "input.smithy"], 0)
  assert_true(ast.contains("9007199254740993"))
  // Test an actual pipe, including multiple chunks and non-ASCII UTF-8.
  if !skip_stdin &&
    (target != "wasm-gc" || @env.get_env_var("OS") != Some("Windows_NT")) {
    let (piped, _) = runner.command(
      ["ast", "--from", "idl", "-"],
      0,
      input="// 🐟\n".repeat(2000) + input,
    )
    assert_eq(@json.parse(piped), @json.parse(ast))
  }
  runner.command(
    ["convert", "--to=json", "-omodel.json", "input.smithy"],
    0,
  )
  |> ignore
  runner.command(
    ["convert", "--to", "idl", "-o", "restored.smithy", "model.json"],
    0,
  )
  |> ignore
  let (roundtrip, _) = runner.command(["ast", "restored.smithy"], 0)
  assert_eq(@json.parse(roundtrip), @json.parse(ast))
  runner.command(["validate", "input.smithy", "model.json"], 0) |> ignore
  @fs.write_file(
    "\{dir}/smithy-build.json",
    "{\"version\":\"1.0\",\"sources\":[\"input.smithy\"],\"outputDirectory\":\"build-output\",\"plugins\":{\"jsonSchema\":{\"jsonSchemaVersion\":\"draft2020-12\"}},\"projections\":{\"filtered\":{\"transforms\":[{\"name\":\"excludeTraits\",\"args\":{\"traits\":[\"documentation\"]}}]}}}",
  )
  runner.command(["build"], 0) |> ignore
  assert_true(@fs.exists("\{dir}/build-output/source/model/model.json"))
  assert_true(@fs.exists("\{dir}/build-output/filtered/model/model.json"))
  assert_true(@fs.exists("\{dir}/build-output/source/build-info/smithy-build-info.json"))
  assert_true(@fs.exists("\{dir}/build-output/source/sources/input.smithy"))
  assert_true(@fs.exists("\{dir}/build-output/source/jsonSchema/schema.json"))
  assert_true(@fs.read_file("\{dir}/build-output/source/jsonSchema/schema.json")
    .text().contains("Example"))
  assert_true(@fs.read_file("\{dir}/build-output/source/jsonSchema/schema.json")
    .text().contains("\"$defs\""))
  @fs.write_file("\{dir}/smithy-build.json", "{\"version\":\"1.0\",\"sources\":[\"input.smithy\"],\"outputDirectory\":\"build-output\",\"projections\":{\"filtered\":{\"abstract\":true}}}")
  runner.command(["build"], 0) |> ignore
  assert_false(@fs.exists("\{dir}/build-output/filtered/model/model.json"))
  runner.command(["clean"], 0) |> ignore
  assert_false(@fs.exists("\{dir}/build-output"))
  @fs.write_file("\{dir}/openapi.smithy", @fs.read_file("\{root}/tests/tck/openapi/local/core-features.smithy"))
  @fs.write_file("\{dir}/openapi-build.json", (
    #|{"version":"1.0","sources":["openapi.smithy"],"outputDirectory":"openapi-output",
    #| "plugins":{"openapi::v30":{"service":"example.core#Example","onErrorStatusConflict":"oneOf"}},
    #| "projections":{"public":{"plugins":{"openapi::v31":{"service":"example.core#Example","version":"3.1.0","onErrorStatusConflict":"oneOf"}}}}}
  ))
  runner.command(["build", "--config", "openapi-build.json"], 0) |> ignore
  for (projection, plugin, golden) in [("source", "v30", "core-features"), ("public", "v31", "core-features-31")] {
    assert_eq(@json.parse(@fs.read_file("\{dir}/openapi-output/\{projection}/\{plugin}/Example.openapi.json").text()),
      @json.parse(@fs.read_file("\{root}/tests/tck/openapi/generated/\{golden}.openapi.json").text()))
  }
  @fs.write_file("\{dir}/openapi-missing.json", "{\"version\":\"1.0\",\"sources\":[\"openapi.smithy\"],\"outputDirectory\":\"openapi-missing-output\",\"plugins\":{\"openapi\":{\"service\":\"example.core#Missing\"}}}")
  let (missing_out, missing_err) = runner.command(["build", "--config", "openapi-missing.json"], 1)
  assert_true((missing_out + missing_err).contains("example.core#Missing"))
  runner.command(["clean", "--config", "openapi-build.json"], 0) |> ignore
  assert_false(@fs.exists("\{dir}/openapi-output"))
  @fs.write_file("\{dir}/prefix.smithy", (
    #|$version: "2"
    #|namespace example.prefix
    #|use aws.protocols#restJson1
    #|@restJson1
    #|service Api { version: "1", operations: [Get] }
    #|@http(method: "GET", uri: "/")
    #|operation Get { input: Input }
    #|@input
    #|structure Input { @httpPrefixHeaders("x-") headers: Headers }
    #|map Headers { key: String, value: String }
  ))
  for policy in ["FAIL", "WARN"] {
    @fs.write_file("\{dir}/prefix-build.json", "{\"version\":\"1.0\",\"sources\":[\"prefix.smithy\"],\"outputDirectory\":\"prefix-output\",\"plugins\":{\"openapi\":{\"service\":\"example.prefix#Api\",\"onHttpPrefixHeaders\":\"\{policy}\"}}}")
    let (out, err) = runner.command(["build", "--config", "prefix-build.json"], if policy == "FAIL" { 1 } else { 0 })
    assert_true((out + err).contains("httpPrefixHeaders"))
    if policy == "WARN" {
      let converted = @json.parse(@fs.read_file("\{dir}/prefix-output/source/openapi/Api.openapi.json").text())
      assert_true(converted is { "paths": { "/": { "get": { "responses": _, .. }, .. }, .. }, .. })
      assert_false(converted.stringify().contains("x-"))
    }
  }
  @fs.write_file("\{dir}/env-build.json", "{\"version\":\"2.0\",\"sources\":[\"${SMITHY_ROOT_DIR}/input.smithy\"],\"outputDirectory\":\"${SMITHY_TEST_OUTPUT}\"}")
  runner.command(["build", "--config", "env-build.json"], 0, extra_env={ "SMITHY_TEST_OUTPUT": "env-output", "SMITHY_ROOT_DIR": "invalid-override" }) |> ignore
  assert_true(@fs.exists("\{dir}/env-output/source/model/model.json"))
  @fs.write_file("\{dir}/jar-import.jar", @fs.read_file("\{root}/tests/tck/build/plugins/sources/jar-import.jar"))
  @fs.write_file("\{dir}/jar-build.json", "{\"version\":\"2.0\",\"sources\":[\"jar-import.jar\"],\"imports\":[\"input.smithy\"],\"outputDirectory\":\"jar-output\"}")
  runner.command(["build", "--config", "jar-build.json"], 0) |> ignore
  let jar_manifest = @fs.read_file("\{dir}/jar-output/source/sources/manifest").text()
  assert_eq(jar_manifest, "jar-import/a.smithy\njar-import/b/b.smithy\njar-import/b/c/c.json\n")
  for name in ["jar-import/a.smithy", "jar-import/b/b.smithy", "jar-import/b/c/c.json"] {
    assert_true(@fs.exists("\{dir}/jar-output/source/sources/\{name}"))
  }
  let jar_model = @fs.read_file("\{dir}/jar-output/source/model/model.json").text()
  for name in ["foo.baz#A", "foo.baz#B", "foo.baz#C", "example#Example"] {
    assert_true(jar_model.contains(name))
  }
  assert_false(@fs.exists("\{dir}/jar-output/source/sources/input.smithy"))
  @fs.mkdir("\{dir}/jar-models/nested", recursive=true, allow_exist=true)
  @fs.write_file("\{dir}/jar-models/nested/jar-import.jar", @fs.read_file("\{dir}/jar-import.jar"))
  @fs.write_file("\{dir}/jar-directory.json", "{\"version\":\"2.0\",\"sources\":[\"jar-models\"],\"outputDirectory\":\"jar-directory-output\"}")
  runner.command(["build", "--config", "jar-directory.json"], 0) |> ignore
  assert_eq(@fs.read_file("\{dir}/jar-directory-output/source/sources/manifest").text(), "nested/jar-import.jar/jar-import/a.smithy\nnested/jar-import.jar/jar-import/b/b.smithy\nnested/jar-import.jar/jar-import/b/c/c.json\n")
  @fs.write_file("\{dir}/jar-projection.json", "{\"version\":\"2.0\",\"sources\":[\"input.smithy\"],\"outputDirectory\":\"jar-projection-output\",\"projections\":{\"withJar\":{\"imports\":[\"jar-import.jar\"]}}}")
  runner.command(["build", "--config", "jar-projection.json"], 0) |> ignore
  assert_false(@fs.read_file("\{dir}/jar-projection-output/source/model/model.json").text().contains("foo.baz#A"))
  assert_true(@fs.read_file("\{dir}/jar-projection-output/withJar/model/model.json").text().contains("foo.baz#A"))
  @fs.write_file("\{dir}/broken.jar", b"not a ZIP")
  @fs.write_file("\{dir}/broken-jar.json", "{\"version\":\"2.0\",\"sources\":[\"broken.jar\"],\"outputDirectory\":\"broken-jar-output\"}")
  let (archive_out, archive_err) = runner.command(["build", "--config", "broken-jar.json"], 1)
  // moonrun's wasm-gc print host routes eprintln through stdout.
  let archive_error = archive_out + archive_err
  assert_true(archive_error.contains("broken.jar") && archive_error.contains("invalid-archive"))
  let broken_models = @zipc.Archive::empty()
  ignore(broken_models.add(@zipc.Member::make("META-INF/smithy/manifest", @zipc.File(@zipc.File::stored_from_bytes(b"nested/broken.smithy\n")))))
  ignore(broken_models.add(@zipc.Member::make("META-INF/smithy/nested/broken.smithy", @zipc.File(@zipc.File::stored_from_bytes(b"$version: \"2\"\nnamespace example\nstructure Broken { x: Missing }")))))
  @fs.write_file("\{dir}/broken.jar", broken_models.to_bytes())
  let (model_out, model_err) = runner.command(["build", "--config", "broken-jar.json"], 1)
  let model_error = model_out + model_err
  assert_true(model_error.contains("broken.jar!/META-INF/smithy/nested/broken.smithy"))
  @fs.write_file("\{dir}/jar-global.json", "{\"version\":\"2.0\",\"imports\":[\"jar-import.jar\"],\"outputDirectory\":\"jar-global-output\"}")
  runner.command(["build", "--config", "jar-global.json"], 0) |> ignore
  assert_true(@fs.read_file("\{dir}/jar-global-output/source/model/model.json").text().contains("foo.baz#A"))
  assert_false(@fs.exists("\{dir}/jar-global-output/source/sources/jar-import/a.smithy"))
  // The checked-in example covers directory acquisition in all three scopes.
  @fs.mkdir("\{dir}/local-example", allow_exist=true)
  for (folder, file) in [("models", "service.smithy"), ("imports", "shared.smithy"), ("projection-imports", "extra.smithy")] {
    @fs.mkdir("\{dir}/local-example/\{folder}", allow_exist=true)
    @fs.write_file("\{dir}/local-example/\{folder}/\{file}", @fs.read_file("\{root}/examples/local-resources/\{folder}/\{file}"))
  }
  let example_config = @fs.read_file("\{root}/examples/local-resources/smithy-build.json").text().replace_all(old="../../.dev/out/local-resources", new="output")
  @fs.write_file("\{dir}/local-example/smithy-build.json", example_config)
  runner.command(["build", "--config", "local-example/smithy-build.json"], 0) |> ignore
  let example_output = "\{dir}/local-example/output"
  let example_source = @fs.read_file("\{example_output}/source/model/model.json").text()
  let example_extra = @fs.read_file("\{example_output}/extra/model/model.json").text()
  assert_true(example_source.contains("example.resources#Message"))
  assert_true(example_source.contains("example.resources#SharedName"))
  assert_false(example_source.contains("example.resources#ProjectionOnly"))
  assert_true(example_extra.contains("example.resources#ProjectionOnly"))
  assert_eq(@fs.read_file("\{example_output}/source/sources/manifest").text(), "service.smithy\n")
  // Select the same module-shaped source tree and ordinary ZIP in all scopes.
  let selected_zip = @zipc.Archive::empty()
  for (folder, file) in [("models", "service.smithy"), ("imports", "shared.smithy"), ("projection-imports", "extra.smithy")] {
    let bytes = @fs.read_file("\{dir}/local-example/\{folder}/\{file}").binary()
    ignore(selected_zip.add(@zipc.Member::make("module/" + folder + "/" + file, @zipc.File(@zipc.File::deflate_from_bytes(bytes)))))
  }
  let json_bytes = @fs.read_file("\{dir}/model.json").binary()
  @fs.write_file("\{dir}/local-example/models/copy.json", json_bytes)
  ignore(selected_zip.add(@zipc.Member::make("module/models/copy.json", @zipc.File(@zipc.File::stored_from_bytes(json_bytes)))))
  // Included source code is data and is never executed by selection.
  ignore(selected_zip.add(@zipc.Member::make("module/main.mbt", @zipc.File(@zipc.File::stored_from_bytes(b"not compiled")))))
  @fs.write_file("\{dir}/module.zip", selected_zip.to_bytes())
  let npm_bytes = @fs.read_file("\{root}/examples/npm-archive/smithy-local-models-1.0.0.tgz").binary()
  @fs.write_file("\{dir}/module.tgz", npm_bytes)
  @fs.write_file("\{dir}/module.tar.gz", npm_bytes)
  @fs.write_file("\{dir}/module.tar", @gzip.gunzip(npm_bytes))
  let mut expected_models : (String, String)? = None
  for (container, prefix, tag) in [("local-example", "", "directory"), ("module.zip", "module/", "zip"), ("module.tar", "package/", "tar"), ("module.tar.gz", "package/", "tar.gz"), ("module.tgz", "package/", "tgz")] {
    let selected : Json = { "path": container, "root": prefix + "models", "paths": ["copy.json", { "path": "service.smithy", "name": "public/service.smithy" }], "globs": ["**/*.smithy"] }
    let imported : Json = { "path": container, "root": prefix + "imports", "globs": ["*.smithy"] }
    let projected : Json = { "path": container, "root": prefix + "projection-imports", "paths": ["extra.smithy"] }
    let output = "selected-" + tag
    let config : Json = { "version": "2.0", "sources": [selected], "imports": [imported], "outputDirectory": output, "projections": { "extra": { "imports": [projected] } } }
    @fs.write_file("\{dir}/selected.json", config.stringify())
    runner.command(["build", "--config", "selected.json"], 0) |> ignore
    let source = @fs.read_file("\{dir}/\{output}/source/model/model.json").text()
    let extra = @fs.read_file("\{dir}/\{output}/extra/model/model.json").text()
    assert_true(source.contains("example.resources#Message") && source.contains("example.resources#SharedName"))
    assert_true(source.contains("example#Example"))
    assert_false(source.contains("example.resources#ProjectionOnly"))
    assert_true(extra.contains("example.resources#ProjectionOnly"))
    match expected_models {
      None => expected_models = Some((source, extra))
      Some((expected_source, expected_extra)) => {
        assert_eq(source, expected_source)
        assert_eq(extra, expected_extra)
      }
    }
    assert_eq(@fs.read_file("\{dir}/\{output}/source/sources/manifest").text(), "copy.json\nservice.smithy\npublic/service.smithy\n")
    assert_false(@fs.exists("\{dir}/\{output}/source/sources/shared.smithy"))
    // Invalid model diagnostics use the physical source rather than its alias.
    let physical = if tag != "directory" { container + "!/" + prefix + "models/service.smithy" } else { "local-example" + (if @env.get_env_var("OS") == Some("Windows_NT") { "\\models\\service.smithy" } else { "/models/service.smithy" }) }
    // Omitting global imports leaves SharedName unresolved at that physical path.
    let broken : Json = { "version": "2.0", "sources": [selected], "outputDirectory": "selected-broken" }
    @fs.write_file("\{dir}/selected-broken.json", broken.stringify())
    let (out, err) = runner.command(["build", "--config", "selected-broken.json"], 1)
    assert_true((out + err).contains(physical))
  }
  for (term, expected) in [
    (Json::object({ "root": "module/models", "paths": ["missing.smithy"] }), "missing-selection"),
    (Json::object({ "root": "missing", "globs": ["**"] }), "missing-root"),
    (Json::object({ "root": "../module", "globs": ["**"] }), "safe resource"),
    (Json::object({ "root": "module", "paths": [{ "path": "models/service.smithy", "name": "same.smithy" }, { "path": "imports/shared.smithy", "name": "same.smithy" }] }), "duplicate-resource"),
    (Json::object({ "root": "module", "paths": ["main.mbt"] }), "must retain"),
    (Json::object({ "root": "module/models", "paths": [{ "path": "service.smithy", "name": "model.json" }] }), "must retain"),
  ] {
    guard term is Object(fields) else { fail("fixture selection must be an object") }
    fields["path"] = "module.zip"
    let config : Json = { "version": "2.0", "sources": [term], "outputDirectory": "selected-invalid" }
    @fs.write_file("\{dir}/selected-invalid.json", config.stringify())
    let (out, err) = runner.command(["build", "--config", "selected-invalid.json"], 1)
    assert_true((out + err).contains(expected), msg=out + err)
    assert_false(@fs.exists("\{dir}/selected-invalid"))
  }
  let first : Json = { "path": "module.zip", "root": "module/models", "paths": [{ "path": "service.smithy", "name": "same.smithy" }] }
  let second : Json = { "path": "module.zip", "root": "module/imports", "paths": [{ "path": "shared.smithy", "name": "same.smithy" }] }
  let collision : Json = { "version": "2.0", "sources": [first, second], "outputDirectory": "selected-collision" }
  @fs.write_file("\{dir}/selected-collision.json", collision.stringify())
  let (collision_out, collision_err) = runner.command(["build", "--config", "selected-collision.json"], 1)
  assert_true((collision_out + collision_err).contains("Conflicting source filename `same.smithy`"))
  @fs.write_file("\{dir}/plain-zip.json", "{\"version\":\"2.0\",\"sources\":[\"module.zip\"],\"outputDirectory\":\"plain-zip-output\"}")
  let (zip_out, zip_err) = runner.command(["build", "--config", "plain-zip.json"], 1)
  assert_true((zip_out + zip_err).contains("requires an explicit resource selection"))
  for container in ["module.tar", "module.tar.gz", "module.tgz"] {
    let config : Json = { "version": "2.0", "sources": [container], "outputDirectory": "plain-archive-output" }
    @fs.write_file("\{dir}/plain-archive.json", config.stringify())
    let (out, err) = runner.command(["build", "--config", "plain-archive.json"], 1)
    assert_true((out + err).contains("requires an explicit resource selection"))
    @fs.write_file("\{dir}/broken-" + container, b"truncated archive")
    let config : Json = { "version": "2.0", "sources": [{ "path": "broken-" + container, "root": "package", "globs": ["**/*.smithy"] }], "outputDirectory": "broken-archive-output" }
    @fs.write_file("\{dir}/broken-archive.json", config.stringify())
    let (out, err) = runner.command(["build", "--config", "broken-archive.json"], 1)
    assert_true((out + err).contains("invalid-archive") && (out + err).contains("input[.]"))
    assert_false(@fs.exists("\{dir}/broken-archive-output"))
  }
  assert_true(@fs.exists("\{dir}/input.smithy"))
  @fs.mkdir("\{dir}/nested", allow_exist=true)
  @fs.write_file("\{dir}/nested/keep.smithy", input)
  @fs.write_file("\{dir}/nested/smithy-build.json", "{\"version\":\"1.0\",\"outputDirectory\":\".\"}")
  runner.command(["clean", "--config", "nested/smithy-build.json"], 2) |> ignore
  assert_true(@fs.exists("\{dir}/nested/keep.smithy"))
  @fs.mkdir("\{dir}/overlap-models", allow_exist=true)
  @fs.write_file("\{dir}/overlap-models/input.smithy", input)
  for (name, inputs) in [
    ("sources", "\"sources\":[\"overlap-models\"]"),
    ("imports", "\"imports\":[\"overlap-models\"]"),
    ("projection", "\"projections\":{\"scoped\":{\"imports\":[\"overlap-models\"]}}"),
  ] {
    let filename = "overlap-\{name}.json"
    @fs.write_file("\{dir}/\{filename}", "{\"version\":\"2.0\",\"outputDirectory\":\"overlap-models/build\",\{inputs}}")
    runner.command(["build", "--config", filename], 2) |> ignore
    runner.command(["clean", "--config", filename], 2) |> ignore
    assert_false(@fs.exists("\{dir}/overlap-models/build"))
    assert_eq(@fs.read_file("\{dir}/overlap-models/input.smithy").text(), input)
  }
  @fs.write_file("\{dir}/protect-sources.json", "{\"version\":\"1.0\",\"sources\":[\"nested\"],\"outputDirectory\":\"nested\"}")
  runner.command(["clean", "--config", "protect-sources.json"], 2) |> ignore
  assert_true(@fs.exists("\{dir}/nested/keep.smithy"))
  if @env.get_env_var("OS") != Some("Windows_NT") {
    runner.command(["build"], 0) |> ignore
    @fs.symlink(target="\{dir}/nested", "\{dir}/build-output/linked")
    runner.command(["clean"], 0) |> ignore
    assert_true(@fs.exists("\{dir}/nested/keep.smithy"))
    runner.command(["build"], 0) |> ignore
    @fs.remove("\{dir}/build-output/source/model/model.json")
    @fs.symlink(target="\{dir}/nested/keep.smithy", "\{dir}/build-output/source/model/model.json")
    runner.command(["build"], 0) |> ignore
    assert_eq(@fs.read_file("\{dir}/nested/keep.smithy").text(), input)
    runner.command(["clean"], 0) |> ignore
    @fs.symlink(target=dir, "\{dir}/alias")
    @fs.mkdir("\{dir}/alias-source", allow_exist=true)
    @fs.write_file("\{dir}/alias-source/input.smithy", input)
    @fs.write_file("\{dir}/protect-alias.json", "{\"version\":\"1.0\",\"sources\":[\"alias-source\"],\"outputDirectory\":\"alias/alias-source\"}")
    runner.command(["clean", "--config", "protect-alias.json"], 2) |> ignore
    runner.command(["build", "--config", "protect-alias.json"], 2) |> ignore
    assert_eq(@fs.read_file("\{dir}/alias-source/input.smithy").text(), input)
  }
  runner.command(["build"], 0) |> ignore
  @fs.write_file("\{dir}/smithy-build.json", "{\"version\":\"1.0\",\"sources\":[\"input.smithy\"],\"outputDirectory\":\"build-output\",\"projections\":{\"source\":{\"abstract\":true},\"filtered\":{\"abstract\":true}}}")
  runner.command(["build"], 0) |> ignore
  assert_false(@fs.exists("\{dir}/build-output"))
  runner.command(["format", "--check", "input.smithy"], 1) |> ignore
  let (formatted, _) = runner.command(["format", "input.smithy"], 0)
  assert_true(formatted.contains("// comment"))
  runner.command(["format", "--write", "input.smithy"], 0) |> ignore
  assert_eq(@fs.read_file("\{dir}/input.smithy").text(), formatted)
  runner.command(["format", "--check", "input.smithy"], 0) |> ignore
  runner.command(["format", "--write", "input.smithy", "syntax.smithy"], 1)
  |> ignore
  assert_eq(@fs.read_file("\{dir}/input.smithy").text(), formatted)
  @fs.write_file(
    "\{dir}/other.json",
    "{\"smithy\":\"2\",\"shapes\":{\"other#Name\":{\"type\":\"string\"}}}",
  )
  runner.command(["convert", "--to", "idl", "model.json", "other.json"], 2)
  |> ignore
  runner.command(
    [
      "convert", "--to", "idl", "--output-dir", "idl", "model.json", "other.json",
    ],
    0,
  )
  |> ignore
  assert_true(@fs.exists("\{dir}/idl/example.smithy"))
  assert_true(@fs.exists("\{dir}/idl/other.smithy"))
  runner.command(["validate", "idl/example.smithy", "idl/other.smithy"], 0)
  |> ignore
  check_readme(runner, root)
  check_readme_status(runner)
  println("CLI checks passed: \{target}")
}

///|
async fn main {
  let targets = @env.args()[1:].to_owned()
  let targets = if targets.is_empty() {
    ["native", "wasm", "js", "wasm-gc"]
  } else {
    targets
  }
  let root = @fs.realpath(".")
  for target in targets {
    guard ["native", "wasm", "js", "wasm-gc"].contains(target) else {
      eprintln("Unknown target: \{target}")
      @sys.exit(2)
    }
    exercise(root, target)
  }
}

///|
async test "native and moonx Wasm CLI behavior" {
  let root = @fs.realpath("..")
  exercise(root, "native")
  exercise(root, "wasm")
}

///|
async test "file checks run when stdin is skipped" {
  exercise(@fs.realpath(".."), "wasm", skip_stdin=true)
}

///|
test "doc_steps reads fixtures and console sessions in order" {
  let md = "# x\n\n```smithy file=greeting.smithy\n$version: \"2\"\n```\n\n```console\n$ smithy convert --to json greeting.smithy\n{\n}\n$ smithy version\n0.6.0\n```\n\n```shell\nsmithy anything\n```\n"
  assert_eq(
    doc_steps(md),
    Ok([
      Fixture(name="greeting.smithy", text="$version: \"2\"\n"),
      Session([
        {
          args: ["convert", "--to", "json", "greeting.smithy"],
          output: "{\n}\n",
          status: 0,
        },
        { args: ["version"], output: "0.6.0\n", status: 0 },
      ]),
    ]),
  )
}

///|
test "doc_steps reads the status of a console fence" {
  let md = "```console status=1\n$ smithy validate bad.smithy\n[ERROR] x | Y\n```\n"
  assert_eq(
    doc_steps(md),
    Ok([
      Session([
        {
          args: ["validate", "bad.smithy"],
          output: "[ERROR] x | Y\n",
          status: 1,
        },
      ]),
    ]),
  )
  let md = "```console status=125\n$ smithy version\n```\n"
  assert_true(doc_steps(md) is Ok([Session([{ status: 125, .. }])]))
}

///|
test "doc_steps rejects a bad status" {
  for info in ["status=0", "status=x", "status=126", "status=", "status=1000", "status=-1", "status=+1", "status=01", "status=1 status=2"] {
    match doc_steps("```console \{info}\n$ smithy version\n```\n") {
      Err(msg) =>
        assert_true(
          msg.contains("I expected `console` or `console status=N`"),
          msg="\{info}: \{msg}",
        )
      Ok(_) => fail("expected an error for \{info}")
    }
  }
}

///|
test "doc_steps reads CRLF text" {
  let md = "# x\r\n\r\n```smithy file=greeting.smithy\r\n$version: \"2\"\r\n```\r\n\r\n```console\r\n$ smithy convert --to json greeting.smithy\r\n{\r\n}\r\n$ smithy version\r\n0.6.0\r\n```\r\n\r\n```shell\r\nsmithy anything\r\n```\r\n"
  assert_eq(
    doc_steps(md),
    Ok([
      Fixture(name="greeting.smithy", text="$version: \"2\"\n"),
      Session([
        {
          args: ["convert", "--to", "json", "greeting.smithy"],
          output: "{\n}\n",
          status: 0,
        },
        { args: ["version"], output: "0.6.0\n", status: 0 },
      ]),
    ]),
  )
}

///|
test "doc_steps errors" {
  let cases = [
    ("```console\n$ ls\n```", "I can run only a smithy command"),
    (
      "```console\n$ smithy select x | head\n```", "I cannot run the shell character |",
    ),
    ("```console\noutput\n```", "I found output before the first command"),
    ("```smithy file=../x.smithy\n```", "I expected a plain file name"),
    ("```smithy file=a/b.smithy\n```", "I expected a plain file name"),
    ("```smithy file=..\n```", "I expected a plain file name"),
    ("```console\n$ smithy x\n", "I found a fence that never closes"),
  ]
  for c in cases {
    let (md, text) = c
    match doc_steps(md) {
      Err(msg) => assert_true(msg.contains(text), msg="\{msg} lacks \{text}")
      Ok(_) => fail("expected an error for \{md}")
    }
  }
}

///|
test "shell_words keeps a single-quoted word" {
  assert_eq(
    shell_words("smithy select --selector 'structure > member' m.smithy"),
    Ok(["smithy", "select", "--selector", "structure > member", "m.smithy"]),
  )
}

///|
test "shell_words rejects shell characters and an unclosed quote" {
  for bad in ["a | b", "a > b", "a < b", "a; b", "a & b", "a \"b\"", "a `b`", "a $b", "a \\b"] {
    assert_true(shell_words(bad) is Err(_), msg=bad)
  }
  assert_true(shell_words("a 'b") is Err(_))
}

///|
test "doc_steps does not skip console and fixture fences in silence" {
  let cases = [
    ("```console title=x\n$ smithy version\n0.6.0\n```", Some("I expected `console` or `console status=N`")),
    ("```console\tstatus=1\n$ smithy version\n```", Some("I expected `console` or `console status=N`")),
    ("```console status=1 status=2\n$ smithy version\n```", Some("I expected `console` or `console status=N`")),
    ("```console status=1\n$ smithy version\n```", None),
    ("  ```console\n  $ smithy version\n  ```", Some("does not start at the start of a line")),
    ("  ```smithy file=a.smithy\n  ```", Some("does not start at the start of a line")),
    ("```console\n```", Some("a console block with no command")),
    ("```console\n$ smithy version\n0.6.0\n```  \n", None),
    ("```console\n$ smithy cat /etc/passwd\n```", Some("absolute path")),
    ("```console\n$ smithy cat ../x\n```", Some("absolute path")),
    ("```console\n$ smithy cat 'a\\..\\x'\n```", Some("absolute path")),
    ("```console\n$ smithy cat C:x\n```", Some("absolute path")),
    ("```console\n$ smithy cat a/b.smithy ..x\n```", None),
    ("~~~console\n$ smithy version\n~~~", Some("does not start at the start of a line")),
  ]
  for c in cases {
    let (md, want) = c
    match (doc_steps(md), want) {
      (Ok(steps), None) => assert_true(!steps.is_empty(), msg=md)
      (Err(msg), Some(text)) =>
        assert_true(msg.contains(text), msg="\{msg} lacks \{text}")
      _ => fail("unexpected result for \{md}")
    }
  }
  // A closing fence with trailing spaces closes, so the next fence is read.
  assert_eq(
    doc_steps(
      "```console\n$ smithy version\n0.6.0\n```  \n\n```smithy file=a.smithy\nx\n```\n",
    ).map(steps => steps.length()),
    Ok(2),
  )
  // As in CommonMark, a closing fence can have up to 3 spaces of indent. The fence
  // ends there, so the output of the command is only `0.6.0`.
  for indent in [" ", "  ", "   "] {
    assert_eq(
      doc_steps(
        "```console\n$ smithy version\n0.6.0\n\{indent}```\n\n```smithy file=a.smithy\nx\n```\n",
      ),
      Ok([
        Session([{ args: ["version"], output: "0.6.0\n", status: 0 }]),
        Fixture(name="a.smithy", text="x\n"),
      ]),
      msg="indent \{indent.length()}",
    )
  }
  // A closing fence with 4 spaces of indent is code of the fence.
  assert_true(
    doc_steps("```console\n$ smithy version\n    ```\n```\n")
    is Ok([Session([{ output: "    ```\n", .. }])]),
  )
}

///|
/// A fence inside a longer fence is code: the runner skips it, as `@markdown.region`
/// (site/markdown/include.mbt) does not see a region there.
test "doc_steps skips a console fence inside a longer fence" {
  assert_eq(
    doc_steps(
      "````markdown\n<!-- tour:start x -->\n```console\n$ smithy version\n```\n<!-- tour:end x -->\n````\n",
    ),
    Ok([]),
  )
}
