----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/http",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/socket",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Build the site at base `/` and serve it on http://localhost:8080.
///
/// Usage: `mise run site:dev`, or `moonx scripts/site-dev.mbtx [--port <n>]`. Run it from the
/// workspace root. The build is the release channel of the working tree, in `site/dist`. A path
/// that leaves `site/dist` gives 403, a directory serves its `index.html`, and a missing file
/// serves `404.html` with the status 404, as GitHub Pages does.
///
/// `--serve <dir>` serves a directory that is already built and does no build, and `--base <path>`
/// serves it below that path. The browser tests serve the output of `site:pages` with
/// `--serve _site --base /smithy/`, as GitHub Pages serves it; a path outside the base gives 404.

///|
/// The directory that the build writes and the server serves when `--serve` is not given.
let dist : String = "site/dist"

///|
let default_port : Int32 = 8080

///|
fn hex_value(c : Int32) -> Int32? {
  if c >= '0'.to_int() && c <= '9'.to_int() {
    Some(c - '0'.to_int())
  } else if c >= 'a'.to_int() && c <= 'f'.to_int() {
    Some(c - 'a'.to_int() + 10)
  } else if c >= 'A'.to_int() && c <= 'F'.to_int() {
    Some(c - 'A'.to_int() + 10)
  } else {
    None
  }
}

///|
/// Decode the `%XX` escapes of a URL path as UTF-8. Returns `None` for a bad escape or bad UTF-8.
fn percent_decode(path : String) -> String? {
  let utf8 = @utf8.encode(path)
  let out = Array(capacity=utf8.length())
  let mut i = 0
  while i < utf8.length() {
    let b = utf8[i]
    if b == b'%' {
      guard i + 2 < utf8.length() &&
        hex_value(utf8[i + 1].to_int()) is Some(hi) &&
        hex_value(utf8[i + 2].to_int()) is Some(lo) else {
        return None
      }
      out.push((hi * 16 + lo).to_byte())
      i += 3
    } else {
      out.push(b)
      i += 1
    }
  }
  try @utf8.decode(Bytes::from_array(out)) catch {
    _ => None
  } noraise {
    text => Some(text)
  }
}

///|
/// What the server does with one request path.
enum Route {
  /// Answer 403: the path leaves the site directory or cannot be decoded.
  Forbidden
  /// Serve this path below the site directory. An empty path or a path that ends with `/` names a
  /// directory.
  Serve(String)
  /// Answer 404: the path is not below the base.
  Outside
} derive(Eq, Debug)

///|
/// The route of the request target below `base` (which starts and ends with `/`). The query and
/// the fragment are ignored.
fn route(target : String, base? : String = "/") -> Route {
  let path = match target.find("?") {
    Some(i) => target[:i].to_owned()
    None => target
  }
  let path = match path.find("#") {
    Some(i) => path[:i].to_owned()
    None => path
  }
  guard percent_decode(path) is Some(path) else { return Forbidden }
  guard path.has_prefix("/") else { return Forbidden }
  let rel = if path.has_prefix(base) {
    path[base.length():].to_owned()
  } else if path + "/" == base {
    ""
  } else {
    // Check the whole path first: a path that leaves the root is refused, not missing.
    if path.split("/").any(segment => segment == ".." || segment == ".") {
      return Forbidden
    }
    return Outside
  }
  if rel.contains("\\") || rel.contains("\u{0}") {
    return Forbidden
  }
  for segment in rel.split("/") {
    if segment == ".." || segment == "." {
      return Forbidden
    }
  }
  Serve(rel)
}

///|
/// The content type of a file name.
fn content_type(name : String) -> String {
  let types = [
    (".html", "text/html; charset=utf-8"),
    (".css", "text/css; charset=utf-8"),
    (".js", "text/javascript; charset=utf-8"),
    (".json", "application/json"),
    (".md", "text/markdown; charset=utf-8"),
    (".svg", "image/svg+xml"),
    (".png", "image/png"),
    (".woff2", "font/woff2"),
    (".wasm", "application/wasm"),
    (".map", "application/json"),
    (".ico", "image/x-icon"),
  ]
  for entry in types {
    if name.has_suffix(entry.0) {
      return entry.1
    }
  }
  "application/octet-stream"
}

///|
/// A port number from its text, or an error message.
fn port_of(value : String) -> Result[Int32, String] {
  if !value.is_empty() &&
    value.iter().all(c => c >= '0' && c <= '9') &&
    value.length() <= 5 {
    let mut n = 0
    for c in value {
      n = n * 10 + (c.to_int() - '0'.to_int())
    }
    if n >= 1 && n <= 65535 {
      return Ok(n)
    }
  }
  Err("the port must be 1 to 65535, got \{value}")
}

///|
/// What the server does: the port, the built directory to serve (`None`: build `site/dist` first)
/// and the path below which it serves the directory.
struct Options {
  port : Int32
  serve : String?
  base : String
} derive(Eq, Debug)

///|
/// The options from the arguments (after the program name), or an error message.
fn parse_options(args : ArrayView[String]) -> Result[Options, String] {
  let mut options = { port: default_port, serve: None, base: "/" }
  let mut i = 0
  while i < args.length() {
    let arg = args[i]
    guard arg == "--port" || arg == "--serve" || arg == "--base" else {
      return Err("unknown argument \{arg}")
    }
    guard i + 1 < args.length() else { return Err("missing value for \{arg}") }
    let value = args[i + 1]
    match arg {
      "--port" =>
        match port_of(value) {
          Ok(port) => options = { ..options, port, }
          Err(message) => return Err(message)
        }
      "--serve" => options = { ..options, serve: Some(value) }
      _ => {
        let base = if value.has_prefix("/") { value } else { "/" + value }
        let base = if base.has_suffix("/") { base } else { base + "/" }
        options = { ..options, base, }
      }
    }
    i += 2
  }
  Ok(options)
}

///|
async fn send_file(
  conn : @http.ServerConnection,
  file : String,
  status : Int32,
  reason : String,
) -> Unit {
  let data = @fs.read_file(file).binary()
  conn
  ..send_response(
    status,
    reason,
    extra_headers=Map::from_array([
      (@http.CaseInsensitiveString("Content-Type"), content_type(file)),
    ]),
  )
  .write(data)
}

///|
async fn answer(
  request : @http.Request,
  conn : @http.ServerConnection,
  dist : String,
  base : String,
) -> Unit {
  match route(request.path, base~) {
    Forbidden => conn..send_response(403, "Forbidden").write("Forbidden")
    Outside => conn..send_response(404, "Not Found").write("Not found")
    Serve(rel) => {
      let mut file = "\{dist}/\{rel}"
      if rel == "" ||
        rel.has_suffix("/") ||
        (@fs.exists(file) && @fs.kind(file) is Directory) {
        file = if file.has_suffix("/") {
          "\{file}index.html"
        } else {
          "\{file}/index.html"
        }
      }
      if @fs.exists(file) && @fs.kind(file) is Regular {
        send_file(conn, file, 200, "OK")
      } else if @fs.exists("\{dist}/404.html") {
        send_file(conn, "\{dist}/404.html", 404, "Not Found")
      } else {
        conn..send_response(404, "Not Found").write("Not found")
      }
    }
  }
}

///|
async fn run_checked(command : String, args : Array[String]) -> Unit {
  let code = @process.run(
    command,
    args,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  )
  if code != 0 {
    eprintln("site:dev: `\{command}` failed")
    @sys.exit(if code > 0 { code } else { 1 })
  }
}

///|
async fn main {
  let options = match parse_options(@env.args()[1:]) {
    Ok(options) => options
    Err(message) => {
      eprintln("site:dev: \{message}")
      @sys.exit(2)
      return
    }
  }
  let port = options.port
  if options.serve is Some(dir) {
    serve(dir, options.base, port)
    return
  }
  let (status, output, errors) = @process.collect_output("moonx", [
    "scripts/site-latest-tag.mbtx",
  ])
  if status != 0 {
    eprintln("site:dev: cannot find the latest tag: \{errors.text()}")
    @sys.exit(1)
  }
  let tag = output.text().trim().to_owned()
  let version = if tag.is_empty() { "v0.0.0" } else { tag }
  run_checked("moonx", [
    "scripts/site-build.mbtx", "--content", ".", "--channel", "release", "--site-root",
    "/", "--release-version", version, "--ref", "main", "--out", dist,
  ])
  serve(dist, "/", port)
}

///|
async fn serve(dir : String, base : String, port : Int32) -> Unit {
  let server = @http.Server(
    @socket.Addr::parse("127.0.0.1:\{port}"),
    reuse_addr=true,
  )
  println("Site: http://localhost:\{port}\{base}")
  server.run_forever(allow_failure=true, (request, _body, conn) => {
    answer(request, conn, dir, base)
  })
}

///|
test "route serves paths below the root" {
  assert_eq(route("/"), Serve(""))
  assert_eq(route("/docs/"), Serve("docs/"))
  assert_eq(route("/docs/cli?x=1#a"), Serve("docs/cli"))
  assert_eq(route("/a%20b/c.css"), Serve("a b/c.css"))
}

///|
test "route refuses a path that leaves the directory" {
  assert_eq(route("/../secret"), Forbidden)
  assert_eq(route("/%2e%2e/secret"), Forbidden)
  assert_eq(route("/docs/./x"), Forbidden)
  assert_eq(route("/..%5csecret"), Forbidden)
  assert_eq(route("/%zz"), Forbidden)
  assert_eq(route("/%FF"), Forbidden)
  assert_eq(route("no-slash"), Forbidden)
}

///|
test "content types" {
  assert_eq(content_type("index.html"), "text/html; charset=utf-8")
  assert_eq(content_type("index.js"), "text/javascript; charset=utf-8")
  assert_eq(content_type("a.bin"), "application/octet-stream")
}

///|
test "content types of wasm, source maps and icons" {
  assert_eq(content_type("smithy.wasm"), "application/wasm")
  assert_eq(content_type("playground/ui.js.map"), "application/json")
  assert_eq(content_type("favicon.ico"), "image/x-icon")
  // A source map is not served as JavaScript.
  assert_eq(content_type("index.js.map"), "application/json")
}

///|
test "parse_options reads the port" {
  assert_eq(parse_options([]).map(o => o.port), Ok(8080))
  assert_eq(parse_options(["--port", "9000"]).map(o => o.port), Ok(9000))
  assert_eq(
    parse_options(["--port", "0"]).map(o => o.port),
    Err("the port must be 1 to 65535, got 0"),
  )
  assert_eq(
    parse_options(["--port", "70000"]).map(o => o.port),
    Err("the port must be 1 to 65535, got 70000"),
  )
  assert_eq(
    parse_options(["--port", "x"]).map(o => o.port),
    Err("the port must be 1 to 65535, got x"),
  )
  assert_eq(parse_options(["--watch"]).map(o => o.port), Err("unknown argument --watch"))
}

///|
test "parse_options builds and serves site/dist at / by default" {
  assert_eq(parse_options([]), Ok({ port: 8080, serve: None, base: "/" }))
  assert_eq(
    parse_options(["--port", "9000"]),
    Ok({ port: 9000, serve: None, base: "/" }),
  )
}

///|
test "parse_options serves a built directory under a base without a build" {
  assert_eq(
    parse_options(["--serve", "_site", "--base", "/smithy/", "--port", "8091"]),
    Ok({ port: 8091, serve: Some("_site"), base: "/smithy/" }),
  )
  assert_eq(
    parse_options(["--base", "smithy"]),
    Ok({ port: 8080, serve: None, base: "/smithy/" }),
  )
  assert_eq(parse_options(["--serve"]), Err("missing value for --serve"))
  assert_eq(parse_options(["--watch"]), Err("unknown argument --watch"))
  assert_eq(
    parse_options(["--port", "0"]),
    Err("the port must be 1 to 65535, got 0"),
  )
}

///|
test "route under a base serves only the paths below it" {
  assert_eq(route("/smithy/", base="/smithy/"), Serve(""))
  assert_eq(route("/smithy", base="/smithy/"), Serve(""))
  assert_eq(
    route("/smithy/next/playground/", base="/smithy/"),
    Serve("next/playground/"),
  )
  assert_eq(route("/other/", base="/smithy/"), Outside)
  assert_eq(route("/smithy/../x", base="/smithy/"), Forbidden)
}
