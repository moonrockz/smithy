/// Vendor immutable protocol-test traits and fixtures from an upstream snapshot.
/// Each copied file is checked against the Git blob SHA in the pinned remote
/// tree. A git checkout and a codeload snapshot therefore have equal provenance.
/// Usage: moonx scripts/vendor-protocol-tests.mbtx [UPSTREAM_DIRECTORY]
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}

///|
let reference_sha : String = "30bdab593f0c2cdf96036782cc3ce15c43a711ef"

///|
let resource_prefix : String = "smithy-protocol-test-traits/src/test/resources/software/amazon/smithy/protocoltests/traits/"

///|
let model_path : String = "smithy-protocol-test-traits/src/main/resources/META-INF/smithy/smithy.test.smithy"

///|
fn git_blob_hash(text : String) -> String {
  let bytes = @utf8.encode(text)
  let object_ = @utf8.encode("blob " + bytes.length().to_string() + "\u{0000}" + text)
  @crypto.bytes_to_hex_string(@crypto.sha1(object_))
}

///|
async fn write_file(path : String, content : String) -> Unit {
  let parts = path.split("/").map(p => p.to_owned()).to_array()
  ignore(parts.pop())
  @fs.mkdir(parts.join("/"), recursive=true, allow_exist=true)
  @fs.write_file(path, content)
}

///|
async fn main {
  let args = @env.args()
  let source = if args.length() > 1 { args[1] } else { ".dev/reference/snapshot" }
  let (code, out, err) = @process.collect_output("curl", [
    "-fsSL", "--retry", "2",
    "https://api.github.com/repos/smithy-lang/smithy/git/trees/" + reference_sha + "?recursive=1",
  ])
  if code != 0 { eprintln(err.text()); @sys.exit(1) }
  let tree = @json.parse(out.text())
  guard tree is { "sha": String(sha), "tree": Array(entries), "truncated": False, .. } && sha == reference_sha else {
    fail("Pinned reference tree is missing, mismatched or truncated")
  }
  let inventory : Array[Json] = []
  for entry in entries {
    guard entry is { "type": String("blob"), "path": String(path), "sha": String(blob), .. } else { continue }
    let relative = if path.has_prefix(resource_prefix) {
      "upstream/" + path[resource_prefix.length():].to_owned()
    } else if path == "LICENSE" || path == model_path {
      if path == model_path { "smithy.test.smithy" } else { "LICENSE" }
    } else { continue }
    let content = @fs.read_file(source + "/" + path).text()
    assert_eq(git_blob_hash(content), blob, msg="Reference blob mismatch: " + path)
    write_file("tests/tck/protocol-tests/" + relative, content)
    if path == model_path {
      write_file("pkgs/smithy/protocol_test_traits.smithy", content)
      let generated = StringBuilder()
      generated.write_string("// Generated by scripts/vendor-protocol-tests.mbtx at " + reference_sha + ".\n// Copyright Amazon.com, Inc. or its affiliates. Apache-2.0.\n\n///|\nfn protocol_test_traits_text() -> String {\n  (\n")
      for line in content.split("\n") { generated.write_string("    #|" + line.to_owned() + "\n") }
      generated.write_string("  )\n}\n")
      write_file("pkgs/smithy/protocol_test_traits_data.mbt", generated.to_string())
      write_file("pkgs/smithy/PROTOCOL_TEST_SHA", reference_sha + "\n")
    }
    inventory.push(Json::object({
      "path": Json::string(relative),
      "upstreamPath": Json::string(path),
      "gitBlob": Json::string(blob),
    }))
  }
  guard inventory.length() > 1 else { fail("No protocol fixtures in the pinned tree") }
  write_file("tests/tck/protocol-tests/REFERENCE_SHA", reference_sha + "\n")
  write_file("tests/tck/protocol-tests/inventory.json", Json::object({
    "referenceSha": Json::string(reference_sha),
    "files": Json::array(inventory),
  }).stringify(indent=2) + "\n")
  println("Vendored " + inventory.length().to_string() + " verified protocol reference files")
}

///|
test "Git blob identity includes exact UTF-8 byte length and final newline" {
  assert_eq(git_blob_hash("hello\n"), "ce013625030ba8dba906f756967f9e9ca394464a")
  assert_true(git_blob_hash("hello") != git_blob_hash("hello\n"))
}
