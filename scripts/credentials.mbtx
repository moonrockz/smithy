/// Write the mooncakes.io credentials from `MOONCAKES_USER_TOKEN` to `$MOON_HOME/credentials.json`, or to
/// `~/.moon/credentials.json` when `MOON_HOME` is not set (CI only).
///
/// Usage: `mise run release:credentials`, or `moonx scripts/credentials.mbtx`. The script exits with a
/// non-zero code when the token is missing or empty.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/x@0.5.5/sys",
  "moonbitlang/core/env",
  "moonrockz/moonspec@0.11.0",
  "moonrockz/expect@0.6.1",
}

///|
let token_var : String = "MOONCAKES_USER_TOKEN"

///|
fn fail_with(message : String) -> Unit {
  eprintln("❌ \{message}")
  @sys.exit(1)
}

///|
/// Return the token, or an error message when it is missing or empty.
fn require_token(value : String?) -> Result[String, String] {
  match value {
    Some(token) if token != "" => Ok(token)
    _ => Err("\{token_var} is not set; cannot write mooncakes.io credentials")
  }
}

///|
/// Render `{"token": ...}` with correct JSON escaping.
fn credentials_json(token : String) -> String {
  let json : Json = { "token": Json(token) }
  json.stringify(indent=2) + "\n"
}

///|
/// Return the directory where `moon` reads `credentials.json`: `MOON_HOME` when it is set and not empty,
/// else `$HOME/.moon`.
fn credentials_dir(moon_home : String?, home : String?) -> Result[String, String] {
  match (moon_home, home) {
    (Some(dir), _) if dir != "" => Ok(dir)
    (_, Some(home)) if home != "" => Ok("\{home}/.moon")
    _ => Err("neither MOON_HOME nor HOME is set; cannot locate the moon directory")
  }
}

///|
async fn main {
  let token = match require_token(@env.get_env_var(token_var)) {
    Ok(token) => token
    Err(message) => {
      fail_with(message)
      return
    }
  }
  let dir = match
    credentials_dir(@env.get_env_var("MOON_HOME"), @env.get_env_var("HOME")) {
    Ok(dir) => dir
    Err(message) => {
      fail_with(message)
      return
    }
  }
  @fs.mkdir(dir, recursive=true, allow_exist=true)
  @fs.write_file("\{dir}/credentials.json", credentials_json(token), permission=0o600)
  println("Credentials written to \{dir}/credentials.json")
}

///|
/// Scenario state for `features/credentials.feature`.
struct CredentialsWorld {
  mut token : String?
  mut result : Result[String, String]
  mut moon_home : String?
  mut home : String?
}

///|
fn CredentialsWorld::new() -> CredentialsWorld {
  { token: None, result: Err("not run"), moon_home: None, home: None }
}

///|
impl @moonspec.World for CredentialsWorld with fn configure(self, setup) {
  setup.given1("the token is {string}", fn(token : String) {
    self.token = Some(token)
  })
  setup.given0("no token is set", fn() { self.token = None })
  setup.given1("MOON_HOME is {string}", fn(dir : String) { self.moon_home = Some(dir) })
  setup.given1("HOME is {string}", fn(dir : String) { self.home = Some(dir) })
  setup.when0("I choose the credentials directory", fn() {
    self.result = credentials_dir(self.moon_home, self.home)
  })
  setup.then1("the directory is {string}", fn(dir : String) raise {
    @expect.expect(self.result).to_equal(Ok(dir))
  })
  setup.when0("I render the credentials", fn() {
    self.result = require_token(self.token).map(credentials_json)
  })
  setup.then1("the credentials file is:", fn(doc : @moonspec.DocString) raise {
    @expect.expect(self.result).to_equal(Ok(doc.content + "\n"))
  })
  setup.then1("rendering fails with {string}", fn(message : String) raise {
    @expect.expect(self.result).to_equal(Err(message))
  })
}

///|
async test "credentials feature" {
  @moonspec.run_or_fail(
    CredentialsWorld::new,
    @moonspec.RunOptions::new([
      @moonspec.FeatureSource::File("features/credentials.feature"),
    ]),
  )
  |> ignore
}
