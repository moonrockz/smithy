/// Vendor the pinned finos/morphir sources for the Smithy language tour from a local checkout.
/// Each copied file is checked against the Git blob SHA in the pinned remote tree, so a git checkout
/// and a snapshot have equal provenance. The bytes are hashed and copied as they are.
/// Usage: moonx scripts/vendor-morphir.mbtx [CHECKOUT]   (default .dev/out/finos-morphir)
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}

///|
let morphir_sha : String = "ab8d5c9198c0f1ac8a3cabfd11b9ab59a468c409"

///|
let repository : String = "https://github.com/finos/morphir"

///|
let target : String = "site/tour/morphir"

///|
/// Paths in finos/morphir, sorted.
let files : Array[String] = [
  "LICENSE", "NOTICE",
  "docs/spec/ir/fixtures/naming-conformance.json",
  "spec/ir/mck/names.feature",
  "spec/ir/mck/types.feature",
  "website/static/ir/examples/v3/greeting-example.json",
  "website/static/ir/examples/v4/books-and-records-example.json",
  "website/static/ir/examples/v4/complete-example.json",
  "website/static/ir/examples/v4/index.json",
  "website/static/schemas/morphir-ir-v4.json",
]

///|
/// The Git blob identity of `content`: SHA-1 of "blob <length>\0" followed by the bytes.
fn git_blob_hash(content : Bytes) -> String {
  let header = @utf8.encode("blob " + content.length().to_string() + "\u{0000}")
  let object_ = Bytes::from_array(header.to_array() + content.to_array())
  @crypto.bytes_to_hex_string(@crypto.sha1(object_))
}

///|
/// The text of inventory.json for entries of (path, blob).
fn render_inventory(commit : String, entries : Array[(String, String)]) -> String {
  Json::object({
    "repository": Json::string(repository),
    "commit": Json::string(commit),
    "files": Json::array(
      entries.map(e => Json::object({
        "path": Json::string(e.0),
        "gitBlob": Json::string(e.1),
      })),
    ),
  }).stringify(indent=2) + "\n"
}

///|
async fn write_bytes(path : String, content : Bytes) -> Unit {
  let parts = path.split("/").map(p => p.to_owned()).to_array()
  ignore(parts.pop())
  @fs.mkdir(parts.join("/"), recursive=true, allow_exist=true)
  @fs.write_file(path, content)
}

///|
async fn fetch(url : String) -> (Int, String, String) {
  let (code, out, err) = @process.collect_output("curl", ["-fsSL", url]) catch {
    _ => return (1, "", "cannot start curl")
  }
  (code, out.text(), err.text())
}

///|
/// The tree of the pinned commit: the blob SHA of each path. Tries 4 times, with waits of 5, 20 and 60 s.
async fn fetch_tree() -> Json {
  let url = "https://api.github.com/repos/finos/morphir/git/trees/" + morphir_sha + "?recursive=1"
  let waits = [5000, 20000, 60000]
  let mut last = ""
  for attempt in 0..<4 {
    if attempt > 0 {
      eprintln("retry \{attempt + 1}/4: tree of \{morphir_sha}")
      @async.sleep(waits[attempt - 1])
    }
    let (code, out, err) = fetch(url)
    if code == 0 {
      return @json.parse(out)
    }
    last = err
  }
  eprintln("Cannot read the pinned tree: " + last)
  @sys.exit(1)
  Json::null()
}

///|
async fn main {
  let args = @env.args()
  let source = if args.length() > 1 { args[1] } else { ".dev/out/finos-morphir" }
  let tree = fetch_tree()
  guard tree is { "sha": String(sha), "tree": Array(entries), "truncated": False, .. } &&
    sha == morphir_sha else {
    eprintln("Pinned Morphir tree is missing, mismatched or truncated")
    @sys.exit(1)
  }
  let blobs : Map[String, String] = Map([])
  for entry in entries {
    if entry is { "type": String("blob"), "path": String(path), "sha": String(blob), .. } {
      blobs[path] = blob
    }
  }
  let inventory : Array[(String, String)] = []
  for path in files {
    guard blobs.get(path) is Some(blob) else {
      eprintln("Path not in the pinned tree: " + path)
      @sys.exit(1)
    }
    let content = @fs.read_file(source + "/" + path).binary()
    if git_blob_hash(content) != blob {
      eprintln("Blob mismatch (the checkout is not at the pinned commit?): " + path)
      @sys.exit(1)
    }
    write_bytes(target + "/upstream/" + path, content)
    if path == "LICENSE" || path == "NOTICE" {
      write_bytes(target + "/" + path, content)
    }
    inventory.push((path, blob))
  }
  @fs.write_file(target + "/inventory.json", render_inventory(morphir_sha, inventory))
  println("Vendored " + inventory.length().to_string() + " verified Morphir files")
}

///|
test "Git blob identity includes the byte length and the final newline" {
  assert_eq(
    git_blob_hash(@utf8.encode("hello\n")),
    "ce013625030ba8dba906f756967f9e9ca394464a",
  )
  assert_true(
    git_blob_hash(@utf8.encode("hello")) != git_blob_hash(@utf8.encode("hello\n")),
  )
}

///|
/// Code-unit order: String::compare orders by length first.
fn code_unit_less(a : String, b : String) -> Bool {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  for i in 0..<n {
    if a[i] != b[i] {
      return a[i] < b[i]
    }
  }
  a.length() < b.length()
}

///|
test "The file list is sorted and has no duplicate" {
  for i in 1..<files.length() {
    assert_true(code_unit_less(files[i - 1], files[i]))
  }
}

///|
test "The inventory renderer writes the repository, the commit and the entries" {
  let text = render_inventory("abc", [("a", "1"), ("b", "2")])
  assert_true(text.has_suffix("}\n"))
  assert_eq(
    @json.parse(text),
    Json::object({
      "repository": Json::string(repository),
      "commit": Json::string("abc"),
      "files": Json::array([
        Json::object({ "path": Json::string("a"), "gitBlob": Json::string("1") }),
        Json::object({ "path": Json::string("b"), "gitBlob": Json::string("2") }),
      ]),
    }),
  )
}
