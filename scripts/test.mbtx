///|
/// Run the tests of every workspace member for one or more targets.
///
/// Usage: `mise run test [-- <target>...]`, or `moonx scripts/test.mbtx <target>...`.
/// With no target, it tests wasm, wasm-gc, js and native.
///
/// `moon test <path>` tests only the package at exactly that path, not its
/// sub-packages, so `pkgs/smithy-syntax` is spelled out as `src` and each
/// of its sub-packages. The `tests` module's `moonbitlang/async` dependency
/// does not build on wasm or wasm-gc, so it runs on js and native only.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}

///|
let all_targets : Array[String] = ["wasm", "wasm-gc", "js", "native"]

///|
/// Every library package, tested on every target.
let library_paths : Array[String] = [
  "pkgs/smithy",
  "pkgs/smithy-syntax/src",
  "pkgs/smithy-syntax/src/ast",
  "pkgs/smithy-syntax/src/cst",
  "pkgs/smithy-syntax/src/diagnostic",
  "pkgs/smithy-syntax/src/lawkit",
  "pkgs/smithy-syntax/src/parser",
  "pkgs/smithy-syntax/src/report",
  "pkgs/smithy-syntax/src/scanner",
  "pkgs/smithy-syntax/src/span",
  "apps/smithy",
  "docs/cookbook",
]

///|
/// The `tests` module's packages, tested on js and native only.
let test_paths : Array[String] = ["tests/tck"]

///|
async fn moon_test(paths : Array[String], target : String) -> Int {
  let args = ["test"]
  args.append(paths)
  args.push("--target")
  args.push(target)
  @process.run("moon", args, stdout=@stdio.stdout, stderr=@stdio.stderr)
}

///|
async fn main {
  let args = @env.args()[1:]
  let targets = args.filter(fn(arg) { !arg.has_prefix("--") })
  let targets = if targets.is_empty() { all_targets } else { targets }
  for target in targets {
    println("🧪 Testing for \{target}...")
    let code = moon_test(library_paths, target)
    if code != 0 {
      println("❌ Tests failed for \{target}")
      @sys.exit(if code > 0 { code } else { 1 })
    }
    if target == "js" || target == "native" {
      let code = moon_test(test_paths, target)
      if code != 0 {
        println("❌ Tests failed for \{target}")
        @sys.exit(if code > 0 { code } else { 1 })
      }
    }
  }
  println("✅ All tests passed")
}
