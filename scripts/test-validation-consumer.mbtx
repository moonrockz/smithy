///|
/// Qualify an isolated consumer against normal local package archives.
/// Default JSON/RPC and --openrpc modes exclude Ion. --ion permits the adapter
/// and released Ion module, and every mode excludes WIT-related integrations.
/// Optional arguments after the mode select targets; the default is all four.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
async fn write(path : String, bytes : &@io.Data) -> Unit {
  let parts = path.split("/").map(p => p.to_owned()).to_array()
  parts.pop() |> ignore
  @fs.mkdir(parts.join("/"), recursive=true, allow_exist=true)
  @fs.write_file(path, bytes)
}

///|
enum ConsumerProfile {
  JsonConsumer
  OpenRpcConsumer
  IonConsumer
} derive(Eq)

///|
let integration_modules : Array[String] = [
  "moonrockz/ion", "moonrockz/smithy-ion-validation", "moonrockz/wit", "moonrockz/wac",
  "moonrockz/wasm-devkit", "moonrockz/smithy-jsonschema", "moonrockz/smithy-openapi",
  "moonrockz/smithy-openrpc",
]

///|
fn allowed(name : String, profile : ConsumerProfile) -> Bool {
  match name {
    "moonrockz/ion" | "moonrockz/smithy-ion-validation" =>
      profile == IonConsumer
    "moonrockz/smithy-jsonschema" | "moonrockz/smithy-openrpc" =>
      profile == OpenRpcConsumer
    "moonrockz/wit"
    | "moonrockz/wac"
    | "moonrockz/wasm-devkit"
    | "moonrockz/smithy-openapi" => false
    _ => true
  }
}

///|
fn string_field(value : Json, key : String) -> String raise {
  guard value is Object(fields) && fields.get(key) is Some(String(text)) else {
    fail("Missing package field " + key)
  }
  text
}

///|
fn manifest_version(source : String) -> String raise {
  for line in source.split("\n") {
    if line.trim_start().has_prefix("version = \"") {
      return line.split("\"").to_array()[1].to_owned()
    }
  }
  fail("Missing module version")
}

///|
async fn seed(
  root : String,
  registry_home : String,
  fixture : String,
  name : String,
  version : String,
  seen : Set[String],
  profile : ConsumerProfile,
) -> Unit {
  assert_true(
    allowed(name, profile),
    msg="Unexpected integration dependency " + name,
  )
  let coordinate = name + "@" + version
  if seen.contains(coordinate) {
    return
  }
  seen.add(coordinate)
  let local_module = match name {
    "moonrockz/smithy-validation" => Some("pkgs/smithy-validation")
    "moonrockz/smithy-ion-validation" => Some("pkgs/smithy-ion-validation")
    "moonrockz/smithy" => Some("pkgs/smithy")
    "moonrockz/smithy-syntax" => Some("pkgs/smithy-syntax")
    "moonrockz/jmespath" => Some("pkgs/jmespath")
    "moonrockz/smithy-jsonschema" => Some("pkgs/smithy-jsonschema")
    "moonrockz/smithy-openrpc" => Some("pkgs/smithy-openrpc")
    _ => None
  }
  let index_path = "registry/index/user/" + name + ".index"
  let archive_path = "registry/cache/" + name + "/" + version + ".zip"
  let (entry, bytes) = match local_module {
    Some(path) => {
      let manifest = @fs.read_file(root + "/" + path + "/moon.mod").text()
      assert_eq(manifest_version(manifest), version)
      let (code, _, err) = @process.collect_output(
        "moon",
        ["-C", path, "package"],
        cwd=root,
      )
      assert_eq(code, 0, msg=err.text())
      let bytes = @fs.read_file(
        root +
        "/_build/publish/" +
        name.replace_all(old="/", new="-") +
        "-" +
        version +
        ".zip",
      ).binary()
      let deps : Map[String, Json] = Map([])
      for line in manifest.split("\n") {
        let text = line.trim_start()
        if !text.has_prefix("\"") {
          continue
        }
        let parts = text[1:].split("\"").next().unwrap().split("@").to_array()
        if parts.length() == 2 {
          deps[parts[0].to_owned()] = Json::string(parts[1].to_owned())
        }
      }
      (
        Json::object({
          "name": Json::string(name),
          "version": Json::string(version),
          "deps": Json::object(deps),
          "checksum": Json::string(
            @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
          ),
        }),
        Some(bytes),
      )
    }
    None => {
      let mut found : Json? = None
      for
        line in @fs.read_file(registry_home + "/" + index_path)
        .text()
        .split("\n") {
        if line.trim().is_empty() {
          continue
        }
        let entry = @json.parse(line.to_owned())
        if string_field(entry, "version") == version {
          found = Some(entry)
          break
        }
      }
      guard found is Some(entry) else {
        fail("Missing cached dependency " + coordinate)
      }
      // A clean CI cache need not contain every transitive minimum version.
      // Moon downloads a selected uncached version and verifies its checksum.
      let cached = registry_home + "/" + archive_path
      (
        entry,
        if @fs.exists(cached) {
          Some(@fs.read_file(cached).binary())
        } else {
          None
        },
      )
    }
  }
  let index = fixture + "/" + index_path
  let previous = if @fs.exists(index) {
    @fs.read_file(index).text()
  } else {
    ""
  }
  write(index, previous + entry.stringify() + "\n")
  if bytes is Some(bytes) {
    write(fixture + "/" + archive_path, bytes)
  }
  if entry is Object(fields) && fields.get("deps") is Some(Object(deps)) {
    for dependency, pin in deps {
      guard pin is String(pin) else { fail("Expected a pinned dependency") }
      seed(root, registry_home, fixture, dependency, pin, seen, profile)
    }
  }
}

///|
fn manifest_name(source : String) -> String raise {
  if source.trim_start().has_prefix("{") {
    return string_field(@json.parse(source), "name")
  }
  for line in source.split("\n") {
    if line.trim_start().has_prefix("name = \"") {
      return line.split("\"").to_array()[1].to_owned()
    }
  }
  fail("Missing module name")
}

///|
async fn audit_manifests(
  dir : String,
  profile : ConsumerProfile,
  resolved : Set[String],
) -> Int32 {
  let mut count = 0
  for entry in @fs.readdir(dir) {
    let path = dir + "/" + entry
    if @fs.kind(path) is Directory {
      count += audit_manifests(path, profile, resolved)
    } else if entry == "moon.mod" || entry == "moon.mod.json" {
      let source = @fs.read_file(path).text()
      resolved.add(manifest_name(source))
      for name in integration_modules {
        if !allowed(name, profile) {
          assert_false(
            source.contains(name),
            msg="Unexpected dependency " + name + " in " + path,
          )
        }
      }
      count += 1
    }
  }
  count
}

///|
async fn exercise(
  root : String,
  targets : Array[String],
  profile~ : ConsumerProfile = JsonConsumer,
) -> Unit {
  let dir = root +
    (if profile == IonConsumer {
      "/.dev/out/ion-validation-consumer"
    } else if profile == OpenRpcConsumer {
      "/.dev/out/openrpc-consumer"
    } else {
      "/.dev/out/validation-consumer"
    })
  if @fs.exists(dir) {
    @fs.rmdir(dir, recursive=true)
  }
  @fs.mkdir(dir, recursive=true)
  let registry_home = @env.get_env_var("MOON_HOME").unwrap_or_else(() => {
    @env.get_env_var("HOME").unwrap() + "/.moon"
  })
  let fixture = dir + "/moon"
  let version = manifest_version(@fs.read_file(root + "/moon.mod").text())
  let seen : Set[String] = Set([])
  seed(
    root,
    registry_home,
    fixture,
    if profile == IonConsumer {
      "moonrockz/smithy-ion-validation"
    } else if profile == OpenRpcConsumer {
      "moonrockz/smithy-openrpc"
    } else {
      "moonrockz/smithy-validation"
    },
    version,
    seen,
    profile,
  )
  for
    example_name in (if profile == IonConsumer {
      ["ion-validation-consumer"]
    } else if profile == OpenRpcConsumer {
      ["openrpc"]
    } else {
      ["validation-consumer", "rpc-consumer"]
    }) {
    let consumer = dir + "/" + example_name
    write(consumer + "/moon.work", "members = [\".\"]\n")
    write(
      consumer + "/moon.mod",
      "name = \"validation-consumer\"\nversion = \"0.0.0\"\nimport {\n  \"moonrockz/smithy@\{version}\",\n  \"moonrockz/smithy-validation@\{version}\",\n" +
      (if profile == IonConsumer {
        "  \"moonrockz/smithy-ion-validation@\{version}\",\n  \"moonrockz/ion@0.6.0\",\n"
      } else if profile == OpenRpcConsumer {
        "  \"moonrockz/smithy-openrpc@\{version}\",\n"
      } else {
        ""
      }) +
      "}\n",
    )
    let validation_import = if profile == IonConsumer {
      "\"moonrockz/smithy-ion-validation\" @validation,\n  \"moonrockz/ion/ion\","
    } else if profile == OpenRpcConsumer {
      "\"moonrockz/smithy-validation/rpc\",\n  \"moonrockz/smithy-openrpc\" @openrpc,"
    } else if example_name == "rpc-consumer" {
      "\"moonrockz/smithy-validation/rpc\","
    } else {
      "\"moonrockz/smithy-validation\" @validation,"
    }
    write(
      consumer + "/moon.pkg",
      "pkgtype(kind: \"executable\")\nimport {\n  \"moonrockz/smithy\",\n  " +
      validation_import +
      "\n}\n",
    )
    let example = @fs.read_file(
      root + "/examples/" + example_name + "/main.mbtx",
    ).text()
    guard example.find("///|\nfn main") is Some(start) else {
      fail("Missing standalone example body")
    }
    write(consumer + "/main.mbt", example[start:].to_owned())
    let extra_env = { "MOON_HOME": fixture }
    for target in targets {
      assert_true(
        ["native", "wasm", "js", "wasm-gc"].contains(target),
        msg="Unknown consumer target",
      )
      let (code, out, err) = @process.collect_output(
        "moon",
        ["-C", consumer, "run", ".", "--target", target, "--deny-warn"],
        cwd=dir,
        extra_env~,
      )
      assert_eq(code, 0, msg=err.text())
      if profile == OpenRpcConsumer {
        let document = @json.parse(out.text())
        assert_true(
          document
          is { "openrpc": String("1.3.2"), "methods": Array(methods), .. } &&
          methods.length() == 1,
        )
        write(dir + "/" + target + ".json", out)
      } else {
        assert_eq(
          out.text().trim().to_owned(),
          if profile == IonConsumer {
            "ion valid=true invalid=Range at /count"
          } else if example_name == "rpc-consumer" {
            "rpc valid=true invalid=Range at /params/0"
          } else {
            "valid=true invalid=Range at /count"
          },
        )
      }
      println("Isolated " + example_name + " passed: " + target)
    }
    let resolved : Set[String] = Set([])
    let audited = audit_manifests(consumer + "/.mooncakes", profile, resolved)
    assert_true(
      audited >= 4,
      msg="Expected the full resolved model/validation module graph",
    )
    if profile == IonConsumer {
      assert_true(
        resolved.contains("moonrockz/smithy-ion-validation") &&
        resolved.contains("moonrockz/ion"),
        msg="Expected the published adapter and Ion in the resolved graph",
      )
    }
    println(
      "Audited " +
      audited.to_string() +
      " resolved manifests within the consumer's dependency profile",
    )
  }
}

///|
async fn main {
  let targets = @env.args()[1:].to_owned()
  let profile = if targets.length() > 0 && targets[0] == "--ion" {
    IonConsumer
  } else if targets.length() > 0 && targets[0] == "--openrpc" {
    OpenRpcConsumer
  } else {
    JsonConsumer
  }
  if profile != JsonConsumer {
    targets.remove(0) |> ignore
  }
  exercise(
    @fs.realpath("."),
    if targets.is_empty() {
      ["native", "wasm", "js", "wasm-gc"]
    } else {
      targets
    },
    profile~,
  )
}

///|
async test "isolated validation consumer resolves no optional integrations" {
  exercise(@fs.realpath(".."), ["native", "wasm", "js", "wasm-gc"])
}

///|
test "ordinary validation excludes the optional Ion adapter" {
  assert_false(allowed("moonrockz/smithy-ion-validation", JsonConsumer))
  assert_false(allowed("moonrockz/ion", JsonConsumer))
  assert_false(allowed("moonrockz/smithy-ion-validation", OpenRpcConsumer))
  assert_false(allowed("moonrockz/ion", OpenRpcConsumer))
}

///|
test "Ion consumer allows its adapter but excludes WIT and unrelated integrations" {
  assert_true(allowed("moonrockz/smithy-ion-validation", IonConsumer))
  assert_true(allowed("moonrockz/ion", IonConsumer))
  for
    name in [
      "moonrockz/wit", "moonrockz/wac", "moonrockz/wasm-devkit", "moonrockz/smithy-openapi",
      "moonrockz/smithy-jsonschema", "moonrockz/smithy-openrpc",
    ] {
    assert_false(allowed(name, IonConsumer))
  }
}

///|
async test "isolated Ion consumer resolves Ion and excludes WIT" {
  exercise(
    @fs.realpath(".."),
    ["native", "wasm", "js", "wasm-gc"],
    profile=IonConsumer,
  )
}
