----
import {
  "moonbitlang/async@0.22.7",
  "moonbitlang/async@0.22.7/fs",
  "moonbitlang/async@0.22.7/process",
  "moonbitlang/async@0.22.7/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/sys",
}
----

///|
/// Build both channels of the site as GitHub Pages serves them, and check the links of each.
///
/// Usage: `mise run site:pages -- --out _site`, or `moonx scripts/site-pages.mbtx --out _site`.
/// Each channel is a full build of its own checkout. The root (`/smithy/`) is the release channel built
/// from the newest stable tag, in a temporary git worktree, when that tag contains `site/moon.mod`. When
/// no tag does, the root is `main` with channel next and the "unreleased" banner. `/smithy/next/` is
/// always `main`. The workflow and `mise run site:check` both use this script.

///|
let site_root : String = "/smithy/"

///|
let default_out : String = "_site"

///|
/// The release version shown while no tag exists.
let no_tag_version : String = "v0.0.0"

///|
/// One build: where the `site/` comes from, which channel and which bases.
struct Build {
  /// The checkout to build. `None` is the working tree.
  checkout : String?
  channel : String
  /// The base of the output when it is not the one the channel implies.
  base : String?
  /// False while no release has a site: the pages then name and link no release.
  has_release : Bool
  version : String
  git_ref : String
  /// The output directory below the Pages root: "" for the root.
  sub : String
} derive(Eq, Debug)

///|
/// The builds for a Pages deploy. `tag` is the newest stable tag, if any; `tag_has_site` tells whether
/// that tag contains `site/moon.mod`; `head` is the commit of `main`; `release_dir` is where the worktree
/// of the tag lives.
fn plan(
  tag : String?,
  tag_has_site : Bool,
  head : String,
  release_dir : String,
) -> Array[Build] {
  let version = tag.unwrap_or(no_tag_version)
  let next : Build = {
    checkout: None,
    channel: "next",
    base: None,
    has_release: tag_has_site && tag is Some(_),
    version,
    git_ref: head,
    sub: "next",
  }
  match tag {
    Some(tag) if tag_has_site =>
      [
        {
          checkout: Some(release_dir),
          channel: "release",
          base: None,
          has_release: true,
          version: tag,
          git_ref: tag,
          sub: "",
        },
        next,
      ]
    _ =>
      [
        {
          checkout: None,
          channel: "next",
          base: Some(site_root),
          has_release: false,
          version,
          git_ref: head,
          sub: "",
        },
        next,
      ]
  }
}

///|
/// The value after `--out`, or the default.
fn out_of(args : ArrayView[String]) -> String {
  let mut out = default_out
  let mut i = 0
  while i + 1 < args.length() {
    if args[i] == "--out" {
      out = args[i + 1]
    }
    i += 1
  }
  out
}

///|
/// The arguments of `site-build.mbtx` for one build. `out` is absolute: the build may run in a worktree.
fn build_args(build : Build, out : String) -> Array[String] {
  let args = [
    "scripts/site-build.mbtx",
    "--content",
    ".",
    "--channel",
    build.channel,
    "--site-root",
    site_root,
    "--release-version",
    build.version,
    "--ref",
    build.git_ref,
    "--out",
    out,
  ]
  if build.base is Some(base) {
    args.push("--base")
    args.push(base)
  }
  if !build.has_release {
    args.push("--no-release")
  }
  args
}

///|
/// The arguments of `site-linkcheck.mbtx`. The root site ignores the `next/` site below it.
fn linkcheck_args(build : Build, out : String) -> Array[String] {
  let base = if build.sub.is_empty() {
    site_root
  } else {
    site_root + build.sub + "/"
  }
  let args = ["scripts/site-linkcheck.mbtx", "--dist", out, "--base", base]
  if build.sub.is_empty() {
    args.push("--ignore")
    args.push(site_root + "next/")
  }
  args
}

///|
/// A command and its working directory (`None`: the working directory of this script).
struct Command {
  command : String
  args : Array[String]
  cwd : String?
} derive(Eq, Debug)

///|
/// The commands that prepare the worktree of a release tag for its build. mise refuses the config files
/// of a directory that it does not trust, and every mise shim (moon, moonx, bun) then fails in the
/// worktree. A tag whose `site/mise.toml` pins the site tools gets them installed, because an older tag
/// can pin another bun.
fn trust_commands(release_dir : String, has_site_mise : Bool) -> Array[Command] {
  let commands = [{ command: "mise", args: ["trust", release_dir], cwd: None, }]
  if has_site_mise {
    let site = release_dir + "/site"
    commands.push({ command: "mise", args: ["trust", site], cwd: None, })
    commands.push({ command: "mise", args: ["install"], cwd: Some(site), })
  }
  commands
}

///|
/// The MoonBit toolchain of a release tag. The release channel is built with the toolchain that its tag
/// pins, not with the toolchain of this checkout: a newer compiler can reject the sources of an older
/// tag (MoonBit 0.10.18 rejects a match of v0.8.0 that misses a new `@json.ParseError` case).
struct Toolchain {
  /// The mise install directory of `http:moonbit` for the tag.
  home : String
  /// The pinned MoonBit version.
  version : String
} derive(Eq, Debug)

///|
/// The command that installs the MoonBit toolchain of the worktree `release_dir`, as its mise config pins it.
fn toolchain_install(release_dir : String) -> Command {
  {
    command: "mise",
    args: ["install", "http:moonbit"],
    cwd: Some(release_dir),
  }
}

///|
/// The command that completes a toolchain without its core library. A tag pinned before MoonBit 0.10.18 has
/// no postinstall hook that adds the core, so the official installer adds it, as the setup action of
/// those tags did. The site workflow runs on Linux.
fn core_install(toolchain : Toolchain) -> Command {
  {
    command: "bash",
    args: [
      "-c",
      "set -euo pipefail; curl -fsSL https://cli.moonbitlang.com/install/unix.sh | MOON_HOME=\"$1\" bash -s -- \"$2\"",
      "core-install",
      toolchain.home,
      toolchain.version,
    ],
    cwd: None,
  }
}

///|
/// The command and arguments that run `moonx` with `args` for `build`. A build of a worktree runs in that
/// worktree's toolchain: `mise exec` there puts its pinned tools first on `PATH`.
fn moonx_command(
  build : Build,
  args : Array[String],
) -> (String, Array[String]) {
  match build.checkout {
    Some(dir) => {
      let full = ["exec", "-C", dir, "--", "moonx"]
      full.append(args)
      ("mise", full)
    }
    None => ("moonx", args)
  }
}

///|
/// The environment of a build: a worktree build gets `MOON_HOME` of its own toolchain, because the setup
/// action exports `MOON_HOME` of this checkout.
fn build_env(build : Build, toolchain : Toolchain?) -> Map[String, String] {
  match (build.checkout, toolchain) {
    (Some(_), Some(t)) => { "MOON_HOME": t.home }
    _ => {}
  }
}

///|
/// Run a command; return its exit code, 1 for a command that did not run.
async fn run(
  command : String,
  args : Array[String],
  cwd? : String,
  extra_env~ : Map[String, String] = {},
) -> Int32 {
  let dir : StringView? = match cwd {
    Some(d) => Some(d[:])
    None => None
  }
  let code = @process.run(
    command,
    args,
    cwd?=dir,
    extra_env~,
    stdout=@stdio.stdout,
    stderr=@stdio.stderr,
  ) catch {
    error => {
      eprintln("site:pages: `\{command}` did not run: \{error}")
      return 1
    }
  }
  if code >= 0 {
    code
  } else {
    1
  }
}

///|
/// The output of a command, trimmed; `None` when it failed.
async fn capture(
  command : String,
  args : Array[String],
  cwd? : String,
) -> String? {
  let dir : StringView? = match cwd {
    Some(d) => Some(d[:])
    None => None
  }
  let (code, output, _) = @process.collect_output(command, args, cwd?=dir)
  if code == 0 {
    Some(output.text().trim().to_owned())
  } else {
    None
  }
}

///|
/// Build and check every build of the plan; return the first non-zero code.
async fn execute(
  builds : Array[Build],
  out_root : String,
  toolchain : Toolchain?,
) -> Int32 {
  for build in builds {
    let out = if build.sub.is_empty() {
      out_root
    } else {
      out_root + "/" + build.sub
    }
    @fs.mkdir(out, recursive=true, allow_exist=true)
    let cwd = build.checkout
    let (command, args) = moonx_command(build, build_args(build, out))
    let code = run(command, args, cwd?, extra_env=build_env(build, toolchain))
    if code != 0 {
      return code
    }
  }
  for build in builds {
    let out = if build.sub.is_empty() {
      out_root
    } else {
      out_root + "/" + build.sub
    }
    let (command, args) = moonx_command(build, linkcheck_args(build, out))
    let code = run(
      command,
      args,
      cwd?=build.checkout,
      extra_env=build_env(build, toolchain),
    )
    if code != 0 {
      return code
    }
  }
  0
}

///|
async fn steps(out_root : String, release_dir : String) -> Int32 {
  let tag = match capture("moonx", ["scripts/site-latest-tag.mbtx"]) {
    Some("") => None
    Some(tag) => Some(tag)
    None => {
      eprintln("site:pages: cannot find the latest tag")
      return 1
    }
  }
  let head = match capture("git", ["rev-parse", "HEAD"]) {
    Some(head) => head
    None => {
      eprintln("site:pages: cannot read HEAD")
      return 1
    }
  }
  let has_site = match tag {
    Some(tag) =>
      capture("git", ["cat-file", "-e", tag + ":site/moon.mod"]) is Some(_)
    None => false
  }
  let toolchain : Toolchain? = match tag {
    Some(tag) if has_site => {
      println(
        "site:pages: \{tag} has site/: the root is the release build of \{tag}",
      )
      let code = run("git", [
        "-c", "core.hooksPath=/dev/null", "worktree", "add", "--detach", release_dir,
        tag,
      ])
      if code != 0 {
        return code
      }
      let has_site_mise = @fs.exists(release_dir + "/site/mise.toml")
      for step in trust_commands(release_dir, has_site_mise) {
        let code = run(step.command, step.args, cwd?=step.cwd)
        if code != 0 {
          eprintln(
            "site:pages: `\{step.command} \{step.args.join(" ")}` failed for the worktree of \{tag}",
          )
          return code
        }
      }
      let install = toolchain_install(release_dir)
      if run(install.command, install.args, cwd?=install.cwd) != 0 {
        eprintln("site:pages: the MoonBit toolchain of \{tag} did not install")
        return 1
      }
      let where_ = capture("mise", ["where", "http:moonbit"], cwd=release_dir)
      let current = capture(
        "mise",
        ["current", "http:moonbit"],
        cwd=release_dir,
      )
      guard where_ is Some(home) && current is Some(version) else {
        eprintln("site:pages: cannot find the MoonBit toolchain of \{tag}")
        return 1
      }
      let toolchain = { home, version, }
      if !@fs.exists(home + "/lib/core/moon.mod") {
        let core = core_install(toolchain)
        if run(core.command, core.args) != 0 {
          eprintln("site:pages: the MoonBit core of \{tag} did not install")
          return 1
        }
      }
      println("site:pages: \{tag} builds with MoonBit \{version}")
      Some(toolchain)
    }
    _ => {
      println(
        "site:pages: no stable tag contains site/: the root is main (unreleased)",
      )
      None
    }
  }
  execute(plan(tag, has_site, head, release_dir), out_root, toolchain)
}

///|
async fn cleanup(tmp : String) -> Unit {
  // Ignore failures, and keep git quiet: the worktree exists only when a release tag has site/.
  let _ = capture("git", [
    "-c",
    "core.hooksPath=/dev/null",
    "worktree",
    "remove",
    "--force",
    tmp + "/release",
  ])
  let _ = capture("git", ["-c", "core.hooksPath=/dev/null", "worktree", "prune"])
  @fs.rmdir(tmp, recursive=true)
}

///|
/// Run `body`, then `after` on every exit path, also when `body` raises.
async fn with_cleanup(
  body : async () -> Int32,
  after : async () -> Unit,
) -> Int32 {
  let code = body() catch {
    error => {
      eprintln("site:pages: \{error}")
      1
    }
  }
  after() catch {
    error => eprintln("site:pages: cleanup failed: \{error}")
  }
  code
}

///|
async fn main {
  let out_arg = out_of(@env.args()[1:])
  @fs.mkdir(out_arg, recursive=true, allow_exist=true)
  let out_root = @fs.realpath(out_arg)
  let tmp = @fs.tmpdir(prefix="site-pages")
  let code = with_cleanup(() => steps(out_root, tmp + "/release"), () => {
    cleanup(tmp)
  })
  if code != 0 {
    eprintln("site:pages: failed")
    @sys.exit(code)
  }
  println("site:pages: OK")
}

///|
test "build_args adds --base only for a root build of main" {
  let builds = plan(Some("v0.5.0"), false, "abc", "/w")
  let root = build_args(builds[0], "/o")
  assert_eq(root[root.length() - 3:].to_owned(), [
    "--base", "/smithy/", "--no-release",
  ])
  let next = build_args(builds[1], "/o/next")
  assert_true(!next.contains("--base"))
  assert_true(next.contains("--no-release"))
  let released = plan(Some("v1.2.0"), true, "abc", "/w")
  assert_true(!build_args(released[0], "/o").contains("--no-release"))
  assert_true(!build_args(released[1], "/o/next").contains("--no-release"))
}

///|
test "linkcheck_args: the root ignores next/, next does not" {
  let builds = plan(Some("v0.5.0"), false, "abc", "/w")
  assert_eq(linkcheck_args(builds[0], "/o"), [
    "scripts/site-linkcheck.mbtx", "--dist", "/o", "--base", "/smithy/", "--ignore",
    "/smithy/next/",
  ])
  assert_eq(linkcheck_args(builds[1], "/o/next"), [
    "scripts/site-linkcheck.mbtx", "--dist", "/o/next", "--base", "/smithy/next/",
  ])
}

///|
test "out_of reads --out and defaults to _site" {
  assert_eq(out_of(["--out", "x"]), "x")
  assert_eq(out_of([]), "_site")
}

///|
async test "with_cleanup runs the cleanup after a body that raises" {
  let ran = Ref(false)
  assert_eq(with_cleanup(() => fail("boom"), () => ran.val = true), 1)
  assert_true(ran.val)
}

///|
test "a tag with site/ gives the release channel at the root from the tag worktree" {
  let builds = plan(Some("v1.2.0"), true, "abc", "/w/release")
  assert_eq(builds.length(), 2)
  assert_eq(builds[0], {
    checkout: Some("/w/release"),
    channel: "release",
    base: None,
    has_release: true,
    version: "v1.2.0",
    git_ref: "v1.2.0",
    sub: "",
  })
  assert_eq(builds[1], {
    checkout: None,
    channel: "next",
    base: None,
    has_release: true,
    version: "v1.2.0",
    git_ref: "abc",
    sub: "next",
  })
}

///|
test "a tag without site/ gives main at the root with channel next, and main at next" {
  let builds = plan(Some("v0.5.0"), false, "abc", "/w/release")
  assert_eq(builds.length(), 2)
  assert_eq(builds[0], {
    checkout: None,
    channel: "next",
    base: Some("/smithy/"),
    has_release: false,
    version: "v0.5.0",
    git_ref: "abc",
    sub: "",
  })
  assert_eq(builds[1].sub, "next")
  assert_eq(builds[1].checkout, None)
  // Both outputs name no release, so neither links to a release page that does not exist.
  assert_eq(builds[1].has_release, false)
}

///|
test "no tag at all gives the same plan as a tag without site/" {
  let builds = plan(None, false, "abc", "/w/release")
  assert_eq(builds[0].channel, "next")
  assert_eq(builds[0].base, Some("/smithy/"))
  assert_eq(builds[0].version, "v0.0.0")
  assert_eq(builds[1].sub, "next")
}

///|
test "a missing tag never uses the worktree even when told the tag has site/" {
  let builds = plan(None, true, "abc", "/w/release")
  assert_eq(builds[0].checkout, None)
  assert_eq(builds[0].channel, "next")
}

///|
test "the release worktree trusts its mise config, and its site tools when it pins them" {
  assert_eq(trust_commands("/w", false), [
    { command: "mise", args: ["trust", "/w"], cwd: None, },
  ])
  assert_eq(trust_commands("/w", true), [
    { command: "mise", args: ["trust", "/w"], cwd: None, },
    { command: "mise", args: ["trust", "/w/site"], cwd: None, },
    { command: "mise", args: ["install"], cwd: Some("/w/site"), },
  ])
}

///|
test "a worktree build runs moonx in the toolchain of its tag" {
  let builds = plan(Some("v1.2.0"), true, "abc", "/w/release")
  let toolchain = Some({ home: "/t/0.10.15", version: "0.10.15+943464bfa", })
  assert_eq(
    moonx_command(builds[0], ["scripts/a.mbtx"]),
    ("mise", ["exec", "-C", "/w/release", "--", "moonx", "scripts/a.mbtx"]),
  )
  assert_eq(build_env(builds[0], toolchain), { "MOON_HOME": "/t/0.10.15" })
  assert_eq(
    moonx_command(builds[1], ["scripts/a.mbtx"]),
    ("moonx", ["scripts/a.mbtx"]),
  )
  assert_eq(build_env(builds[1], toolchain), {})
}

///|
test "the toolchain of a tag is installed from the worktree and its core completed" {
  assert_eq(toolchain_install("/w/release"), {
    command: "mise",
    args: ["install", "http:moonbit"],
    cwd: Some("/w/release"),
  })
  let core = core_install({ home: "/t/0.10.15", version: "0.10.15+943464bfa", })
  assert_eq(core.command, "bash")
  assert_eq(core.args[core.args.length() - 2:].to_owned(), [
    "/t/0.10.15", "0.10.15+943464bfa",
  ])
}
