///|
async fn java_files(dir : String) -> Array[String] {
  let files : Array[String] = []
  for name in @fs.readdir(dir) {
    let path = dir + "/" + name
    if @fs.kind(path) is Directory {
      files.append(java_files(path))
    } else if name.has_suffix(".java") && name != "module-info.java" {
      files.push(path)
    }
  }
  files
}

///|
async fn copy_resources(source : String, destination : String) -> Unit {
  if !@fs.exists(source) {
    return
  }
  @fs.mkdir(destination, recursive=true, allow_exist=true)
  for name in @fs.readdir(source) {
    let from = source + "/" + name
    let to = destination + "/" + name
    if @fs.kind(from) is Directory {
      copy_resources(from, to)
    } else {
      @fs.write_file(to, @fs.read_file(from))
    }
  }
}

///|
async fn checked(command : String, args : Array[String]) -> String {
  let (status, output, errors) = @process.collect_output(command, args)
  if status != 0 {
    println(command + " failed")
    println(errors.text())
    println(output.text())
    @sys.exit(1)
  }
  output.text()
}

///|
async fn main {
  let args = @env.args()
  let mode = if args.length() > 1 { args[1] } else { "build" }
  if !["build", "validation", "all"].contains(mode) {
    println(
      "Usage: moonx scripts/reference-build.mbtx [build|validation|all] [CHECKOUT]",
    )
    @sys.exit(1)
  }
  let checkout = if args.length() > 2 {
    args[2]
  } else {
    ".dev/out/reference-smithy"
  }
  let actual_sha = checked("git", ["-C", checkout, "rev-parse", "HEAD"])
    .trim()
    .to_owned()
  if actual_sha != reference_sha {
    println("Expected reference SHA " + reference_sha + ", found " + actual_sha)
    @sys.exit(1)
  }
  let changes = checked("git", ["-C", checkout, "status", "--porcelain"])
    .trim()
    .to_owned()
  if !changes.is_empty() {
    println(
      "The reference checkout must be clean before generating pinned goldens",
    )
    @sys.exit(1)
  }
  let scratch = ".dev/out/reference-build"
  let classes = scratch + "/classes"
  @fs.mkdir(classes, recursive=true, allow_exist=true)
  let source = scratch + "/ReferenceBuildCorpus.java"
  @fs.write_file(source, harness)
  let files = [source]
  for
    module_ in [
      "smithy-utils", "smithy-jmespath", "smithy-model", "smithy-build",
    ] {
    files.append(java_files(checkout + "/" + module_ + "/src/main/java"))
    copy_resources(checkout + "/" + module_ + "/src/main/resources", classes)
  }
  println("Compiling pinned reference main sources")
  let options = [
    "-proc:none", "-encoding", "UTF-8", "-d", classes, "-cp", classes,
  ]
  options.append(files)
  ignore(checked("javac", options))
  let repository = checked("git", ["rev-parse", "--show-toplevel"])
    .trim()
    .to_owned()
  println(
    checked("java", ["-cp", classes, "ReferenceBuildCorpus", mode, repository]).trim(),
  )
}
