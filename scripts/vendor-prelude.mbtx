///|
/// Vendor the official Smithy prelude and contract traits for file-system-free loads.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
async fn fetch(url : String) -> String {
  let (code, out, err) = @process.collect_output("curl", ["-fsSL", url])
  if code != 0 { eprintln(err.text()); @sys.exit(1) }
  out.text()
}

///|
async fn vendor(sha : String, path : String, name : String, function_ : String) -> Unit {
  let text = fetch("https://raw.githubusercontent.com/smithy-lang/smithy/\{sha}/\{path}")
  @fs.write_file("pkgs/smithy/\{name}.smithy", text)
  let out = StringBuilder()
  out.write_string("// Generated by scripts/vendor-prelude.mbtx from smithy-lang/smithy at \{sha}.\n// Copyright Amazon.com, Inc. or its affiliates. Apache-2.0.\n\n///|\nfn \{function_}() -> String {\n  (\n")
  for line in text.split("\n") { out.write_string("    #|\{line}\n") }
  out.write_string("  )\n}\n")
  @fs.write_file("pkgs/smithy/\{name}_data.mbt", out.to_string())
}

///|
async fn main {
  let args = @env.args()
  let ref_ = if args.length() > 1 { args[1] } else { "main" }
  let commit = @json.parse(fetch("https://api.github.com/repos/smithy-lang/smithy/commits/\{ref_}"))
  guard commit is { "sha": String(sha), .. } else { eprintln("No commit SHA in GitHub response"); @sys.exit(1); return }
  vendor(sha, "smithy-model/src/main/resources/software/amazon/smithy/model/loader/prelude.smithy", "prelude", "prelude_text")
  vendor(sha, "smithy-contract-traits/src/main/resources/META-INF/smithy/contracts.smithy", "contracts", "contracts_text")
  @fs.write_file("pkgs/smithy/PRELUDE_SHA", sha + "\n")
  let code = @process.run("moon", ["fmt"])
  if code != 0 { @sys.exit(code) }
  println("Vendored Smithy prelude and contract traits at \{sha}")
}
