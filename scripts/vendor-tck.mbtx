///|
/// Vendor the IDL cases of the Java reference's loader tests into
/// `tests/tck/cases/` and generate `tests/tck/cases.mbt`, so the
/// parity tests need no network and no file system on any target.
///
/// Usage: `mise run tck:vendor [-- <git ref>]` (default `main`). Needs `curl`.
/// `mise run tck:vendor:json` vendors JSON AST cases instead of IDL cases.
/// Source: https://github.com/smithy-lang/smithy, Apache-2.0; the NOTICE is kept.
///
/// Set `GITHUB_TOKEN` to raise the GitHub API's 60/hour unauthenticated limit
/// (the listing alone makes about 30 calls); raw downloads need no token.
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/process",
  "moonbitlang/async@0.22.5/io",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/sys",
}

///|
let base : String = "smithy-model/src/test/resources/software/amazon/smithy/model/loader"

///|
/// The directories to vendor and the kind of each.
let groups : Array[(String, String)] = [
  ("valid", "valid"),
  ("invalid", "invalid"),
  ("error-recovery", "recovery"),
]

///|
/// Report a `curl` failure and exit. `api` adds a `GITHUB_TOKEN` reminder:
/// the api.github.com rate limit is the most likely cause.
fn curl_failed(url : String, err : String, api~ : Bool = false) -> Unit {
  println("❌ curl failed for \{url}")
  if !err.is_empty() {
    println(err)
  }
  if api && @env.get_env_var("GITHUB_TOKEN") is None {
    println(
      "   Set GITHUB_TOKEN to raise the GitHub API's 60/hour unauthenticated limit, e.g. (PowerShell) $env:GITHUB_TOKEN = (gh auth token)",
    )
  }
  @sys.exit(1)
}

///|
/// GET `url` with `curl`, exiting the script on failure.
async fn fetch(url : String) -> String {
  let (code, out, err) = @process.collect_output("curl", ["-fsSL", url])
  if code != 0 {
    curl_failed(url, err.text())
  }
  out.text()
}

///|
/// GET a `api.github.com` URL, with the `GITHUB_TOKEN` header when set.
async fn fetch_api(url : String) -> String {
  // Feed curl's header config through stdin so the token never appears in
  // process arguments or a temporary file. Raw downloads are unauthenticated.
  let (code, out, err) = match @env.get_env_var("GITHUB_TOKEN") {
    None => @process.collect_output("curl", ["-fsSL", url])
    Some(token) => curl_with_config(url, auth_config(token))
  }
  if code != 0 {
    curl_failed(url, err.text(), api=true)
  }
  out.text()
}

///|
/// Every `.smithy` file path under `dir` (recursive) at `sha`, via the
/// GitHub API.
async fn list_smithy(
  sha : String,
  dir : String,
  suffix~ : String = ".smithy",
) -> Array[String] {
  let listing = fetch_api(
    "https://api.github.com/repos/smithy-lang/smithy/contents/\{dir}?ref=\{sha}",
  )
  let found : Array[String] = []
  guard @json.parse(listing) is Array(entries) else {
    println("❌ unexpected listing for \{dir}")
    @sys.exit(1)
    return found
  }
  for e in entries {
    guard e is Object(o) &&
      o.get("type") is Some(String(t)) &&
      o.get("path") is Some(String(p)) else {
      continue
    }
    if t == "dir" {
      found.append(list_smithy(sha, p, suffix~))
    } else if p.has_suffix(suffix) {
      found.push(p)
    }
  }
  found
}

///|
/// `s` as a non-negative decimal integer, or `None` if any character is not
/// an ASCII digit (including when `s` is empty).
fn digits(s : String) -> Int32? {
  if s.is_empty() {
    return None
  }
  let mut value = 0
  for ch in s {
    if ch < '0' || ch > '9' {
      return None
    }
    value = value * 10 + (ch.to_int() - '0'.to_int())
  }
  Some(value)
}

///|
/// The line, column and message from an invalid case's first line, when it
/// is a syntax-error header (`// Syntax error at line L, column C: message`
/// or `// Parse error at line L, column C near ...: message`). `None` for a
/// semantic case: the loader reports those, not the parser, so the parity
/// test only checks that *some* error is reported.
fn parse_header(line : String) -> (Int32, Int32, String)? {
  guard line.has_prefix("//") else { return None }
  guard line.find("at line ") is Some(i) else { return None }
  let rest = line.unsafe_substring(start=i + 8, end=line.length())
  guard rest.find(", column ") is Some(j) else { return None }
  guard digits(rest.unsafe_substring(start=0, end=j)) is Some(line_no) else {
    return None
  }
  let rest2 = rest.unsafe_substring(start=j + 9, end=rest.length())
  let chars = rest2.to_array()
  let mut k = 0
  while k < chars.length() && chars[k] >= '0' && chars[k] <= '9' {
    k += 1
  }
  guard digits(rest2.unsafe_substring(start=0, end=k)) is Some(column) else {
    return None
  }
  let after = rest2.unsafe_substring(start=k, end=rest2.length())
  let message = match after.find(": ") {
    Some(m) => after.unsafe_substring(start=m + 2, end=after.length())
    None => after
  }
  Some((line_no, column, message))
}

///|
/// MoonBit multi-line string literal syntax for `s` (the `#|` form), or
/// `None` when `s` cannot be held that way: the `#|` form always holds at
/// least one (possibly empty) line, so it cannot represent a truly empty
/// string; and each `#|` line is written with its own `\r` trimmed, so a
/// lone `\r` (a CRLF file) would not round-trip.
fn literal(s : String) -> String? {
  if s.is_empty() || s.find("\r") is Some(_) {
    return None
  }
  let sb = StringBuilder()
  sb.write_string("(\n")
  for line in s.split("\n") {
    sb.write_string("      #|")
    sb.write_string(line.to_owned().trim_end(chars="\r").to_owned())
    sb.write_string("\n")
  }
  sb.write_string("    )")
  Some(sb.to_string())
}

///|
/// A MoonBit string literal for `s`: the lossless multi-line `#|` form when
/// possible, else an escaped literal via JSON string syntax (which MoonBit
/// string literals can also read).
fn text_expr(s : String) -> String {
  match literal(s) {
    Some(lit) => lit
    None => Json::string(s).stringify()
  }
}

///|
async fn main {
  let args = @env.args()[1:]
  let json_mode = args.length() > 0 && args[0] == "--json"
  let args = if json_mode { args[1:] } else { args }
  let ref_ : String = if args.length() > 0 { args[0] } else { "main" }
  let sha_json = fetch_api(
    "https://api.github.com/repos/smithy-lang/smithy/commits/\{ref_}",
  )
  let sha = match @json.parse(sha_json) {
    Object(o) =>
      match o.get("sha") {
        Some(String(s)) => s
        _ => {
          println("❌ no `sha` in the commit lookup response for \{ref_}")
          @sys.exit(1)
          ref_
        }
      }
    _ => {
      println("❌ unexpected commit lookup response for \{ref_}")
      @sys.exit(1)
      ref_
    }
  }
  println("📥 Vendoring the loader corpus at \{sha}")
  if json_mode {
    vendor_json(sha)
    return
  }
  if @fs.exists("tests/tck/cases") {
    @fs.rmdir("tests/tck/cases", recursive=true)
  }
  let gen = StringBuilder()
  gen.write_string(
    "// Generated by scripts/vendor-tck.mbtx from smithy-lang/smithy at \{sha}. Do not edit.\n\n",
  )
  gen.write_string("///|\npub fn cases() -> Array[Case] {\n  [\n")
  let mut count = 0
  for g in groups {
    let (dir, kind) = g
    // List and download at the same resolved commit, not the (possibly
    // moving) ref, so the two can never disagree.
    for path in list_smithy(sha, "\{base}/\{dir}") {
      let text = fetch(
        "https://raw.githubusercontent.com/smithy-lang/smithy/\{sha}/\{path}",
      )
      let rel = path.unsafe_substring(
        start=base.length() + 1,
        end=path.length(),
      )
      let dest = "tests/tck/cases/\{rel}"
      let parent_end = match dest.rev_find("/") {
        Some(i) => i
        None => 0
      }
      let parent = dest.unsafe_substring(start=0, end=parent_end)
      @fs.mkdir(parent, recursive=true, allow_exist=true)
      @fs.write_file(dest, text)
      let kind_expr = match kind {
        "valid" => "Valid"
        "recovery" => "Recovery"
        _ => {
          // `// Syntax error at line L, column C: message` or `// Parse
          // error at line L, column C near ...: message`; a semantic case's
          // first line does not match and becomes `line=0`.
          let first = match text.split("\n").next() {
            Some(l) => l.to_owned()
            None => ""
          }
          match parse_header(first) {
            Some((line, column, message)) =>
              "Invalid(line=\{line}, column=\{column}, message=\{Json::string(message).stringify()})"
            None => "Invalid(line=0, column=0, message=\"\")"
          }
        }
      }
      gen.write_string(
        "    { path: \"\{rel}\", kind: \{kind_expr}, text: \{text_expr(text)} },\n",
      )
      count += 1
    }
  }
  gen.write_string("  ]\n}\n")
  @fs.write_file("tests/tck/cases.mbt", gen.to_string())
  @fs.write_file("tests/tck/TCK_SHA", sha + "\n")
  // So a re-run produces no diff: `cases.mbt` is hand-formatted above, not
  // run through `moon fmt`'s own layout rules.
  let fmt_code = @process.run("moon", ["fmt", "tests/tck"])
  if fmt_code != 0 {
    println(
      "❌ moon fmt exited \{fmt_code}; tests/tck/cases.mbt is not formatted",
    )
    @sys.exit(1)
  }
  println("✅ Vendored \{count} cases")
}

///|
/// The valid IDL expectations and the unflattened JSON mixin models exercise
/// both flattened documents and the AST's explicit mixin/apply forms.
async fn vendor_json(sha : String) -> Unit {
  if @fs.exists("tests/tck/json-cases") {
    @fs.rmdir("tests/tck/json-cases", recursive=true)
  }
  let gen = StringBuilder()
  gen.write_string(
    "// Generated by scripts/vendor-tck.mbtx --json from smithy-lang/smithy at \{sha}. Do not edit.\n\n",
  )
  gen.write_string("///|\npub fn json_cases() -> Array[JsonCase] {\n  [\n")
  let mut count = 0
  for dir in ["valid", "mixins"] {
    for path in list_smithy(sha, "\{base}/\{dir}", suffix=".json") {
      let text = fetch(
        "https://raw.githubusercontent.com/smithy-lang/smithy/\{sha}/\{path}",
      )
      let rel = path.unsafe_substring(
        start=base.length() + 1,
        end=path.length(),
      )
      let dest = "tests/tck/json-cases/\{rel}"
      let end = dest.rev_find("/").unwrap_or(0)
      @fs.mkdir(
        dest.unsafe_substring(start=0, end~),
        recursive=true,
        allow_exist=true,
      )
      @fs.write_file(dest, text)
      gen.write_string("    { path: \"\{rel}\", text: \{text_expr(text)} },\n")
      count += 1
    }
  }
  gen.write_string("  ]\n}\n")
  @fs.write_file("tests/tck/json_cases.mbt", gen.to_string())
  @fs.write_file("tests/tck/TCK_JSON_SHA", sha + "\n")
  let code = @process.run("moon", ["fmt", "tests/tck"])
  if code != 0 {
    println("❌ moon fmt exited \{code}")
    @sys.exit(1)
  }
  println("✅ Vendored \{count} JSON AST cases")
}

///|
/// Curl config quotes the header as data, including quotes and backslashes.
fn auth_config(token : String) -> String {
  "header = " +
  Json::string("Authorization: Bearer " + token).stringify() +
  "\n"
}

///|
/// Pass config on stdin instead of exposing a credential in process arguments.
async fn curl_with_config(
  url : String,
  config : String,
) -> (Int32, &@io.Data, &@io.Data) {
  @async.with_task_group() <| group => {
    let (input, writer) = @process.write_to_process()
    group.spawn_bg() <| () => {
      defer writer.close()
      writer.write(config)
    }
    @process.collect_output(
      "curl",
      ["-fsSL", "--config", "-", url],
      stdin=input,
    )
  }
}

///|
async test "curl consumes an authentication config supplied through stdin" {
  // Read this local file so the probe needs no network. A range supplied
  // only through config proves curl actually consumed stdin; --version
  // handles malformed config differently across curl versions.
  let path = @fs.realpath("vendor-tck.mbtx")
    .replace_all(old="\\", new="/")
    .replace_all(old="%", new="%25")
    .replace_all(old=" ", new="%20")
    .replace_all(old="#", new="%23")
    .replace_all(old="?", new="%3F")
  let url = (if path.has_prefix("/") { "file://" } else { "file:///" }) + path
  let config = auth_config("test-token")
  let (code, out, err) = curl_with_config(url, config + "range = \"0-3\"\n")
  assert_eq(code, 0, msg=err.text())
  assert_eq(out.text(), "///|")
  let (code, out, err) = curl_with_config(url, config)
  assert_eq(code, 0, msg=err.text())
  assert_eq(out.text(), @fs.read_file("vendor-tck.mbtx").text())
}

///|
test "reference headers preserve columns and message facts" {
  assert_eq(
    parse_header("// Syntax error at line 4, column 16: Invalid escape | Model"),
    Some((4, 16, "Invalid escape | Model")),
  )
  assert_eq(
    parse_header(
      "// Parse error at line 2, column 9 near token: expected value",
    ),
    Some((2, 9, "expected value")),
  )
  assert_eq(parse_header("// a semantic validation error"), None)
}
