{
  "version": "2.0",
  "sources": [
    {
      "path": "models",
      "root": ".",
      "globs": [
        "**/*.smithy"
      ]
    }
  ],
  "imports": [
    {
      "path": "imports",
      "root": ".",
      "paths": [
        "shared.smithy"
      ]
    }
  ],
  "outputDirectory": "../../.dev/out/local-resources",
  "projections": {
    "extra": {
      "imports": [
        {
          "path": "projection-imports",
          "root": ".",
          "globs": [
            "*.smithy"
          ]
        }
      ]
    }
  }
}
