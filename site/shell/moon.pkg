import {
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/html",
  "moonbit-community/rabbita/sub",
  "moonbit-community/rabbita/nav",
  "moonbit-community/rabbita/url",
  "moonbit-community/rabbita/http",
  "moonbit-community/rabbita/common",
  "moonrockz/smithy",
  "moonrockz/smithy-site/route",
  "moonrockz/smithy-site/content",
  "moonrockz/smithy-site/markdown",
  "moonrockz/smithy-site/search",
  "moonrockz/smithy-site/highlight",
  "moonrockz/smithy-site/data",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
}

warnings = "-alert_experimental-unused_package"

supported_targets = "js+native"

import {
  "moonbit-community/rabbita/cmd",
  "moonbitlang/async",
} for "wbtest"
