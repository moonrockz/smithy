name = "moonrockz/smithy-site"

version = "0.0.0"

import {
  "moonbit-community/rabbita@0.16.4",
  "moonbit-community/cmark@0.4.12",
  "moonbitlang/async@0.22.5",
  "moonbitlang/x@0.5.5",
  "moonrockz/smithy@0.0.0",
  "moonrockz/smithy-syntax@0.0.0",
  "moonrockz/smithy-validation@0.0.0",
  "moonrockz/smithy-codec@0.0.0",
  "moonrockz/smithy-diff@0.0.0",
  "moonrockz/smithy-jsonschema@0.0.0",
  "moonrockz/smithy-openapi@0.0.0",
  "moonrockz/smithy-openrpc@0.0.0",
  "moonbit-community/flate@0.2.0",
}

warnings = "-implicit_impl_as_method"

license = "Apache-2.0"

description = "Landing page and docs site for smithy"

preferred_target = "js"
