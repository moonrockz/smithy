        "12-domain-modelling/start": {
            "digest": "61c2e2d4fc4b39b1b99f709d704bcd0310eae0679a2bfdcd6359fac1d4fce618",
            "events": [],
            "json_schema": {
                "definitions": {
                    "CardPayment": {
                        "properties": {
                            "lastDigits": {
                                "description": "The last four digits of the card number.",
                                "pattern": "^[0-9]{4}$",
                                "type": "string"
                            }
                        },
                        "required": [
                            "lastDigits"
                        ],
                        "type": "object"
                    },
                    "Order": {
                        "properties": {
                            "id": {
                                "description": "An order ID, such as `ORD-12345`.",
                                "pattern": "^ORD-[0-9]{5}$",
                                "type": "string"
                            },
                            "lines": {
                                "items": {
                                    "$ref": "#/definitions/OrderLine"
                                },
                                "minItems": 1,
                                "type": "array"
                            },
                            "payment": {
                                "$ref": "#/definitions/PaymentMethod"
                            },
                            "state": {
                                "allOf": [
                                    {
                                        "$ref": "#/definitions/OrderState"
                                    },
                                    {
                                        "default": "PLACED"
                                    }
                                ]
                            }
                        },
                        "required": [
                            "id",
                            "lines",
                            "payment",
                            "state"
                        ],
                        "type": "object"
                    },
                    "OrderLine": {
                        "properties": {
                            "quantity": {
                                "maximum": 99,
                                "minimum": 1,
                                "type": "number"
                            },
                            "sku": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "quantity",
                            "sku"
                        ],
                        "type": "object"
                    },
                    "OrderState": {
                        "description": "The state of an order.",
                        "enum": [
                            "PLACED",
                            "PAID",
                            "SHIPPED",
                            "CANCELLED"
                        ],
                        "type": "string"
                    },
                    "PaymentMethod": {
                        "description": "One way to pay for an order.",
                        "oneOf": [
                            {
                                "properties": {
                                    "card": {
                                        "$ref": "#/definitions/CardPayment"
                                    }
                                },
                                "required": [
                                    "card"
                                ],
                                "title": "card",
                                "type": "object"
                            },
                            {
                                "properties": {
                                    "invoice": {
                                        "$ref": "#/definitions/Unit"
                                    }
                                },
                                "required": [
                                    "invoice"
                                ],
                                "title": "invoice",
                                "type": "object"
                            }
                        ]
                    },
                    "Unit": {
                        "type": "object"
                    }
                }
            }
        },
