import {
  "moonbit-community/rabbita",
  "moonbit-community/rabbita/html",
  "moonrockz/smithy-site/tour/model",
  "moonrockz/smithy-site/playground/core",
  "moonrockz/smithy-site/playground/samples",
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
}

import {
  "moonbitlang/async",
} for "wbtest"

// `-unused_package` is for `moonbitlang/async` only: the view tests that use
// it run on native, so the js tests do not use it.

warnings = "-alert_experimental-unused_package"

supported_targets = "js+native"
